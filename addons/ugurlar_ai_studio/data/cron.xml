<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Stuck generation kontrolü: her 5 dakikada -->
        <record id="cron_check_stuck" model="ir.cron">
            <field name="name">AI Stüdyo: Takılmış İşlemleri Kontrol Et</field>
            <field name="model_id" ref="model_ai_studio_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_stuck_generations()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- AI iş kuyruğu slotları: her slot aynı anda tek iş yürütür (global eşzamanlılık =
             min(concurrent_limit, slot sayısı)). İstekler _trigger() ile anında uyandırır;
             aralık yalnız kaçan tetiklemeler için güvenlik ağıdır. Slot eklenirse
             ai_studio_session.AI_QUEUE_CRONS da güncellenmeli. -->
        <record id="cron_ai_queue_1" model="ir.cron">
            <field name="name">AI Stüdyo: İş Kuyruğu (slot 1)</field>
            <field name="model_id" ref="model_ai_studio_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue(slot=1)</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_ai_queue_2" model="ir.cron">
            <field name="name">AI Stüdyo: İş Kuyruğu (slot 2)</field>
            <field name="model_id" ref="model_ai_studio_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue(slot=2)</field>
            <field name="interval_number">2</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Çöp temizleme: günlük -->
        <record id="cron_garbage_collect" model="ir.cron">
            <field name="name">AI Stüdyo: Reddedilen Görselleri Temizle</field>
            <field name="model_id" ref="model_ai_studio_generation"/>
            <field name="state">code</field>
            <field name="code">model._cron_garbage_collect()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Ayın Fotoğrafçısı Hesaplama İşçisi (Her ayın 1'inde çalışır) -->
        <record id="cron_monthly_leaderboard" model="ir.cron">
            <field name="name">AI Stüdyo: Ayın Stüdyo Yıldızı Hesapla</field>
            <field name="model_id" ref="model_ai_studio_leaderboard"/>
            <field name="state">code</field>
            <field name="code">model._cron_calculate_leaderboard()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
