<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Rozetler (Badges) -->
        <record id="badge_ai_first_step" model="gamification.badge">
            <field name="name">İlk Adım</field>
            <field name="description">AI Stüdyo'da ilk 10 onaylı fotoğrafını çekenlere verilir.</field>
            <field name="level">bronze</field>
            <field name="rule_auth">nobody</field>
        </record>

        <record id="badge_ai_master" model="gamification.badge">
            <field name="name">Usta Fotoğrafçı</field>
            <field name="description">AI Stüdyo'da 100 onaylı fotoğrafı geçen profesyoneller!</field>
            <field name="level">gold</field>
            <field name="rule_auth">nobody</field>
        </record>

        <!-- Hedef (Goal Definition) -->
        <record id="goal_def_approved_sessions" model="gamification.goal.definition">
            <field name="name">Onaylanan Çekim Sayısı</field>
            <field name="description">Onaylanmış AI Stüdyo Oturumları</field>
            <field name="computation_mode">count</field>
            <field name="model_id" ref="ugurlar_ai_studio.model_ai_studio_session"/>
            <field name="batch_user_expression">user_id</field>
            <field name="domain">[('state', '=', 'approved')]</field>
            <field name="condition">higher</field>
        </record>

        <!-- Yarışma (Challenge) -->
        <record id="challenge_ai_monthly_star" model="gamification.challenge">
            <field name="name">Ayın Stüdyo Yıldızı</field>
            <field name="period">monthly</field>
            <field name="visibility_mode">personal</field>
            <field name="report_message_frequency">monthly</field>
            <field name="reward_id" ref="badge_ai_master"/>
        </record>
        
        <!-- Yarışmaya hedefi bağlama -->
        <record id="challenge_line_monthly_star" model="gamification.challenge.line">
            <field name="challenge_id" ref="challenge_ai_monthly_star"/>
            <field name="definition_id" ref="goal_def_approved_sessions"/>
            <field name="target_goal">100</field> <!-- Hedeflenen onay sayısı (örnek) -->
        </record>

    </data>
</odoo>
