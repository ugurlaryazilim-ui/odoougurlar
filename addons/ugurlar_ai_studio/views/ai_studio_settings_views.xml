<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ai_studio_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ugurlar_ai_studio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="AI Studio" string="AI Studio"
                     name="ugurlar_ai_studio"
                     data-key="ugurlar_ai_studio"
                     groups="base.group_system">

                    <block title="AI Sağlayıcı Seçimi" name="provider_settings">
                        <setting string="AI Sağlayıcı"
                                 help="Kullanılacak AI sağlayıcıyı seçin">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_default_provider" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_default_provider" class="col-4"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="fal.ai API Anahtarı"
                                 help="fal.ai kullanılacaksa API anahtarını girin"
                                 invisible="ai_studio_default_provider != 'fal'">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_fal_api_key" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_fal_api_key" class="col-4" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="FASHN API Anahtarı"
                                 help="FASHN doğrudan API kullanılacaksa anahtarı girin (fa-XXXX)"
                                 invisible="ai_studio_default_provider != 'fashn'">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_fashn_api_key" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_fashn_api_key" class="col-4" password="True"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Gemini API Anahtarı"
                                 help="Kıyafet analizi için kullanılacak Google Gemini API anahtarı. Boş bırakılırsa fal.ai (Proxy) kullanılır.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_gemini_api_key" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_gemini_api_key" class="col-4" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Try-On Model Ayarları" name="tryon_settings">
                        <setting string="Try-On Modeli"
                                 help="FASHN try-on modeli seçimi">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_tryon_model" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_tryon_model" class="col-4"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Varsayılan Kalite Modu">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_quality_mode" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_quality_mode" class="col-4"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Üretim Sayısı (num_samples)"
                                 help="Her istek için kaç görsel üretilsin (1-4)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_num_samples" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_num_samples" class="col-4"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Seedream Çıktı Boyutu"
                                 help="Seedream v5 Pro çıktı çözünürlüğü ve görsel başına maliyet">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_seedream_image_size" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_seedream_image_size" class="col-6"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Ön Görünüm Aday Sayısı"
                                 help="Ön görünüm için üretilecek alternatif sayısı (1-4); reviewer en iyisini seçer">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_candidate_count" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_candidate_count" class="col-2"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="AI Görsel Denetim"
                                 help="Üretimleri Gemini ile pantolon/el/etiket hatalarına karşı denetle">
                            <field name="ai_studio_visual_qc"/>
                        </setting>
                        <setting string="Otomatik Arka Plan Kaldırma"
                                 help="Fotoğrafları AI'ya göndermeden önce arka planı otomatik kaldır">
                            <field name="ai_studio_auto_bg_remove"/>
                        </setting>
                    </block>

                    <block title="Operasyonel Ayarlar" name="operational_settings">
                        <setting string="Aylık AI Bütçesi (USD)"
                                 help="Aylık toplam AI maliyeti bu tutara ulaşınca yeni işlem başlatılamaz (0 = limitsiz)">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_monthly_budget" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_monthly_budget" class="col-3"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Maksimum Revizyon Sayısı"
                                 help="Süpervizör onayı gerektirmeden yapılabilecek revize sayısı">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_max_revisions" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_max_revisions" class="col-4"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Eşzamanlı İstek Limiti"
                                 help="Aynı anda kaç oturum AI'da işlenebilir">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_concurrent_limit" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_concurrent_limit" class="col-4"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Bakım" name="maintenance_settings">
                        <setting string="Çöp Temizleme Süresi (gün)"
                                 help="Reddedilen görsellerin kaç gün sonra temizleneceği">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="ai_studio_garbage_days" class="col-3 col-lg-3 o_light_label"/>
                                    <field name="ai_studio_garbage_days" class="col-4"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                </app>
            </xpath>
        </field>
    </record>
</odoo>
