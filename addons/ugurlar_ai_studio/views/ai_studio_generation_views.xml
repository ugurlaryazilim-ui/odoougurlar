<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_ai_studio_generation_list" model="ir.ui.view">
        <field name="name">ai.studio.generation.list</field>
        <field name="model">ai.studio.generation</field>
        <field name="arch" type="xml">
            <list string="AI Üretimler"
                  decoration-success="is_approved"
                  decoration-danger="state == 'failed'">
                <field name="session_id"/>
                <field name="photo_type"/>
                <field name="state" widget="badge"/>
                <field name="is_approved"/>
                <field name="is_primary"/>
                <field name="revision_number"/>
                <field name="cost" widget="monetary"/>
                <field name="generation_time_seconds"/>
                <field name="provider"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_ai_studio_generation_form" model="ir.ui.view">
        <field name="name">ai.studio.generation.form</field>
        <field name="model">ai.studio.generation</field>
        <field name="arch" type="xml">
            <form string="AI Üretim Detayı">
                <header>
                    <button name="action_approve" string="✅ Onayla" type="object"
                            class="btn-success"
                            invisible="state != 'done' or is_approved"
                            groups="ugurlar_ai_studio.group_ai_studio_reviewer"/>
                    <button name="action_reject" string="❌ Reddet" type="object"
                            class="btn-danger"
                            invisible="state != 'done' or is_approved"
                            groups="ugurlar_ai_studio.group_ai_studio_reviewer"/>
                    <button name="action_mark_session_done" string="Tamamla ve Kaydet" type="object"
                            class="btn-primary"
                            invisible="not is_approved"
                            groups="ugurlar_ai_studio.group_ai_studio_reviewer"/>
                    <button name="action_set_primary" string="⭐ Ana Resim Yap" type="object"
                            invisible="not is_approved or is_primary"
                            groups="ugurlar_ai_studio.group_ai_studio_reviewer"/>
                    <button name="action_retry" string="🔄 Tekrar Dene" type="object"
                            invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Karşılaştırma">
                            <field name="original_image" widget="image" class="oe_avatar ais-zoomable-img"/>
                            <field name="generated_image" widget="image" class="oe_avatar ais-zoomable-img"/>
                        </group>
                        <group string="Bilgiler">
                            <field name="session_id"/>
                            <field name="photo_type"/>
                            <field name="revision_number"/>
                            <field name="is_approved"/>
                            <field name="is_primary"/>
                            <field name="provider"/>
                            <field name="fal_endpoint"/>
                            <field name="generation_time_seconds"/>
                            <field name="cost" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Red/Revizyon" invisible="not reject_reason_id and not revision_prompt">
                        <field name="reject_reason_id"/>
                        <field name="revision_prompt"/>
                        <field name="parent_generation_id"/>
                    </group>
                    <group string="Hata" invisible="not error_message">
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_generation_reject_form" model="ir.ui.view">
        <field name="name">ai.studio.generation.reject.form</field>
        <field name="model">ai.studio.generation</field>
        <field name="arch" type="xml">
            <form string="Reddet ve Revize Et">
                <group>
                    <field name="reject_reason_id" required="1"/>
                    <field name="revision_prompt" placeholder="Yapay zekaya bu versiyon için ek bir talimat vermek isterseniz yazın... (Örn: Ceketin düğmelerini kapat)"/>
                    <field name="revision_prompt_en" readonly="1" string="🔤 İngilizce Çeviri (AI'a bu gönderilir)"/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Reddet ve Yeni Üret" type="object" class="btn-danger"/>
                    <button string="İptal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Revizeler Özel Liste Görünümü -->
    <record id="view_ai_studio_revision_list" model="ir.ui.view">
        <field name="name">ai.studio.revision.list</field>
        <field name="model">ai.studio.generation</field>
        <field name="arch" type="xml">
            <list string="Revizeler"
                  decoration-warning="state in ('pending', 'processing')"
                  decoration-danger="state == 'failed'"
                  decoration-success="state == 'done' and is_approved"
                  decoration-muted="state == 'done' and not is_approved">
                <header>
                    <button name="action_recover_stuck_revisions_server"
                            string="🧹 Takılmış Revizeleri Düzelt"
                            type="object"
                            class="btn-secondary"
                            help="10 dakikadan uzun süredir yanıt vermeyen revizeleri tespit edip günceller."/>
                </header>
                <field name="session_id"/>
                <field name="product_name" string="Ürün"/>
                <field name="product_barcode" string="Barkod" optional="show"/>
                <field name="photo_type"/>
                <field name="revision_number" string="Versiyon" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-warning="state in ('pending', 'processing')"
                       decoration-danger="state == 'failed'"
                       decoration-success="state == 'done'"/>
                <field name="is_approved" widget="boolean_toggle" string="Onaylı" readonly="1"/>
                <field name="effective_reject_reason_id" string="Red Sebebi" optional="show"/>
                <field name="revision_prompt" string="Revizyon Talimatı" optional="show"/>
                <field name="error_message" string="Hata Mesajı" optional="show"/>
                <field name="create_date" string="Oluşturulma Tarihi"/>
                <field name="write_date" string="Son Güncelleme" optional="hide"/>
                <button name="action_retry" string="Tekrar Dene" type="object"
                        icon="fa-refresh"
                        invisible="state != 'failed'"
                        class="btn-warning btn-sm"/>
                <button name="action_cancel_revision_record" string="İptal Et" type="object"
                        icon="fa-times"
                        invisible="state not in ('pending', 'processing', 'failed')"
                        confirm="Bu revizyonu iptal edip önceki görsele dönmek istediğinize emin misiniz?"
                        class="btn-secondary btn-sm"/>
                <button name="action_open_session_review" string="İncele" type="object"
                        icon="fa-external-link"
                        class="btn-primary btn-sm"/>
            </list>
        </field>
    </record>

    <!-- Generation ve Revizeler Arama & Filtre Görünümü -->
    <record id="view_ai_studio_generation_search" model="ir.ui.view">
        <field name="name">ai.studio.generation.search</field>
        <field name="model">ai.studio.generation</field>
        <field name="arch" type="xml">
            <search>
                <field name="session_id"/>
                <field name="product_id"/>
                <field name="product_barcode"/>
                <field name="photo_type"/>
                <field name="revision_prompt"/>
                <separator/>
                <filter string="⏳ İşlemde / Bekleyen Revizeler" name="pending_or_processing"
                        domain="[('state', 'in', ['pending', 'processing'])]"/>
                <filter string="❌ Başarısız Revizeler" name="failed"
                        domain="[('state', '=', 'failed')]"/>
                <filter string="✅ Tamamlananlar" name="done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="🌟 Onaylananlar" name="approved"
                        domain="[('is_approved', '=', True)]"/>
                <separator/>
                <filter string="Sadece Revizyonlar (v2+)" name="revisions_only"
                        domain="['|', ('revision_number', '&gt;', 1), ('parent_generation_id', '!=', False)]"/>
                <separator/>
                <filter string="Oturum" name="group_by_session" context="{'group_by': 'session_id'}"/>
                <filter string="Durum" name="group_by_state" context="{'group_by': 'state'}"/>
                <filter string="Fotoğraf Tipi" name="group_by_photo_type" context="{'group_by': 'photo_type'}"/>
                <filter string="Red Sebebi" name="group_by_reject_reason" context="{'group_by': 'effective_reject_reason_id'}"/>
                <filter string="Tarih" name="group_by_create_date" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

</odoo>

