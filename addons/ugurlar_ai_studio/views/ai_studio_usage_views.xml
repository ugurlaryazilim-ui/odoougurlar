<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ======================================================= -->
    <!-- AI Kullanım Kayıtları (çağrı bazında)                    -->
    <!-- ======================================================= -->
    <record id="view_ai_studio_usage_list" model="ir.ui.view">
        <field name="name">ai.studio.usage.list</field>
        <field name="model">ai.studio.usage</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date" string="Tarih"/>
                <field name="session_id" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="provider"/>
                <field name="step"/>
                <field name="model" optional="hide"/>
                <field name="image_count" optional="show"/>
                <field name="input_tokens" sum="Toplam"/>
                <field name="output_tokens" sum="Toplam"/>
                <field name="duration" optional="hide"/>
                <field name="status" decoration-danger="status != 'ok'"/>
                <field name="cost" sum="Toplam"/>
            </list>
        </field>
    </record>

    <record id="view_ai_studio_usage_search" model="ir.ui.view">
        <field name="name">ai.studio.usage.search</field>
        <field name="model">ai.studio.usage</field>
        <field name="arch" type="xml">
            <search>
                <field name="session_id"/>
                <field name="product_id"/>
                <separator/>
                <filter string="Gemini" name="gemini" domain="[('provider', '=', 'gemini')]"/>
                <filter string="fal.ai" name="fal" domain="[('provider', '=', 'fal')]"/>
                <separator/>
                <filter string="Zaman Aşımı / Hata" name="not_ok" domain="[('status', '!=', 'ok')]"/>
                <separator/>
                <filter string="Tarih" name="filter_create_date" date="create_date"/>
                <separator/>
                <filter string="Oturum" name="group_by_session" context="{'group_by': 'session_id'}"/>
                <filter string="Ürün" name="group_by_product" context="{'group_by': 'product_id'}"/>
                <filter string="Sağlayıcı" name="group_by_provider" context="{'group_by': 'provider'}"/>
                <filter string="Adım" name="group_by_step" context="{'group_by': 'step'}"/>
                <filter string="Gün" name="group_by_day" context="{'group_by': 'create_date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_ai_studio_usage" model="ir.actions.act_window">
        <field name="name">AI Kullanım Kayıtları</field>
        <field name="res_model">ai.studio.usage</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_by_step': 1}</field>
    </record>

    <!-- ======================================================= -->
    <!-- Maliyet Analizi (ürün başına net maliyet)                -->
    <!-- ======================================================= -->
    <record id="view_ai_studio_cost_report_pivot" model="ir.ui.view">
        <field name="name">ai.studio.cost.report.pivot</field>
        <field name="model">ai.studio.cost.report</field>
        <field name="arch" type="xml">
            <pivot string="Maliyet Analizi">
                <field name="product_id" type="row"/>
                <field name="provider" type="col"/>
                <field name="cost" type="measure"/>
                <field name="calls" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ai_studio_cost_report_graph" model="ir.ui.view">
        <field name="name">ai.studio.cost.report.graph</field>
        <field name="model">ai.studio.cost.report</field>
        <field name="arch" type="xml">
            <graph string="Maliyet Analizi" type="bar" stacked="1">
                <field name="date" interval="day"/>
                <field name="provider"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_ai_studio_cost_report_list" model="ir.ui.view">
        <field name="name">ai.studio.cost.report.list</field>
        <field name="model">ai.studio.cost.report</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="product_id"/>
                <field name="session_id"/>
                <field name="provider"/>
                <field name="step"/>
                <field name="input_tokens" sum="Toplam"/>
                <field name="output_tokens" sum="Toplam"/>
                <field name="cost" sum="Toplam"/>
            </list>
        </field>
    </record>

    <record id="view_ai_studio_cost_report_search" model="ir.ui.view">
        <field name="name">ai.studio.cost.report.search</field>
        <field name="model">ai.studio.cost.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="session_id"/>
                <field name="user_id"/>
                <separator/>
                <filter string="Gemini" name="gemini" domain="[('provider', '=', 'gemini')]"/>
                <filter string="fal.ai" name="fal" domain="[('provider', '=', 'fal')]"/>
                <separator/>
                <filter string="Tarih" name="filter_date" date="date"/>
                <separator/>
                <filter string="Ürün" name="group_by_product" context="{'group_by': 'product_id'}"/>
                <filter string="Oturum" name="group_by_session" context="{'group_by': 'session_id'}"/>
                <filter string="Sağlayıcı" name="group_by_provider" context="{'group_by': 'provider'}"/>
                <filter string="Adım" name="group_by_step" context="{'group_by': 'step'}"/>
                <filter string="Kullanıcı" name="group_by_user" context="{'group_by': 'user_id'}"/>
                <filter string="Gün" name="group_by_day" context="{'group_by': 'date:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_ai_studio_cost_report" model="ir.actions.act_window">
        <field name="name">Maliyet Analizi</field>
        <field name="res_model">ai.studio.cost.report</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>
</odoo>
