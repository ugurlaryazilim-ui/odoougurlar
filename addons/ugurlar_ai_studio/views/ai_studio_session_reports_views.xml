<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Pivot View -->
        <record id="view_ai_studio_session_pivot" model="ir.ui.view">
            <field name="name">ai.studio.session.pivot</field>
            <field name="model">ai.studio.session</field>
            <field name="arch" type="xml">
                <pivot string="Oturum Analizi" sample="1">
                    <field name="user_id" type="row"/>
                    <field name="create_date" type="col" interval="month"/>
                    <field name="state" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- Graph View -->
        <record id="view_ai_studio_session_graph" model="ir.ui.view">
            <field name="name">ai.studio.session.graph</field>
            <field name="model">ai.studio.session</field>
            <field name="arch" type="xml">
                <graph string="Oturum Analizi" type="bar" sample="1">
                    <field name="user_id"/>
                    <field name="state"/>
                </graph>
            </field>
        </record>

        <!-- Pivot/Graph Window Action -->
        <record id="action_ai_studio_session_reports" model="ir.actions.act_window">
            <field name="name">Performans Analizi (Pivot)</field>
            <field name="res_model">ai.studio.session</field>
            <field name="view_mode">pivot,graph,list,form</field>
            <field name="context">{'search_default_group_by_state': 1}</field>
        </record>
    </data>
</odoo>
