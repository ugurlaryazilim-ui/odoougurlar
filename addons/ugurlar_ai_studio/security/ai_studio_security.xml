<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- AI Stüdyo Modül Kategorisi                                   -->
    <!-- ============================================================ -->
    <record id="module_category_ai_studio" model="ir.module.category">
        <field name="name">AI Stüdyo</field>
        <field name="sequence">60</field>
    </record>

    <!-- ============================================================ -->
    <!-- Privilege (Odoo 19 — category_id yerine privilege_id)        -->
    <!-- ============================================================ -->
    <record id="privilege_ai_studio" model="res.groups.privilege">
        <field name="name">AI Stüdyo Erişimi</field>
        <field name="category_id" ref="module_category_ai_studio"/>
    </record>

    <!-- ============================================================ -->
    <!-- Güvenlik Grupları                                             -->
    <!-- ============================================================ -->
    <record id="group_ai_studio_operator" model="res.groups">
        <field name="name">Operatör</field>
        <field name="privilege_id" ref="privilege_ai_studio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Fotoğraf çekme, AI'ya gönderme, kendi oturumlarını görme</field>
    </record>

    <record id="group_ai_studio_reviewer" model="res.groups">
        <field name="name">Onayıcı</field>
        <field name="privilege_id" ref="privilege_ai_studio"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_studio_operator')), (4, ref('base.group_allow_export'))]"/>
        <field name="comment">Tüm oturumları görme, onay/red yetkisi</field>
    </record>

    <record id="group_ai_studio_manager" model="res.groups">
        <field name="name">Yönetici</field>
        <field name="privilege_id" ref="privilege_ai_studio"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_studio_reviewer'))]"/>
        <field name="comment">Ayarlar, presetler, maliyet raporları, süpervizör onayı</field>
    </record>

    <!-- ============================================================ -->
    <!-- Kayıt Kuralları (Record Rules)                               -->
    <!-- ============================================================ -->
    <data noupdate="1">
        <!-- Operatör: sadece kendi oturumlarını görür (yazma: aşağıdaki kilit kuralı) -->
        <record id="rule_session_operator" model="ir.rule">
            <field name="name">AI Stüdyo Oturum: Operatör kendi oturumları</field>
            <field name="model_id" ref="model_ai_studio_session"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ai_studio_operator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Onayıcı: tüm oturumları görür -->
        <record id="rule_session_reviewer" model="ir.rule">
            <field name="name">AI Stüdyo Oturum: Onayıcı tüm oturumlar</field>
            <field name="model_id" ref="model_ai_studio_session"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_studio_reviewer'))]"/>
        </record>

        <!-- Fotoğraf: oturum sahibi veya onayıcı (yazma: aşağıdaki kilit kuralı) -->
        <record id="rule_photo_operator" model="ir.rule">
            <field name="name">AI Stüdyo Fotoğraf: Operatör</field>
            <field name="model_id" ref="model_ai_studio_photo"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ai_studio_operator'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_photo_reviewer" model="ir.rule">
            <field name="name">AI Stüdyo Fotoğraf: Onayıcı</field>
            <field name="model_id" ref="model_ai_studio_photo"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_studio_reviewer'))]"/>
        </record>

        <!-- Generation: oturum sahibi veya onayıcı -->
        <record id="rule_generation_operator" model="ir.rule">
            <field name="name">AI Stüdyo Üretim: Operatör</field>
            <field name="model_id" ref="model_ai_studio_generation"/>
            <field name="domain_force">[('session_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ai_studio_operator'))]"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_generation_reviewer" model="ir.rule">
            <field name="name">AI Stüdyo Üretim: Onayıcı</field>
            <field name="model_id" ref="model_ai_studio_generation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ai_studio_reviewer'))]"/>
        </record>
    </data>
    <!-- Aday görseller: ebeveyn üretimin kuralını izler (yazma: aşağıdaki kilit kuralı) -->
    <record id="rule_ai_studio_candidate_operator" model="ir.rule">
        <field name="name">AI Aday: Operatör kendi oturumları</field>
        <field name="model_id" ref="model_ai_studio_generation_candidate"/>
        <field name="domain_force">[('generation_id.session_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_ai_studio_operator'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ============================================================ -->
    <!-- Onay kilidi (A4 Y1/O1/Y2/O2): 'saving'/'done' oturum içeriği  -->
    <!-- ============================================================ -->
    <!-- NEDEN: 'saving' oturumu kuyruk sistem yetkisiyle ürüne yazar; onaydan sonra operatörün
         değiştirdiği her şey (oturum, üretim, takım satırı, aday, alan eki) onaysız ürüne gider.
         Model write/create override'ları her turda yeni bir yolla (context default, o2m, ek) atlatıldı;
         kayıt kuralı ORM'in tüm yollarında (create SONRASI oluşan kayıtta, write/unlink ÖNCESİ, ir.attachment
         res_model/res_id üzerinden) uygulanır.
         DIKKAT: grup kuralları OR'lanır. Operatörün başka bir kuralında perm_write/create/unlink açık kalırsa
         bu kilit etkisiz olur; operatör yazma yetkisi YALNIZ *_operator_edit kurallarından gelmeli.
         Açık oturumun 'saving'e GEÇİŞİ kurala takılmaz (kural yazım öncesi kaydı görür): o geçiş
         ai.studio.session._check_saving_transition'da; kilitli oturuma session_id ile TAŞIMA da modelde. -->
    <record id="rule_session_operator_edit" model="ir.rule">
        <field name="name">AI Stüdyo Oturum: Operatör kendi açık oturumunu düzenler</field>
        <field name="model_id" ref="model_ai_studio_session"/>
        <field name="domain_force">[('user_id', '=', user.id), ('state', 'not in', ('saving', 'done'))]</field>
        <field name="groups" eval="[(4, ref('group_ai_studio_operator'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_generation_operator_edit" model="ir.rule">
        <field name="name">AI Stüdyo Üretim: Operatör açık oturumda düzenler</field>
        <field name="model_id" ref="model_ai_studio_generation"/>
        <!-- NEDEN (J10 Y3/Y4): 'review'da üretim (onaylı ya da değil) operatöre kapalı. Onaycı ekranı açıkken
             onaysız üretimin görseli/eki değişirse approve yalnız id ile çalıştığından onaycının görmediği
             görsel ürüne giderdi (TOCTOU). Yeniden üretim/revizyon onaycı ve kuyruk yolundan gelir.
             is_approved=False: onaylı üretim taslağa dönen oturumda da kilitli; kural create SONRASI da
             denetlediği için default_is_approved / copy / o2m ile onaylı üretim oluşturulamaz. -->
        <field name="domain_force">[('session_id.user_id', '=', user.id), ('session_id.state', 'not in', ('review', 'saving', 'done')), ('is_approved', '=', False)]</field>
        <field name="groups" eval="[(4, ref('group_ai_studio_operator'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_photo_operator_edit" model="ir.rule">
        <field name="name">AI Stüdyo Fotoğraf: Operatör açık oturumda düzenler</field>
        <field name="model_id" ref="model_ai_studio_photo"/>
        <field name="domain_force">[('session_id.user_id', '=', user.id), ('session_id.state', 'not in', ('saving', 'done'))]</field>
        <field name="groups" eval="[(4, ref('group_ai_studio_operator'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_photo_admin_edit" model="ir.rule">
        <field name="name">AI Stüdyo Fotoğraf: Erişim yöneticisi düzenler</field>
        <field name="model_id" ref="model_ai_studio_photo"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_set_line_operator_edit" model="ir.rule">
        <field name="name">AI Takım Parçası: Operatör açık oturumda düzenler</field>
        <field name="model_id" ref="model_ai_studio_set_line"/>
        <!-- NEDEN (J10 O-J10-2): takım modunda kuyruk set satırlarının ürünlerine yazar; 'review'da onay ÖNCESİ
             değişen satır onaycının gördüğünden başka ürüne yazdırırdı (düşecek onay yok). Oturumun kendi hedef
             alanları da review'da kapalı (_check_saving_transition). -->
        <field name="domain_force">[('session_id.user_id', '=', user.id), ('session_id.state', 'not in', ('review', 'saving', 'done'))]</field>
        <field name="groups" eval="[(4, ref('group_ai_studio_operator'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_candidate_operator_edit" model="ir.rule">
        <field name="name">AI Aday: Operatör açık oturumda düzenler</field>
        <field name="model_id" ref="model_ai_studio_generation_candidate"/>
        <!-- J10 Y4: üretimle aynı kilit; ayrıca ACL'de operatör aday create=0 (D-J10-1), bu kural derinlik savunması -->
        <field name="domain_force">[('generation_id.session_id.user_id', '=', user.id), ('generation_id.session_id.state', 'not in', ('review', 'saving', 'done'))]</field>
        <field name="groups" eval="[(4, ref('group_ai_studio_operator'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <!-- Onaycı (reviewer kuralları zaten serbest) ve erişim yöneticisi (eski is_admin() eşdeğeri,
         ör. senkron ajanının admin kullanıcısı) kilide takılmaz. Takım satırında önceden kural yoktu. -->
    <record id="rule_set_line_reviewer_edit" model="ir.rule">
        <field name="name">AI Takım Parçası: Onaycı düzenler</field>
        <field name="model_id" ref="model_ai_studio_set_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_studio_reviewer'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_session_admin_edit" model="ir.rule">
        <field name="name">AI Stüdyo Oturum: Erişim yöneticisi düzenler</field>
        <field name="model_id" ref="model_ai_studio_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_generation_admin_edit" model="ir.rule">
        <field name="name">AI Stüdyo Üretim: Erişim yöneticisi düzenler</field>
        <field name="model_id" ref="model_ai_studio_generation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_set_line_admin_edit" model="ir.rule">
        <field name="name">AI Takım Parçası: Erişim yöneticisi düzenler</field>
        <field name="model_id" ref="model_ai_studio_set_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="rule_candidate_admin_edit" model="ir.rule">
        <field name="name">AI Aday: Erişim yöneticisi düzenler</field>
        <field name="model_id" ref="model_ai_studio_generation_candidate"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <!-- DIKKAT: rule_session_operator / rule_generation_operator / rule_photo_operator noupdate="1" blokta; mevcut veritabanında
         -u XML'deki perm_* değişikliğini uygulamaz ve açık kalan perm_write kilidi OR ile deler.
         Bu çağrı her kurulum/güncellemede onları salt okumaya çeker (idempotent). -->
    <function model="ir.rule" name="write">
        <value eval="[ref('rule_session_operator'), ref('rule_generation_operator'), ref('rule_photo_operator')]"/>
        <value eval="{'perm_write': False, 'perm_create': False, 'perm_unlink': False}"/>
    </function>
    <record id="rule_ai_studio_candidate_reviewer" model="ir.rule">
        <field name="name">AI Aday: Onaycı tümü</field>
        <field name="model_id" ref="model_ai_studio_generation_candidate"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_ai_studio_reviewer'))]"/>
    </record>
</odoo>
