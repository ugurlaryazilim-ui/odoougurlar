<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pazarama_order_form" model="ir.ui.view">
        <field name="name">pazarama.order.form</field>
        <field name="model">pazarama.order</field>
        <field name="arch" type="xml">
            <form string="Pazarama Siparişi" create="false" edit="false">
                <header>
                    <button name="action_refresh_from_pazarama" type="object" string="Pazarama'dan Güncelle" class="btn-primary"/>
                    <button name="action_retry_sync" type="object" string="Tekrar Dene" class="btn-secondary"
                            invisible="sale_order_id"/>
                    <button name="action_accept_order" type="object" string="Pazarama'da Onayla (Hazırlanıyor)"
                            class="btn-secondary" invisible="not sale_order_id or order_status != 3"
                            confirm="'Sipariş Alındı' kalemleri Pazarama'da 'Hazırlanıyor' statüsüne alınacak. Devam edilsin mi?"/>
                    <button name="action_send_invoice" type="object" string="Faturayı Pazarama'ya Gönder"
                            class="btn-secondary" invisible="not sale_order_id or invoice_sent"
                            confirm="Nebim fatura linki Pazarama'ya gönderilecek. Devam edilsin mi?"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="order_number"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="sale_order_id"/>
                            <field name="order_date"/>
                            <field name="order_status" invisible="1"/>
                            <field name="order_status_display" string="Pazarama Durumu"/>
                            <field name="total_price"/>
                        </group>
                        <group>
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="invoice_type"/>
                            <field name="tax_office" invisible="not tax_office"/>
                            <field name="cargo_provider"/>
                            <field name="cargo_tracking_number"/>
                        </group>
                        <group string="Fatura" invisible="not invoice_sent and not invoice_error">
                            <field name="invoice_sent"/>
                            <field name="invoice_sent_date" invisible="not invoice_sent"/>
                            <field name="invoice_url" widget="url" invisible="not invoice_url"/>
                            <field name="invoice_error" invisible="not invoice_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Satırlar">
                            <field name="line_ids">
                                <list>
                                    <field name="product_name"/>
                                    <field name="product_code"/>
                                    <field name="quantity"/>
                                    <field name="sale_price"/>
                                    <field name="vat_rate" optional="hide"/>
                                    <field name="cargo_tracking" optional="hide"/>
                                    <field name="status" column_invisible="1"/>
                                    <field name="status_display" string="Durum" widget="badge"
                                           decoration-success="status in (5, 16, 19, 11, 9)"
                                           decoration-warning="status in (3, 12)"
                                           decoration-danger="status in (6, 13, 14, 18, 7, 8, 10)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Raw JSON">
                            <field name="raw_data" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pazarama_order_tree" model="ir.ui.view">
        <field name="name">pazarama.order.tree</field>
        <field name="model">pazarama.order</field>
        <field name="arch" type="xml">
            <list string="Pazarama Siparişleri" create="false" edit="false"
                  decoration-muted="order_status in (6, 13, 14, 18)">
                <header>
                    <button name="action_refresh_from_pazarama" type="object" string="Pazarama'dan Güncelle" class="btn-primary"/>
                    <button name="action_retry_sync" type="object" string="Hatalıları Tekrar Dene" class="btn-secondary"/>
                    <button name="action_delete_error_orders" type="object" string="Hatalıları Sil" class="btn-danger"/>
                </header>
                <field name="order_number"/>
                <field name="order_date"/>
                <field name="customer_name"/>
                <field name="total_price"/>
                <field name="order_status" column_invisible="1"/>
                <field name="order_status_display" string="Pazarama Durumu" widget="badge"
                       decoration-success="order_status in (11, 9)"
                       decoration-info="order_status in (5, 16, 19)"
                       decoration-warning="order_status in (3, 12)"
                       decoration-danger="order_status in (6, 13, 14, 18, 7, 8, 10)"/>
                <field name="invoice_sent" optional="hide"/>
                <field name="error_message" optional="show"/>
                <field name="store_id"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="pazarama_order_search" model="ir.ui.view">
        <field name="name">pazarama.order.search</field>
        <field name="model">pazarama.order</field>
        <field name="arch" type="xml">
            <search string="Pazarama Siparişleri">
                <field name="order_number"/>
                <field name="customer_name"/>
                <field name="cargo_tracking_number"/>
                <field name="sale_order_id"/>
                <filter name="has_error" string="Hatalı / Uyarılı" domain="[('error_message', '!=', False)]"/>
                <filter name="no_sale_order" string="Odoo Siparişi Yok" domain="[('sale_order_id', '=', False)]"/>
                <filter name="partial" string="Kısmi İptal" domain="[('partially_cancelled', '=', True)]"/>
                <separator/>
                <filter name="to_accept" string="Onay Bekliyor (Sipariş Alındı)" domain="[('order_status', '=', 3)]"/>
                <filter name="preparing" string="Hazırlanıyor" domain="[('order_status', '=', 12)]"/>
                <filter name="cancelled" string="İptal" domain="[('order_status', 'in', (6, 13, 14, 18))]"/>
                <filter name="returned" string="İade" domain="[('order_status', 'in', (7, 8, 10))]"/>
                <separator/>
                <filter name="invoice_not_sent" string="Fatura Gönderilmedi"
                        domain="[('invoice_sent', '=', False), ('sale_order_id', '!=', False)]"/>
                <group>
                    <filter name="group_status" string="Durum" context="{'group_by': 'order_status'}"/>
                    <filter name="group_store" string="Mağaza" context="{'group_by': 'store_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pazarama_retry_sync" model="ir.actions.server">
        <field name="name">Tekrar Dene</field>
        <field name="model_id" ref="pazarama_integration.model_pazarama_order"/>
        <field name="binding_model_id" ref="pazarama_integration.model_pazarama_order"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_retry_sync()
        </field>
    </record>

    <record id="action_pazarama_refresh" model="ir.actions.server">
        <field name="name">Pazarama'dan Güncelle</field>
        <field name="model_id" ref="pazarama_integration.model_pazarama_order"/>
        <field name="binding_model_id" ref="pazarama_integration.model_pazarama_order"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_refresh_from_pazarama()
        </field>
    </record>

    <record id="action_pazarama_orders" model="ir.actions.act_window">
        <field name="name">Pazarama Siparişleri</field>
        <field name="res_model">pazarama.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="pazarama_order_search"/>
    </record>
</odoo>
