<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="idefix_order_form" model="ir.ui.view">
        <field name="name">idefix.order.form</field>
        <field name="model">idefix.order</field>
        <field name="arch" type="xml">
            <form string="Idefix Siparişi" create="false" edit="false">
                <header>
                    <button name="action_refresh_from_idefix" type="object" string="Idefix'ten Güncelle" class="btn-primary"/>
                    <button name="action_retry_sync" type="object" string="Tekrar Dene" class="btn-secondary"
                            invisible="sale_order_id"/>
                    <button name="action_send_picking" type="object" string="Idefix'te Hazırlanıyor Yap"
                            class="btn-secondary" invisible="not sale_order_id or order_status != 'shipment_ready'"
                            confirm="Sevkiyat Idefix'te 'Hazırlanıyor' statüsüne alınacak; müşteri artık iptal edemez. Devam edilsin mi?"/>
                    <button name="action_send_invoice" type="object" string="Faturayı Idefix'e Gönder"
                            class="btn-secondary" invisible="not sale_order_id or invoice_sent"
                            confirm="Sevkiyat 'Faturalandı' yapılacak ve Nebim fatura linki Idefix'e gönderilecek. Devam edilsin mi?"/>
                    <button name="action_open_unsupplied_wizard" type="object" string="Tedarik Edilemedi Bildir"
                            class="btn-secondary"
                            invisible="order_status not in ('created', 'shipment_ready', 'shipment_picking', 'shipment_invoiced')"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="not error_message">
                        <field name="error_message" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="order_number"/>
                        </h1>
                        <div class="text-muted">Shipment ID: <field name="order_id" class="oe_inline"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="store_id"/>
                            <field name="sale_order_id"/>
                            <field name="order_date"/>
                            <field name="order_status" invisible="1"/>
                            <field name="order_status_display" string="İdefix Durumu"/>
                            <field name="status_updated_at"/>
                            <field name="picking_sent"/>
                        </group>
                        <group>
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="invoice_type"/>
                            <field name="tax_office" invisible="not tax_office"/>
                            <field name="cargo_provider"/>
                            <field name="cargo_profile_name"/>
                            <field name="cargo_tracking_number"/>
                            <field name="cargo_tracking_url" widget="url" invisible="not cargo_tracking_url"/>
                        </group>
                        <group string="Tutarlar">
                            <field name="gross_price"/>
                            <field name="platform_discount"/>
                            <field name="vendor_discount"/>
                            <field name="total_price"/>
                            <field name="commission_amount"/>
                            <field name="earning_amount"/>
                        </group>
                        <group string="Fatura" invisible="not invoice_sent and not invoice_error">
                            <field name="invoice_sent"/>
                            <field name="invoice_number" invisible="not invoice_number"/>
                            <field name="invoice_sent_date" invisible="not invoice_sent"/>
                            <field name="invoice_url" widget="url" invisible="not invoice_url"/>
                            <field name="invoice_error" invisible="not invoice_error"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Satırlar">
                            <field name="line_ids">
                                <list>
                                    <field name="product_name"/>
                                    <field name="product_code"/>
                                    <field name="quantity"/>
                                    <field name="sale_price_tax_included"/>
                                    <field name="sale_price" optional="hide"/>
                                    <field name="vat_rate" optional="hide"/>
                                    <field name="platform_discount" optional="hide"/>
                                    <field name="vendor_discount" optional="hide"/>
                                    <field name="commission_amount" optional="show"/>
                                    <field name="earning_amount" optional="show"/>
                                    <field name="status_display" string="Durum"/>
                                </list>
                            </field>
                        </page>
                        <page string="Raw JSON">
                            <field name="raw_data" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="idefix_order_tree" model="ir.ui.view">
        <field name="name">idefix.order.tree</field>
        <field name="model">idefix.order</field>
        <field name="arch" type="xml">
            <list string="Idefix Siparişleri" create="false" edit="false"
                  decoration-muted="order_status in ('shipment_cancelled', 'shipment_unsupplied', 'shipment_split')">
                <header>
                    <button name="action_refresh_from_idefix" type="object" string="Idefix'ten Güncelle" class="btn-primary"/>
                    <button name="action_retry_sync" type="object" string="Hatalıları Tekrar Dene" class="btn-secondary"/>
                    <button name="action_delete_error_orders" type="object" string="Hatalıları Sil" class="btn-danger"/>
                </header>
                <field name="order_number"/>
                <field name="order_id" optional="hide"/>
                <field name="order_date"/>
                <field name="customer_name"/>
                <field name="total_price"/>
                <field name="order_status" column_invisible="1"/>
                <field name="order_status_display" string="İdefix Durumu" widget="badge"
                       decoration-success="order_status in ('shipment_delivered', 'shipment_approved')"
                       decoration-info="order_status in ('shipment_in_cargo', 'shipment_picking', 'shipment_invoiced')"
                       decoration-warning="order_status in ('created', 'shipment_ready')"
                       decoration-danger="order_status in ('shipment_cancelled', 'shipment_unsupplied', 'shipment_split', 'shipment_undeliver')"/>
                <field name="invoice_sent" optional="hide"/>
                <field name="error_message" optional="show"/>
                <field name="store_id"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="idefix_order_search" model="ir.ui.view">
        <field name="name">idefix.order.search</field>
        <field name="model">idefix.order</field>
        <field name="arch" type="xml">
            <search string="Idefix Siparişleri">
                <field name="order_number"/>
                <field name="order_id"/>
                <field name="customer_name"/>
                <field name="cargo_tracking_number"/>
                <field name="sale_order_id"/>
                <field name="line_ids" string="Ürün / Barkod" filter_domain="['|', ('line_ids.product_code', 'ilike', self), ('line_ids.product_name', 'ilike', self)]"/>
                <filter name="has_error" string="Hatalı / Uyarılı" domain="[('error_message', '!=', False)]"/>
                <filter name="no_sale_order" string="Odoo Siparişi Yok" domain="[('sale_order_id', '=', False)]"/>
                <separator/>
                <filter name="to_prepare" string="Hazırlanacak" domain="[('order_status', 'in', ('created', 'shipment_ready'))]"/>
                <filter name="picking" string="Hazırlanıyor / Faturalandı" domain="[('order_status', 'in', ('shipment_picking', 'shipment_invoiced'))]"/>
                <filter name="in_cargo" string="Kargoda" domain="[('order_status', '=', 'shipment_in_cargo')]"/>
                <filter name="delivered" string="Teslim Edildi" domain="[('order_status', 'in', ('shipment_delivered', 'shipment_approved'))]"/>
                <filter name="cancelled" string="İptal / Tedarik Edilemedi / Bölündü" domain="[('order_status', 'in', ('shipment_cancelled', 'shipment_unsupplied', 'shipment_split'))]"/>
                <separator/>
                <filter name="invoice_not_sent" string="Fatura Gönderilmedi"
                        domain="[('invoice_sent', '=', False), ('sale_order_id', '!=', False)]"/>
                <separator/>
                <filter name="order_date" string="Sipariş Tarihi" date="order_date"/>
                <group>
                    <filter name="group_status" string="Durum" context="{'group_by': 'order_status'}"/>
                    <filter name="group_store" string="Mağaza" context="{'group_by': 'store_id'}"/>
                    <filter name="group_order_number" string="Sipariş No" context="{'group_by': 'order_number'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_idefix_retry_sync" model="ir.actions.server">
        <field name="name">Tekrar Dene</field>
        <field name="model_id" ref="idefix_integration.model_idefix_order"/>
        <field name="binding_model_id" ref="idefix_integration.model_idefix_order"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_retry_sync()
        </field>
    </record>

    <record id="action_idefix_refresh" model="ir.actions.server">
        <field name="name">Idefix'ten Güncelle</field>
        <field name="model_id" ref="idefix_integration.model_idefix_order"/>
        <field name="binding_model_id" ref="idefix_integration.model_idefix_order"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_refresh_from_idefix()
        </field>
    </record>

    <record id="action_idefix_orders" model="ir.actions.act_window">
        <field name="name">Idefix Siparişleri</field>
        <field name="res_model">idefix.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="idefix_order_search"/>
    </record>
</odoo>
