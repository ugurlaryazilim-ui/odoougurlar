<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_ai_content_queue" model="ir.cron">
            <field name="name">AI: Kuyruktan İçerik Üret</field>
            <field name="model_id" ref="model_ai_content_queue"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue(batch_size=10)</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
            <field name="priority">100</field>
        </record>

        <!-- K6: eski AI içerik loglarını sil (ayar: ai_title_description.log_retention_days, varsayılan 180; 0 = kapalı) -->
        <record id="ir_cron_ai_content_log_gc" model="ir.cron">
            <field name="name">AI: Eski İçerik Loglarını Temizle</field>
            <field name="model_id" ref="model_ai_content_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
