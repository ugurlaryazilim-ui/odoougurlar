<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Module Category -->
        <record id="module_category_ai_content" model="ir.module.category">
            <field name="name">AI İçerik Yönetimi</field>
            <field name="parent_id" ref="base.module_category_inventory"/>
        </record>

        <!-- Privilege (Odoo 19 — replaces category_id on res.groups) -->
        <record id="privilege_ai_content" model="res.groups.privilege">
            <field name="name">AI İçerik Erişimi</field>
            <field name="category_id" ref="module_category_ai_content"/>
        </record>

        <!-- Groups -->
        <record id="group_ai_content_user" model="res.groups">
            <field name="name">Kullanıcı</field>
            <field name="privilege_id" ref="privilege_ai_content"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ai_content_manager" model="res.groups">
            <field name="name">Yönetici</field>
            <field name="privilege_id" ref="privilege_ai_content"/>
            <field name="implied_ids" eval="[(4, ref('group_ai_content_user'))]"/>
        </record>
    </data>
</odoo>
