<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_only_form_view_inherit_ai" model="ir.ui.view">
            <field name="name">product.template.form.inherit.ai</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <!-- Stat Button -->
                <div name="button_box" position="inside">
                    <button name="%(ai_title_description.action_ai_content_log)d" 
                            type="action" 
                            class="oe_stat_button" 
                            icon="fa-magic" 
                            invisible="not ai_content_generated">
                        <field name="ai_generation_count" widget="statinfo" string="AI Üretimleri"/>
                    </button>
                </div>
                
                <!-- AI Generate Button after name -->
                <xpath expr="//field[@name='name']" position="after">
                    <button name="action_open_ai_title_wizard"
                            string="🤖 AI ile Üret"
                            type="object"
                            class="btn-link btn-sm text-primary"
                            title="Yapay zeka ile başlık ve açıklama üret"/>
                </xpath>
                
                <!-- Notebook Page -->
                <xpath expr="//notebook" position="inside">
                    <page name="ai_content" string="AI İçerik" invisible="not ai_content_generated">
                        <group>
                            <group string="AI Başlıklar">
                                <field name="ai_trendyol_title"/>
                                <field name="ai_ecommerce_title"/>
                            </group>
                            <group string="AI Açıklamalar">
                                <field name="ai_short_description"/>
                                <field name="ai_html_description"/>
                            </group>
                        </group>
                        <group>
                            <group string="SEO">
                                <field name="ai_meta_title"/>
                                <field name="ai_meta_description"/>
                                <field name="ai_seo_keywords"/>
                            </group>
                            <group string="Durum">
                                <field name="ai_content_generated" readonly="1"/>
                                <field name="ai_last_generated" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
