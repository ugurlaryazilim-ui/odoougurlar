<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ai_content_queue_search" model="ir.ui.view">
            <field name="name">ai.content.queue.search</field>
            <field name="model">ai.content.queue</field>
            <field name="arch" type="xml">
                <search string="Kuyruk Arama ve Filtreleme">
                    <field name="product_tmpl_id"/>
                    <field name="mode"/>
                    <field name="state"/>

                    <!-- Durum Hızlı Filtreleri -->
                    <filter string="Bekliyor" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                    <filter string="İşleniyor" name="filter_processing" domain="[('state', '=', 'processing')]"/>
                    <filter string="Tamamlandı" name="filter_done" domain="[('state', '=', 'done')]"/>
                    <filter string="Hata Alındı" name="filter_error" domain="[('state', '=', 'error')]"/>

                    <separator/>
                    <!-- Mod Hızlı Filtreleri -->
                    <filter string="Başlık + Açıklama" name="filter_mode_both" domain="[('mode', '=', 'both')]"/>
                    <filter string="Sadece Başlık" name="filter_mode_title" domain="[('mode', '=', 'title')]"/>
                    <filter string="Sadece Açıklama" name="filter_mode_description" domain="[('mode', '=', 'description')]"/>

                    <separator/>
                    <filter string="Bugün" name="filter_today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>

                    <!-- Gruplama -->
                    <group>
                        <filter string="Durum" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Mod" name="group_by_mode" context="{'group_by': 'mode'}"/>
                        <filter string="Oluşturulma Tarihi" name="group_by_create_date" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_ai_content_queue_list" model="ir.ui.view">
            <field name="name">ai.content.queue.list</field>
            <field name="model">ai.content.queue</field>
            <field name="arch" type="xml">
                <list string="AI Üretim Kuyruğu" decoration-danger="state == 'error'" decoration-success="state == 'done'" decoration-info="state == 'pending'" decoration-warning="state == 'processing'">
                    <field name="product_tmpl_id"/>
                    <field name="mode"/>
                    <field name="state"/>
                    <field name="priority"/>
                    <field name="attempts"/>
                    <field name="create_date"/>
                    <button name="action_process_now" string="Şimdi İşle" type="object" icon="fa-bolt" class="btn-link" invisible="state == 'done'"/>
                    <button name="action_reset_to_pending" string="Sıfırla" type="object" icon="fa-refresh" class="btn-link" invisible="state == 'pending'"/>
                </list>
            </field>
        </record>

        <record id="view_ai_content_queue_form" model="ir.ui.view">
            <field name="name">ai.content.queue.form</field>
            <field name="model">ai.content.queue</field>
            <field name="arch" type="xml">
                <form string="AI Kuyruk Kaydı">
                    <header>
                        <button name="action_process_now" string="Şimdi İşle" type="object" class="btn-primary" invisible="state == 'done'"/>
                        <button name="action_reset_to_pending" string="Sıfırla / Yeniden Dene" type="object" class="btn-secondary" invisible="state == 'pending'"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,processing,done,error"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="product_tmpl_id"/>
                                <field name="mode"/>
                            </group>
                            <group>
                                <field name="priority"/>
                                <field name="attempts"/>
                                <field name="max_attempts"/>
                                <field name="create_date"/>
                            </group>
                        </group>
                        <group string="Hata Detayı" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_ai_content_queue" model="ir.actions.act_window">
            <field name="name">AI Üretim Kuyruğu</field>
            <field name="res_model">ai.content.queue</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_ai_content_queue_search"/>
            <field name="context">{}</field>
        </record>

        <menuitem id="menu_ai_content_queue" name="Kuyruk" parent="menu_ai_content_root" action="action_ai_content_queue"/>
    </data>
</odoo>
