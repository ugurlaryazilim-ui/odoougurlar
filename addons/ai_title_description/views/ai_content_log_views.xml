<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ai_content_log_search" model="ir.ui.view">
            <field name="name">ai.content.log.search</field>
            <field name="model">ai.content.log</field>
            <field name="arch" type="xml">
                <search string="İçerik Geçmişi Arama ve Filtreleme">
                    <field name="product_tmpl_id"/>
                    <field name="generated_title"/>
                    <field name="provider"/>
                    <field name="model_name"/>

                    <!-- Hızlı Filtreler -->
                    <filter string="Uygulandı" name="filter_applied" domain="[('applied', '=', True)]"/>
                    <filter string="Uygulanmadı" name="filter_not_applied" domain="[('applied', '=', False)]"/>

                    <separator/>
                    <filter string="Yüksek Skor (%90+)" name="filter_high_score" domain="[('title_score', '&gt;=', 90)]"/>
                    <filter string="Görsel Analiz Kullanıldı" name="filter_used_vision" domain="[('used_vision', '=', True)]"/>

                    <separator/>
                    <filter string="Google Gemini" name="filter_gemini" domain="[('provider', '=', 'gemini')]"/>
                    <filter string="OpenAI" name="filter_openai" domain="[('provider', '=', 'openai')]"/>

                    <separator/>
                    <filter string="Bugün" name="filter_today" domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>

                    <!-- Gruplama -->
                    <group>
                        <filter string="AI Sağlayıcı" name="group_by_provider" context="{'group_by': 'provider'}"/>
                        <filter string="Model" name="group_by_model" context="{'group_by': 'model_name'}"/>
                        <filter string="Üretim Modu" name="group_by_mode" context="{'group_by': 'mode'}"/>
                        <filter string="Uygulandı" name="group_by_applied" context="{'group_by': 'applied'}"/>
                        <filter string="Oluşturulma Tarihi" name="group_by_date" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_ai_content_log_list" model="ir.ui.view">
            <field name="name">ai.content.log.list</field>
            <field name="model">ai.content.log</field>
            <field name="arch" type="xml">
                <list string="AI İçerik Geçmişi" create="false" edit="false">
                    <field name="create_date"/>
                    <field name="product_tmpl_id"/>
                    <field name="provider"/>
                    <field name="model_name"/>
                    <field name="mode"/>
                    <field name="generated_title"/>
                    <field name="title_score" widget="progressbar"/>
                    <field name="applied"/>
                    <field name="token_count"/>
                    <field name="cost_estimate" widget="monetary" options="{'currency_field': 'usd_currency'}"/>
                </list>
            </field>
        </record>

        <record id="view_ai_content_log_form" model="ir.ui.view">
            <field name="name">ai.content.log.form</field>
            <field name="model">ai.content.log</field>
            <field name="arch" type="xml">
                <form string="AI İçerik Günlüğü" create="false" edit="false">
                    <sheet>
                        <group string="Genel Bilgiler">
                            <group>
                                <field name="product_tmpl_id"/>
                                <field name="mode"/>
                                <field name="applied"/>
                                <field name="create_date"/>
                            </group>
                            <group>
                                <field name="provider"/>
                                <field name="model_name"/>
                                <field name="used_vision"/>
                                <field name="title_score"/>
                            </group>
                        </group>
                        <group string="Token &amp; Maliyet">
                            <group>
                                <field name="prompt_tokens"/>
                                <field name="completion_tokens"/>
                            </group>
                            <group>
                                <field name="token_count"/>
                                <field name="cost_estimate"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Üretilen Başlık &amp; Açıklama">
                                <group>
                                    <field name="generated_title"/>
                                    <field name="seo_keywords_used"/>
                                </group>
                                <field name="generated_description"/>
                            </page>
                            <page string="Prompt &amp; Ham Yanıt">
                                <group>
                                    <field name="prompt_used"/>
                                    <field name="raw_response"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_ai_content_log" model="ir.actions.act_window">
            <field name="name">AI İçerik Geçmişi</field>
            <field name="res_model">ai.content.log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_ai_content_log_search"/>
        </record>

        <menuitem id="menu_ai_content_root" name="AI İçerik"/>
        <menuitem id="menu_ai_content_log" name="İçerik Geçmişi" parent="menu_ai_content_root" action="action_ai_content_log"/>
    </data>
</odoo>
