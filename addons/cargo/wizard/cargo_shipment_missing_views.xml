<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cargo_shipment_missing_wizard_view_form" model="ir.ui.view">
        <field name="name">cargo.shipment.missing.wizard.form</field>
        <field name="model">cargo.shipment.missing.wizard</field>
        <field name="arch" type="xml">
            <form string="Kargo firmasında yok">
                <div class="alert alert-warning" role="alert">
                    Önce kargo firmasının panelinden kontrol edin. Gönderi orada varsa bu işlem mükerrer
                    (ücretli) gönderiye yol açar: kapatılan gönderinin yerine transferden yeni gönderi açılabilir.
                </div>
                <group>
                    <field name="shipment_id"/>
                    <field name="carrier_id"/>
                    <field name="reason" placeholder="Ör. 24.10 16:00 panelde referansla arandı, kayıt yok."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Kargo firmasında yok olarak işaretle"
                            class="btn-primary"/>
                    <button string="Vazgeç" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
