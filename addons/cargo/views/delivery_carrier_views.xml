<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Kargo çekirdeğinin yönettiği firmalarda kapıda ödeme bayrakları (yalnız Kargo / Yönetici).
         Sağlayıcı hesap alanları sağlayıcı eklentisinin kendi görünümündedir. -->
    <record id="view_delivery_carrier_form_cargo" model="ir.ui.view">
        <field name="name">delivery.carrier.form.cargo</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='prod_environment']" position="after">
                <field name="cargo_managed" invisible="1"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="cargo" string="Kargo" invisible="not cargo_managed"
                      groups="cargo.group_cargo_manager">
                    <group name="cargo_cod" string="Kapıda ödeme (ODP)">
                        <field name="cargo_cod_enabled"/>
                        <field name="cargo_cod_allow_cash" invisible="not cargo_cod_enabled"/>
                        <field name="cargo_cod_allow_card" invisible="not cargo_cod_enabled"/>
                        <field name="cargo_cod_allow_check" invisible="not cargo_cod_enabled"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
