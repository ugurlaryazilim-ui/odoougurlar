<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- İl/ilçe kodları: veri sağlayıcı eklentisinden gelir. Yönetici yalnız "Diğer adlar" alanını düzenler
         (adresteki eski/farklı yazım eşlemesi); kod ve ad alanları salt okunurdur. -->
    <record id="view_cargo_area_list" model="ir.ui.view">
        <field name="name">cargo.area.list</field>
        <field name="model">cargo.area</field>
        <field name="arch" type="xml">
            <list string="İl/İlçe kodları" create="0" delete="0" editable="bottom">
                <field name="provider" readonly="1"/>
                <field name="state_id" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="alias_names"/>
                <field name="city_code" readonly="1"/>
                <field name="area_code" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_cargo_area_form" model="ir.ui.view">
        <field name="name">cargo.area.form</field>
        <field name="model">cargo.area</field>
        <field name="arch" type="xml">
            <form string="İl/İlçe kodu" create="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="provider" readonly="1"/>
                            <field name="state_id" readonly="1"/>
                            <field name="name" readonly="1"/>
                        </group>
                        <group>
                            <field name="city_code" readonly="1"/>
                            <field name="area_code" readonly="1"/>
                            <field name="alias_names" placeholder="Eyüpsultan, Eyüp Sultan"/>
                        </group>
                    </group>
                    <group string="Eşleme anahtarları (otomatik)">
                        <field name="name_key" readonly="1"/>
                        <field name="match_keys" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cargo_area_search" model="ir.ui.view">
        <field name="name">cargo.area.search</field>
        <field name="model">cargo.area</field>
        <field name="arch" type="xml">
            <search string="İl/İlçe kodları">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('name_key', 'ilike', self), ('alias_names', 'ilike', self)]"/>
                <field name="provider"/>
                <field name="state_id"/>
                <field name="area_code"/>
                <filter name="with_alias" string="Diğer adı olanlar" domain="[('alias_names', '!=', False)]"/>
                <group>
                    <filter name="group_provider" string="Sağlayıcı" context="{'group_by': 'provider'}"/>
                    <filter name="group_state" string="İl" context="{'group_by': 'state_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cargo_area" model="ir.actions.act_window">
        <field name="name">İl/İlçe Kodları</field>
        <field name="res_model">cargo.area</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
