<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- noupdate: yıl sıfırlama/numara ayarı modül güncellemesinde ezilmesin. -->
    <data noupdate="1">
        <record id="seq_cargo_shipment" model="ir.sequence">
            <field name="name">Kargo gönderisi</field>
            <field name="code">cargo.shipment</field>
            <field name="prefix">KRG/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
