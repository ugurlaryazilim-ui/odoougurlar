<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Varsayılan: Gizli müşteri adı gösterilsin -->
        <record id="config_show_hidden_customer_name" model="ir.config_parameter">
            <field name="key">pazaryeri_question.show_hidden_customer_name</field>
            <field name="value">True</field>
        </record>
        <record id="config_auto_sync_enabled" model="ir.config_parameter">
            <field name="key">pazaryeri_question.auto_sync_enabled</field>
            <field name="value">True</field>
        </record>
        <record id="config_sync_interval" model="ir.config_parameter">
            <field name="key">pazaryeri_question.sync_interval</field>
            <field name="value">30</field>
        </record>
        <record id="config_answer_min_chars" model="ir.config_parameter">
            <field name="key">pazaryeri_question.answer_min_chars</field>
            <field name="value">10</field>
        </record>
        <record id="config_answer_max_chars" model="ir.config_parameter">
            <field name="key">pazaryeri_question.answer_max_chars</field>
            <field name="value">2000</field>
        </record>
    </data>
</odoo>
