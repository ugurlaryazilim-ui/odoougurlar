<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_trendyol_store_form_inherit_questions" model="ir.ui.view">
        <field name="name">trendyol.store.form.inherit.questions</field>
        <field name="model">trendyol.store</field>
        <field name="inherit_id" ref="trendyol_integration.trendyol_store_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_questions" 
                        type="object" class="oe_stat_button" icon="fa-comments">
                    <field name="question_count" widget="statinfo" string="Sorular"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Soru Senkronizasyonu" name="question_sync">
                    <group>
                        <group>
                            <field name="question_sync_enabled"/>
                            <field name="question_sync_interval"/>
                        </group>
                        <group>
                            <field name="last_question_sync" readonly="1"/>
                        </group>
                    </group>
                    <button name="action_sync_questions" string="Soruları Senkronize Et" type="object" class="btn-primary"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
