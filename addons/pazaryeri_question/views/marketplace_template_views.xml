<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_marketplace_template_list" model="ir.ui.view">
        <field name="name">marketplace.question.template.list</field>
        <field name="model">marketplace.question.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="template_text"/>
                <field name="category" widget="badge"/>
                <field name="marketplace_type"/>
                <field name="use_count"/>
            </list>
        </field>
    </record>

    <record id="view_marketplace_template_form" model="ir.ui.view">
        <field name="name">marketplace.question.template.form</field>
        <field name="model">marketplace.question.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="marketplace_type"/>
                        </group>
                        <group>
                            <field name="use_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="template_text" placeholder="Şablon metnini buraya giriniz..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_marketplace_template_search" model="ir.ui.view">
        <field name="name">marketplace.question.template.search</field>
        <field name="model">marketplace.question.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="template_text"/>
                <filter name="group_by_category" string="Kategori" context="{'group_by': 'category'}"/>
                <filter name="group_by_marketplace" string="Pazaryeri" context="{'group_by': 'marketplace_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_marketplace_templates" model="ir.actions.act_window">
        <field name="name">Cevap Şablonları</field>
        <field name="res_model">marketplace.question.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_marketplace_template_search"/>
    </record>
</odoo>
