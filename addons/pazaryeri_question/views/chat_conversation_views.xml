<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══ KONUŞMA LİSTESİ ═══ -->
    <record id="view_chat_conversation_list" model="ir.ui.view">
        <field name="name">marketplace.chat.conversation.list</field>
        <field name="model">marketplace.chat.conversation</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'open' and unread_count > 0"
                  decoration-info="state == 'open'"
                  decoration-success="state == 'assigned'"
                  decoration-muted="state == 'closed'">
                <field name="unread_count" column_invisible="1"/>
                <field name="customer_name" string="Müşteri"/>
                <field name="customer_email"/>
                <field name="marketplace_type" widget="badge"/>
                <field name="shop_domain"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-success="state == 'assigned'"
                       decoration-muted="state == 'closed'"/>
                <field name="operator_id" widget="many2one_avatar_user"/>
                <field name="message_count"/>
                <field name="last_message_preview"/>
                <field name="last_message_date" widget="timeago"/>
                <field name="rating"/>
            </list>
        </field>
    </record>

    <!-- ═══ KONUŞMA FORM ═══ -->
    <record id="view_chat_conversation_form" model="ir.ui.view">
        <field name="name">marketplace.chat.conversation.form</field>
        <field name="model">marketplace.chat.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign_to_me" string="Bana Ata" type="object"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_send_reply" string="💬 Cevap Gönder" type="object"
                            class="btn-primary" invisible="state == 'closed'"/>
                    <button name="action_close" string="Kapat" type="object"
                            class="btn-secondary" invisible="state == 'closed'"/>
                    <button name="action_reopen" string="Yeniden Aç" type="object"
                            class="btn-secondary" invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_partner" type="object"
                                class="oe_stat_button" icon="fa-user"
                                invisible="not partner_id">
                            <field name="partner_id" widget="statinfo" string="Müşteri Kartı"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Yeni Mesaj!" bg_color="bg-danger"
                            invisible="unread_count == 0"/>
                    <widget name="web_ribbon" title="Kapalı" bg_color="bg-secondary"
                            invisible="state != 'closed'"/>
                    
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    
                    <group>
                        <group string="Müşteri Bilgileri">
                            <field name="customer_name"/>
                            <field name="customer_email" widget="email"/>
                            <field name="customer_phone" widget="phone"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group string="Konuşma Bilgileri">
                            <field name="marketplace_type" readonly="1"/>
                            <field name="shop_domain" readonly="1"/>
                            <field name="operator_id" widget="many2one_avatar_user"/>
                            <field name="started_date" readonly="1"/>
                            <field name="closed_date" readonly="1" invisible="state != 'closed'"/>
                            <field name="first_response_date" readonly="1"/>
                            <field name="rating" readonly="1"/>
                        </group>
                    </group>
                    
                    <group string="Sayfa / Ürün Bilgisi" invisible="not page_url and not product_name">
                        <field name="page_url" widget="url"/>
                        <field name="page_title"/>
                        <field name="product_name"/>
                    </group>
                    
                    <notebook>
                        <page name="messages" string="💬 Mesajlar">
                            <field name="message_ids" readonly="1">
                                <list create="0" delete="0" 
                                      decoration-info="sender_type == 'customer'"
                                      decoration-success="sender_type == 'operator'"
                                      decoration-warning="sender_type == 'bot'"
                                      decoration-muted="sender_type == 'system'">
                                    <field name="sent_date" widget="datetime"/>
                                    <field name="sender_type" widget="badge"
                                           decoration-info="sender_type == 'customer'"
                                           decoration-success="sender_type == 'operator'"
                                           decoration-warning="sender_type == 'bot'"/>
                                    <field name="sender_name"/>
                                    <field name="message_text"/>
                                    <field name="is_read" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page name="technical" string="Teknik">
                            <group>
                                <field name="conversation_uid" readonly="1"/>
                                <field name="message_count" readonly="1"/>
                                <field name="unread_count" readonly="1"/>
                                <field name="question_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══ SEARCH VIEW ═══ -->
    <record id="view_chat_conversation_search" model="ir.ui.view">
        <field name="name">marketplace.chat.conversation.search</field>
        <field name="model">marketplace.chat.conversation</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="last_message_preview"/>
                <filter name="open" string="Açık" domain="[('state','=','open')]"/>
                <filter name="assigned" string="Atanmış" domain="[('state','=','assigned')]"/>
                <filter name="closed" string="Kapalı" domain="[('state','=','closed')]"/>
                <separator/>
                <filter name="unread" string="Okunmamış" domain="[('unread_count','>',0)]"/>
                <filter name="today" string="Bugün" domain="[('started_date','>=',context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="my" string="Benim Konuşmalarım" domain="[('operator_id','=',uid)]"/>
                <group>
                    <filter name="group_by_state" string="Durum" context="{'group_by':'state'}"/>
                    <filter name="group_by_operator" string="Operatör" context="{'group_by':'operator_id'}"/>
                    <filter name="group_by_shop" string="Mağaza" context="{'group_by':'shop_domain'}"/>
                    <filter name="group_by_rating" string="Değerlendirme" context="{'group_by':'rating'}"/>
                    <filter name="group_by_date" string="Tarih" context="{'group_by':'started_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══ KANBAN VIEW ═══ -->
    <record id="view_chat_conversation_kanban" model="ir.ui.view">
        <field name="name">marketplace.chat.conversation.kanban</field>
        <field name="model">marketplace.chat.conversation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="state"/>
                <field name="operator_id"/>
                <field name="unread_count"/>
                <field name="last_message_preview"/>
                <field name="last_message_date"/>
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <t t-if="record.unread_count.raw_value > 0">
                                            <span class="badge rounded-pill text-bg-danger me-1">
                                                <t t-out="record.unread_count.value"/>
                                            </span>
                                        </t>
                                        <field name="customer_name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="text-muted small" t-if="record.customer_email.value">
                                    <i class="fa fa-envelope"/> <field name="customer_email"/>
                                </div>
                                <div class="text-truncate mt-1">
                                    <field name="last_message_preview"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left text-muted small">
                                    <field name="last_message_date" widget="timeago"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="operator_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══ REPLY WIZARD ═══ -->
    <record id="view_chat_reply_wizard_form" model="ir.ui.view">
        <field name="name">marketplace.chat.reply.wizard.form</field>
        <field name="model">marketplace.chat.reply.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="conversation_id" readonly="1"/>
                    <field name="template_id"/>
                    <field name="reply_text" placeholder="Cevabınızı buraya yazın..."/>
                </group>
                <footer>
                    <button name="action_send" string="💬 Gönder" type="object" class="btn-primary"/>
                    <button string="İptal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══ ACTIONS ═══ -->
    <record id="action_chat_conversations" model="ir.actions.act_window">
        <field name="name">Canlı Sohbetler</field>
        <field name="res_model">marketplace.chat.conversation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_chat_conversation_search"/>
        <field name="context">{'search_default_open': 1, 'search_default_assigned': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Henüz canlı sohbet konuşması bulunmamaktadır.
            </p>
            <p>
                Shopify mağazanızdaki chat widget'ı üzerinden müşteriler mesaj gönderebilir.
            </p>
        </field>
    </record>

    <record id="action_chat_conversations_open" model="ir.actions.act_window">
        <field name="name">Açık Sohbetler</field>
        <field name="res_model">marketplace.chat.conversation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('state', 'in', ['open', 'assigned'])]</field>
        <field name="search_view_id" ref="view_chat_conversation_search"/>
    </record>
</odoo>
