<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Line List View -->
        <record id="view_ugurlar_invoice_collector_line_list" model="ir.ui.view">
            <field name="name">ugurlar.invoice.collector.line.list</field>
            <field name="model">ugurlar.invoice.collector.line</field>
            <field name="arch" type="xml">
                <list editable="bottom" create="false" delete="true">
                    <field name="selected" widget="boolean_toggle" string="Seç"/>
                    <field name="item_code" readonly="1"/>
                    <field name="document_number" readonly="1"/>
                    <field name="document_date" readonly="1"/>
                    <field name="vendor_name" readonly="1"/>
                    <field name="ref_number" readonly="1"/>
                    <field name="download_status" widget="badge" 
                           decoration-success="download_status == 'success'" 
                           decoration-danger="download_status == 'error'"
                           decoration-warning="download_status == 'pending'"/>
                    <field name="error_message" readonly="1" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Main Jobs List View (History & Active Downloads) -->
        <record id="view_ugurlar_invoice_collector_tree" model="ir.ui.view">
            <field name="name">ugurlar.invoice.collector.list</field>
            <field name="model">ugurlar.invoice.collector</field>
            <field name="arch" type="xml">
                <list string="Toptan Alış Fatura Arşivlerim" default_order="create_date desc">
                    <field name="create_date" string="Oluşturulma Tarihi"/>
                    <field name="brand_ids" widget="many2many_tags"/>
                    <field name="product_group_ids" widget="many2many_tags"/>
                    <field name="total_found_invoices"/>
                    <field name="processed_count"/>
                    <field name="progress_text"/>
                    <field name="state" widget="badge" 
                           decoration-success="state == 'completed'" 
                           decoration-info="state == 'downloading'"
                           decoration-warning="state == 'scanned'"
                           decoration-danger="state == 'error'"
                           decoration-muted="state == 'draft'"/>
                    <field name="zip_filename" optional="show"/>
                    <field name="zip_file" filename="zip_filename" widget="binary" string="📦 ZIP Arşivini İndir"/>
                    <field name="merged_pdf_filename" optional="show"/>
                    <field name="merged_pdf_file" filename="merged_pdf_filename" widget="binary" string="📄 Birleştirilmiş PDF İndir"/>
                </list>
            </field>
        </record>

        <!-- Wizard Form View -->
        <record id="view_ugurlar_invoice_collector_form" model="ir.ui.view">
            <field name="name">ugurlar.invoice.collector.form</field>
            <field name="model">ugurlar.invoice.collector</field>
            <field name="arch" type="xml">
                <form string="Toptan Alış Fatura Toplama ve ZIP Arşivleme">
                    <header>
                        <button name="action_scan_invoices" 
                                string="Faturaları Tara ve Listele" 
                                type="object" 
                                class="btn-primary" 
                                invisible="state != 'draft'"/>
                                
                        <button name="action_download_zip" 
                                string="⚡ Canlı İndir ve Arşivle (Otomatik Akış)" 
                                type="object" 
                                class="btn-success" 
                                invisible="state not in ('scanned', 'downloading')"/>

                        <button name="action_start_background_download" 
                                string="🚀 Arka Planda İndir (Cron)" 
                                type="object" 
                                class="btn-info" 
                                invisible="state not in ('scanned', 'downloading')"/>

                        <button name="action_reset" 
                                string="Yeni Aramaya Başla" 
                                type="object" 
                                class="btn-secondary" 
                                invisible="state in ('draft',)"/>
                                
                        <field name="state" widget="statusbar" statusbar_visible="draft,scanned,downloading,completed"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <span>Toptan Alış Fatura Arşiv Sihirbazı</span>
                            </h1>
                        </div>

                        <!-- Progress Information Banner -->
                        <div class="alert alert-info" role="status" invisible="state not in ('scanned', 'downloading')">
                            <div style="font-size: 15px; font-weight: bold;">
                                📊 İndirme İlerlemesi: <field name="progress_text" readonly="1"/>
                            </div>
                            <div style="margin-top: 4px; color: #555;">
                                • <strong>⚡ Canlı İndir ve Arşivle:</strong> Sayfada canlı olarak sırayla paketleri indirir, otomatik akar ve bittiğinde hem ZIP hem de Birleştirilmiş Tek PDF'i hazırlar.<br/>
                                • <strong>🚀 Arka Planda İndir (Cron):</strong> Ekranı kapatıp Odoo'da diğer işlerinize devam etmenizi sağlar; bittiğinde ekranınıza tıklanabilir bildirim gelir.
                            </div>
                        </div>

                        <group invisible="state != 'draft'">
                            <group string="Filtre Kriterleri">
                                <field name="brand_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                                <field name="product_group_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group string="Tarih Aralığı &amp; Ayarlar">
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="batch_size"/>
                            </group>
                        </group>

                        <group invisible="state == 'draft'" string="Tarama &amp; İndirme Özeti">
                            <group>
                                <field name="total_found_invoices" readonly="1"/>
                                <field name="selected_invoices_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="processed_count" readonly="1"/>
                                <field name="pending_count" readonly="1"/>
                            </group>
                        </group>

                        <div class="alert alert-danger" role="alert" invisible="state != 'error'">
                            <strong>⚠️ Tüm faturalar hata aldı!</strong> Hiçbir PDF indirilemedi. Aşağıdaki tablodaki <b>Hata Detayı</b> sütununu kontrol ediniz.
                            Yeni bir arama başlatmak için üstteki <b>Yeni Aramaya Başla</b> butonunu kullanabilirsiniz.
                        </div>

                        <group invisible="state not in ('completed',)" string="Arşiv Dosyalarınız Hazır!">
                            <group string="📦 ZIP Arşivi (Hem Tek Tek PDF Hem Birleşik PDF İçerir)">
                                <field name="zip_filename" invisible="1"/>
                                <field name="zip_file" filename="zip_filename" widget="binary" string="📦 ZIP Arşivini İndir"/>
                            </group>
                            <group string="📄 Tek Birleştirilmiş PDF Dosyası (Sadece 1 PDF)">
                                <field name="merged_pdf_filename" invisible="1"/>
                                <field name="merged_pdf_file" filename="merged_pdf_filename" widget="binary" string="📄 Birleştirilmiş PDF'i İndir"/>
                            </group>
                        </group>

                        <notebook invisible="state == 'draft'">
                            <page string="Taranan Faturalar">
                                <field name="line_ids" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action 1: Open Jobs History List -->
        <record id="action_ugurlar_invoice_collector" model="ir.actions.act_window">
            <field name="name">Toptan Alış Fatura Arşivlerim</field>
            <field name="res_model">ugurlar.invoice.collector</field>
            <field name="view_mode">list,form</field>
            <field name="target">current</field>
        </record>

        <!-- Action 2: Open New Archive Form directly -->
        <record id="action_ugurlar_invoice_collector_new" model="ir.actions.act_window">
            <field name="name">Yeni Fatura Arşivi Oluştur</field>
            <field name="res_model">ugurlar.invoice.collector</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <!-- Root Menuitem -->
        <menuitem id="menu_ugurlar_invoice_collector_root" 
                  name="Fatura Arşiv Sihirbazı" 
                  parent="odoougurlar.menu_nebim_root" 
                  sequence="50"/>

        <!-- Submenu 1: History -->
        <menuitem id="menu_ugurlar_invoice_collector_history" 
                  name="📁 Geçmiş Arşivlerim (ZIP/PDF)" 
                  parent="menu_ugurlar_invoice_collector_root" 
                  action="action_ugurlar_invoice_collector" 
                  sequence="10"/>

        <!-- Submenu 2: Create New -->
        <menuitem id="menu_ugurlar_invoice_collector_new_sub" 
                  name="➕ Yeni Arşiv Oluştur" 
                  parent="menu_ugurlar_invoice_collector_root" 
                  action="action_ugurlar_invoice_collector_new" 
                  sequence="20"/>
    </data>
</odoo>
