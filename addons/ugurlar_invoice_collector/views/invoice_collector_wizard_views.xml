<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Line List View -->
        <record id="view_ugurlar_invoice_collector_line_list" model="ir.ui.view">
            <field name="name">ugurlar.invoice.collector.line.list</field>
            <field name="model">ugurlar.invoice.collector.line</field>
            <field name="arch" type="xml">
                <list editable="bottom" create="false" delete="true">
                    <field name="selected" widget="boolean_toggle" string="Seç"/>
                    <field name="item_code" readonly="1"/>
                    <field name="document_number" readonly="1"/>
                    <field name="document_date" readonly="1"/>
                    <field name="vendor_name" readonly="1"/>
                    <field name="ref_number" readonly="1"/>
                    <field name="download_status" widget="badge" 
                           decoration-success="download_status == 'success'" 
                           decoration-danger="download_status == 'error'"
                           decoration-info="download_status == 'pending'"/>
                    <field name="error_message" readonly="1" optional="show"/>
                </list>
            </field>
        </record>

        <!-- Wizard Form View -->
        <record id="view_ugurlar_invoice_collector_form" model="ir.ui.view">
            <field name="name">ugurlar.invoice.collector.form</field>
            <field name="model">ugurlar.invoice.collector</field>
            <field name="arch" type="xml">
                <form string="Toptan Alış Fatura Toplama ve ZIP Arşivleme">
                    <header>
                        <button name="action_scan_invoices" 
                                string="Faturaları Tara ve Listele" 
                                type="object" 
                                class="btn-primary" 
                                invisible="state != 'draft'"/>
                                
                        <button name="action_download_zip" 
                                string="Seçilen Faturaları İndir ve ZIP Yap" 
                                type="object" 
                                class="btn-success" 
                                invisible="state not in ('scanned', 'downloading')"/>

                        <button name="action_reset" 
                                string="Yeni Aramaya Başla" 
                                type="object" 
                                class="btn-secondary" 
                                invisible="state == 'draft'"/>
                                
                        <field name="state" widget="statusbar" statusbar_visible="draft,scanned,downloading,completed"/>
                    </header>
                    
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <span>Toptan Alış Fatura Arşiv Sihirbazı</span>
                            </h1>
                        </div>

                        <!-- Progress Information Banner -->
                        <div class="alert alert-info" role="status" invisible="state not in ('scanned', 'downloading')">
                            <div style="font-size: 15px; font-weight: bold;">
                                📊 İndirme İlerlemesi: <field name="progress_text" readonly="1"/>
                            </div>
                            <div style="margin-top: 4px; color: #555;">
                                Faturalar zaman aşımı olmaması için 25 saniyelik güvenli paketler halinde indirilir.
                                Kalan faturalar varsa <strong>"Seçilen Faturaları İndir ve ZIP Yap"</strong> butonuna tekrar basarak kaldığı yerden devam edebilirsiniz.
                            </div>
                        </div>

                        <group invisible="state != 'draft'">
                            <group string="Filtre Kriterleri">
                                <field name="brand_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="product_group_id" options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group string="Tarih Aralığı &amp; Ayarlar">
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="batch_size"/>
                            </group>
                        </group>

                        <group invisible="state == 'draft'" string="Tarama &amp; İndirme Özeti">
                            <group>
                                <field name="total_found_invoices" readonly="1"/>
                                <field name="selected_invoices_count" readonly="1"/>
                            </group>
                            <group>
                                <field name="processed_count" readonly="1"/>
                                <field name="pending_count" readonly="1"/>
                            </group>
                        </group>

                        <group invisible="state != 'completed'" string="ZIP Arşivi Hazır!">
                            <field name="zip_filename" invisible="1"/>
                            <field name="zip_file" filename="zip_filename" widget="binary" string="ZIP Arşivini İndirmek için Tıklayın"/>
                        </group>

                        <notebook invisible="state == 'draft'">
                            <page string="Taranan Faturalar">
                                <field name="line_ids" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action to open wizard -->
        <record id="action_ugurlar_invoice_collector" model="ir.actions.act_window">
            <field name="name">Toptan Alış Fatura Arşivi (ZIP)</field>
            <field name="res_model">ugurlar.invoice.collector</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
        </record>

        <!-- Menuitem -->
        <menuitem id="menu_ugurlar_invoice_collector_root" 
                  name="Fatura Arşiv Sihirbazı" 
                  parent="odoougurlar.menu_nebim_root" 
                  action="action_ugurlar_invoice_collector" 
                  sequence="50"/>
    </data>
</odoo>
