<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron Job for Background Invoice Collector Download -->
        <record id="cron_process_invoice_collector_jobs" model="ir.cron">
            <field name="name">Uğurlar Fatura Arşivleme: Arka Plan İndirme İşleyici</field>
            <field name="model_id" ref="model_ugurlar_invoice_collector"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_download_jobs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
