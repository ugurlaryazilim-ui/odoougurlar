<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="social_media_ai_manager.SocialInbox" owl="1">
        <div class="social-inbox-container d-flex h-100 bg-white">
            <!-- Sidebar -->
            <div class="inbox-sidebar border-end d-flex flex-column" style="width: 300px;">
                <div class="p-3 border-bottom bg-light">
                    <h4 class="m-0"><t t-esc="t('Conversations')"/></h4>
                </div>
                <div class="flex-grow-1 overflow-auto">
                    <t t-foreach="state.conversations" t-as="conv" t-key="conv.id">
                        <div class="p-3 border-bottom cursor-pointer conversation-item" 
                             t-on-click="() => this.selectConversation(conv.id)"
                             t-att-class="{'bg-light': state.activeConversation?.id === conv.id}">
                            <div class="d-flex justify-content-between">
                                <strong><t t-esc="conv.name"/></strong>
                                <span class="badge bg-primary rounded-pill" t-if="conv.unread_count > 0">
                                    <t t-esc="conv.unread_count"/>
                                </span>
                            </div>
                            <div class="text-muted small mt-1">
                                <t t-esc="conv.platform"/> - <t t-esc="conv.state"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Chat Area -->
            <div class="inbox-chat d-flex flex-column flex-grow-1">
                <t t-if="state.activeConversation">
                    <!-- Chat Header -->
                    <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                        <h4 class="m-0"><t t-esc="state.activeConversation.name"/></h4>
                        <button class="btn btn-warning btn-sm" 
                                t-if="state.activeConversation.state === 'bot'"
                                t-on-click="handoffToHuman">
                            <i class="fa fa-user"></i> <t t-esc="t('Handoff to Human')"/>
                        </button>
                    </div>

                    <!-- Chat Messages -->
                    <div class="p-3 flex-grow-1 overflow-auto d-flex flex-column gap-2" style="background-color: #f8f9fa;">
                        <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                            <div t-att-class="'d-flex w-100 ' + (msg.message_type === 'outgoing' ? 'justify-content-end' : 'justify-content-start')">
                                <div t-attf-class="p-2 rounded" t-att-style="msg.message_type === 'outgoing' ? 'background-color: #dcf8c6; max-width: 70%;' : 'background-color: white; border: 1px solid #dee2e6; max-width: 70%;'">
                                    <t t-esc="msg.content"/>
                                    <div t-if="msg.post_link" class="mt-2">
                                        <a t-att-href="msg.post_link" target="_blank" class="btn btn-sm btn-outline-secondary w-100" style="font-size: 0.8em; text-decoration: none;">
                                            <i class="fa fa-external-link"></i> Gönderiye Git
                                        </a>
                                    </div>
                                    <div class="text-end text-muted mt-1" style="font-size: 0.7em;">
                                        <t t-esc="msg.date"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Chat Input -->
                    <div class="p-3 border-top bg-white">
                        <div class="input-group">
                            <input type="text" class="form-control" t-att-placeholder="t('Type a message...')" 
                                   t-model="state.newMessage" 
                                   t-on-keyup="onKeyup"/>
                            <button class="btn btn-primary" t-on-click="sendMessage">
                                <i class="fa fa-paper-plane"></i> <t t-esc="t('Send')"/>
                            </button>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                        <h4><t t-esc="t('Select a conversation to start messaging')"/></h4>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
