<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="social_media_ai_manager.SocialInbox" owl="1">
        <div class="social-inbox-container d-flex position-relative bg-white">
            
            <!-- Sidebar -->
            <div t-attf-class="inbox-sidebar d-flex flex-column border-end #{state.showChatOnMobile ? 'mobile-hidden' : ''}" style="width: 350px;">
                <div class="p-3 border-bottom bg-light d-flex align-items-center justify-content-between">
                    <h4 class="m-0 fw-bold"><t t-esc="t('Conversations')"/></h4>
                    <div class="dropdown">
                        <button class="btn btn-sm btn-light rounded-circle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-ellipsis-v"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                            <li><a class="dropdown-item cursor-pointer" t-on-click="loadConversations"><i class="fa fa-refresh me-2 text-muted"></i>Yenile</a></li>
                        </ul>
                    </div>
                </div>
                <div class="flex-grow-1 overflow-auto custom-scrollbar">
                    <t t-foreach="state.conversations" t-as="conv" t-key="conv.id">
                        <div class="p-3 border-bottom cursor-pointer conversation-item d-flex align-items-center gap-3" 
                             t-on-click="() => this.selectConversation(conv.id)"
                             t-att-class="{'active': state.activeConversation?.id === conv.id}">
                            
                            <!-- Platform Icon Avatar -->
                            <div t-attf-class="platform-icon flex-shrink-0 #{conv.platform === 'instagram' ? 'platform-instagram' : (conv.platform === 'facebook' ? 'platform-facebook' : (conv.platform === 'whatsapp' ? 'platform-whatsapp' : 'platform-default'))}">
                                <i t-attf-class="fa #{conv.platform === 'instagram' ? 'fa-instagram' : (conv.platform === 'facebook' ? 'fa-facebook' : (conv.platform === 'whatsapp' ? 'fa-whatsapp' : 'fa-comment'))}"></i>
                            </div>

                            <!-- Conversation Details -->
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                    <strong class="text-truncate d-block" style="font-size: 1.05rem;"><t t-esc="conv.name"/></strong>
                                    <span class="badge bg-danger rounded-pill" t-if="conv.unread_count > 0">
                                        <t t-esc="conv.unread_count"/>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted text-capitalize"><t t-esc="conv.platform"/></small>
                                    <div class="d-flex gap-1 align-items-center">
                                        <small t-if="conv.user_id" class="text-primary fw-bold" style="font-size: 0.7em;">
                                            <i class="fa fa-user-circle"></i> <t t-esc="conv.user_id[1]"/>
                                        </small>
                                        <small t-attf-class="badge rounded-pill #{conv.state === 'bot' ? 'bg-secondary' : 'bg-success'}">
                                            <t t-esc="conv.state"/>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-if="state.conversations.length === 0">
                        <div class="text-center text-muted p-5">
                            <i class="fa fa-inbox fa-3x mb-3 text-light"></i>
                            <p>Hiç görüşme bulunamadı.</p>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Chat Area -->
            <div t-attf-class="inbox-chat d-flex flex-column flex-grow-1 #{!state.showChatOnMobile ? 'mobile-hidden' : ''}">
                <t t-if="state.activeConversation">
                    
                    <!-- Chat Header -->
                    <div class="p-2 p-md-3 chat-header d-flex justify-content-between align-items-center border-bottom shadow-sm">
                        <div class="d-flex align-items-center gap-2 gap-md-3 overflow-hidden">
                            <!-- Mobile Back Button -->
                            <button class="btn btn-light btn-sm rounded-circle d-md-none flex-shrink-0" t-on-click="backToList" style="width: 32px; height: 32px; padding: 0;">
                                <i class="fa fa-arrow-left"></i>
                            </button>
                            
                            <div t-attf-class="platform-icon flex-shrink-0 #{state.activeConversation.platform === 'instagram' ? 'platform-instagram' : (state.activeConversation.platform === 'facebook' ? 'platform-facebook' : 'platform-default')}" style="width: 35px; height: 35px; font-size: 1.2rem;">
                                <i t-attf-class="fa #{state.activeConversation.platform === 'instagram' ? 'fa-instagram' : (state.activeConversation.platform === 'facebook' ? 'fa-facebook' : 'fa-user')}"></i>
                            </div>
                            
                            <div class="overflow-hidden">
                                <h6 class="m-0 fw-bold text-truncate" style="max-width: 45vw; font-size: 0.95rem;"><t t-esc="state.activeConversation.name"/></h6>
                                <small class="text-muted text-capitalize d-block text-truncate" style="font-size: 0.75rem;"><t t-esc="state.activeConversation.platform"/> Sohbeti</small>
                            </div>
                        </div>

                        <button class="btn btn-outline-warning btn-sm fw-bold rounded-pill px-2 px-md-3 text-nowrap ms-2 flex-shrink-0 shadow-sm" 
                                t-on-click="handoffToHuman" style="font-size: 0.8rem;">
                            <i class="fa fa-user me-1"></i> <t t-esc="state.activeConversation.state === 'bot' ? 'İnsana Devret' : 'Bota Devret'"/>
                        </button>
                    </div>

                    <!-- Chat Messages -->
                    <div class="p-4 flex-grow-1 overflow-auto d-flex flex-column gap-3 custom-scrollbar" t-ref="chatMessagesContainer">
                        <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                            <div t-att-class="'d-flex w-100 ' + (msg.message_type === 'outgoing' ? 'justify-content-end' : 'justify-content-start')">
                                <div t-attf-class="msg-bubble #{msg.message_type === 'outgoing' ? 'msg-outgoing' : 'msg-incoming'}" style="max-width: 75%;">
                                    <t t-if="msg.has_attachment">
                                        <div class="mb-2">
                                            <img t-attf-src="/web/image/social.media.message/{{msg.id}}/attachment" style="max-width: 200px; max-height: 200px; border-radius: 8px; object-fit: contain;" alt="Attachment"/>
                                        </div>
                                    </t>
                                    <div style="white-space: pre-wrap;"><t t-esc="msg.content"/></div>
                                    
                                    <div class="mt-2" t-if="msg.post_link">
                                        <a t-att-href="msg.post_link" target="_blank" class="btn btn-sm btn-light rounded-pill" style="font-size: 0.8rem;">
                                            <i class="fa fa-external-link me-1"></i> Gönderiyi Gör
                                        </a>
                                    </div>
                                    
                                    <div class="msg-time d-flex align-items-center gap-1">
                                        <t t-esc="formatTime(msg.date)"/>
                                        <i class="fa fa-check-double text-info" t-if="msg.message_type === 'outgoing'"></i>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>

                    <!-- Chat Input -->
                    <div class="chat-input-container">
                        <t t-if="state.attachmentPreview">
                            <div class="attachment-preview p-2 bg-light mb-2 rounded position-relative d-inline-block shadow-sm">
                                <img t-att-src="state.attachmentPreview" style="max-height: 80px; border-radius: 4px;"/>
                                <button class="btn btn-sm btn-danger position-absolute top-0 start-100 translate-middle rounded-circle shadow" t-on-click="removeAttachment" style="width: 24px; height: 24px; padding: 0; line-height: 1;">
                                    <i class="fa fa-times" style="font-size: 12px;"></i>
                                </button>
                            </div>
                        </t>
                        <div class="d-flex align-items-end bg-white rounded-4 p-1 shadow-sm border" style="min-height: 48px;">
                            <input type="file" accept="image/*" class="d-none" t-ref="galleryInput" t-on-change="onFileChange"/>
                            <input type="file" accept="image/*" capture="environment" class="d-none" t-ref="cameraInput" t-on-change="onFileChange"/>
                            
                            <textarea class="form-control border-0 bg-transparent shadow-none px-3 py-2 m-0 flex-grow-1" 
                                   t-att-placeholder="t('Type a message...')" 
                                   t-model="state.newMessage" 
                                   t-ref="messageInput"
                                   t-on-input="autoResizeInput"
                                   t-on-keydown="onKeydown" 
                                   style="box-shadow: none !important; outline: none; resize: none; overflow-y: auto; max-height: 150px; min-height: 40px; display: block;"></textarea>
                            
                            <div class="d-flex align-items-center pe-1 pb-1 flex-shrink-0">
                                <div class="dropdown dropup" style="margin-right: 4px;">
                                    <button class="btn btn-link text-muted p-2 text-decoration-none" data-bs-toggle="dropdown" aria-expanded="false" title="Ekle" style="box-shadow: none;">
                                        <i class="fa fa-paperclip fs-5"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mb-2" style="min-width: 150px; padding: 8px 0;">
                                        <li><a class="dropdown-item py-2" href="#" t-on-click="triggerGalleryInput"><i class="fa fa-image me-2 text-primary"></i> Galeri</a></li>
                                        <li><a class="dropdown-item py-2" href="#" t-on-click="triggerCameraInput"><i class="fa fa-camera me-2 text-danger"></i> Kamera</a></li>
                                        <li><hr class="dropdown-divider"/></li>
                                        <li><a class="dropdown-item py-2" href="#" t-on-click="openProductSearch"><i class="fa fa-barcode me-2 text-success"></i> Ürün Ara</a></li>
                                    </ul>
                                </div>
                                <button class="btn btn-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm" t-on-click="sendMessage" style="width: 38px; height: 38px; flex-shrink: 0;">
                                    <i class="fa fa-paper-plane" style="margin-left: -2px;"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </t>
                
                <!-- Empty State -->
                <t t-else="">
                    <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center" style="background-color: #f8f9fa;">
                        <img src="https://cdn-icons-png.flaticon.com/512/1041/1041916.png" style="width: 150px; opacity: 0.5; margin-bottom: 20px; filter: grayscale(100%);"/>
                        <h4 class="text-muted fw-light"><t t-esc="t('Select a conversation to start messaging')"/></h4>
                        <p class="text-muted small">Sol menüden bir görüşme seçerek yanıt vermeye başlayabilirsiniz.</p>
                        
                        <button class="btn btn-primary d-md-none mt-3 rounded-pill px-4" t-on-click="backToList">
                            <i class="fa fa-list me-2"></i> Görüşmeleri Aç
                        </button>
                    </div>
                </t>
            </div>
            
            <!-- Product Search Modal -->
            <div t-if="state.showProductSearch" class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); z-index: 1050;">
                <div class="modal-dialog modal-dialog-centered mx-2 mx-md-auto">
                    <div class="modal-content border-0 shadow-lg rounded-4 w-100">
                        <div class="modal-header border-0 pb-0 pt-3 px-3">
                            <h5 class="modal-title fw-bold">Ürün Ara / Barkod Okut</h5>
                            <button type="button" class="btn-close" t-on-click="closeProductSearch"></button>
                        </div>
                        <div class="modal-body">
                            <div class="input-group mb-3 shadow-sm rounded-pill overflow-hidden">
                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa fa-search"></i></span>
                                <input type="text" class="form-control border-start-0 border-end-0 px-0 shadow-none" 
                                       placeholder="Barkod okutun veya ürün adı..." 
                                       t-model="state.productQuery" t-on-keyup="searchProduct" t-ref="productSearchInput"/>
                                <button class="btn btn-white border border-start-0 text-primary" type="button" t-on-click="startBarcodeScanner" title="Kamera ile Barkod Oku">
                                    <i class="fa fa-barcode fs-5"></i>
                                </button>
                            </div>
                            
                            <div class="list-group list-group-flush rounded-3" style="max-height: 350px; overflow-y: auto;">
                                <t t-foreach="state.productResults" t-as="prod" t-key="prod.id">
                                    <button class="list-group-item list-group-item-action py-3 border-bottom" t-on-click="() => this.selectProduct(prod)">
                                        <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                            <h6 class="mb-0 fw-bold text-truncate" style="max-width: 75%;"><t t-esc="prod.display_name"/></h6>
                                            <span t-attf-class="badge rounded-pill #{prod.qty_available > 0 ? 'bg-success' : 'bg-danger'}">
                                                <t t-esc="prod.qty_available"/> Stok
                                            </span>
                                        </div>
                                        <div class="d-flex w-100 justify-content-between">
                                            <small class="text-muted"><i class="fa fa-barcode me-1"></i> <t t-esc="prod.barcode"/></small>
                                            <small class="text-dark fw-bold"><t t-esc="prod.list_price"/> TL</small>
                                        </div>
                                    </button>
                                </t>
                                <div t-if="state.productQuery.length > 2 and state.productResults.length === 0" class="text-center text-muted py-4">
                                    <i class="fa fa-search fa-2x mb-2 text-light"></i>
                                    <p class="mb-0">Ürün bulunamadı.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </t>
</templates>
