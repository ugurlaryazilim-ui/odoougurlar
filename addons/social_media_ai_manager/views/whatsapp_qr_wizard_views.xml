<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_qr_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.qr.wizard.form</field>
        <field name="model">social.media.whatsapp.qr.wizard</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Kurulumu">
                <field name="state" invisible="1"/>
                
                <div class="alert alert-info text-center" role="alert" invisible="state == 'error'">
                    <field name="status_message"/>
                </div>
                
                <div class="alert alert-danger text-center" role="alert" invisible="state != 'error'">
                    <field name="status_message"/>
                </div>
                
                <div class="text-center" invisible="not qr_image or state == 'connected'">
                    <field name="qr_image" widget="image" options="{'size': [300, 300]}" style="width: 300px; height: 300px; border: 1px solid #ccc; border-radius: 5px; padding: 10px; margin: 0 auto; display: block;"/>
                    <h3 class="mt-3">Lütfen telefonunuzdan okutun</h3>
                </div>
                
                <div class="text-center" invisible="state != 'connected'">
                    <i class="fa fa-check-circle text-success" style="font-size: 100px;" title="Bağlı"></i>
                    <h2 class="mt-3 text-success">Bağlantı Başarılı!</h2>
                </div>

                <footer>
                    <button name="action_check_status" string="Bağlantı Durumunu Kontrol Et" type="object" class="btn-primary" invisible="state != 'qr_ready'" icon="fa-refresh"/>
                    <button string="Kapat" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
