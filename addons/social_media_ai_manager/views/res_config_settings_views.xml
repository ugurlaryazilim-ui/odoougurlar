<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.social.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Social AI" string="Social Media &amp; AI" name="social_media_ai_manager">
                    <block title="AI Provider Configuration" name="ai_config">
                        <setting string="AI Provider" help="Choose which AI engine will handle automated responses.">
                            <field name="social_ai_provider" widget="radio"/>
                        </setting>

                        <setting string="OpenAI Configuration" invisible="social_ai_provider != 'openai'">
                            <field name="social_openai_api_key" password="True"/>
                        </setting>

                        <setting string="Google Gemini Configuration" invisible="social_ai_provider != 'gemini'">
                            <field name="social_gemini_api_key" password="True"/>
                        </setting>

                        <setting string="Ollama Configuration" invisible="social_ai_provider != 'ollama'">
                            <div class="content-group">
                                <field name="social_ollama_endpoint" placeholder="http://localhost:11434/api/generate"/>
                                <br/>
                                <field name="social_ollama_model" placeholder="llama3"/>
                            </div>
                        </setting>
                    </block>
                    
                    <block title="AI System Settings" name="ai_system_settings">
                        <setting string="Global System Prompt" help="The main prompt given to the AI.">
                            <field name="social_system_prompt" widget="text"/>
                        </setting>
                        <setting string="Comment Auto-Reply" help="The public reply text sent when responding to a comment. The AI's actual answer will be sent via DM.">
                            <field name="social_comment_auto_reply"/>
                        </setting>
                    </block>
                    <block title="Yapay Zeka Yetkileri (İzinler)" name="ai_permissions_settings">
                        <setting string="Yorumlara Cevap Ver" help="Yapay zekanın gönderilere gelen yorumları okuyup cevaplamasına izin verir.">
                            <field name="social_enable_comments" widget="boolean_toggle"/>
                        </setting>
                        <setting string="DM'lere Cevap Ver" help="Yapay zekanın DM kutunuza gelen mesajları okuyup cevaplamasına izin verir.">
                            <field name="social_enable_dms" widget="boolean_toggle"/>
                        </setting>
                        <setting string="Paylaşımları Yap" help="Zamanlanmış içeriklerin otomatik olarak Meta'da yayınlanmasına izin verir.">
                            <field name="social_enable_posting" widget="boolean_toggle"/>
                        </setting>
                    </block>

                    <block title="Sistem Zamanlamaları" name="cron_settings">
                        <setting string="Gönderi Yayınlama Kontrolü (Dakika)" help="Zamanlanmış gönderilerin kaç dakikada bir kontrol edilip yayınlanacağını belirler (Varsayılan: 3).">
                            <field name="social_post_cron_interval"/>
                        </setting>
                    </block>

                    <block title="CRM: Personel Atamaları" name="crm_assignment_settings">
                        <setting string="Devredilecek Personeller (Handoff)" help="Yapay zeka başa çıkamadığında veya İnsana Devret dendiğinde sohbetin atanacağı Odoo kullanıcılarını seçin.">
                            <field name="social_handoff_user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </setting>
                    </block>

                    <block title="Meta (Facebook &amp; Instagram) OAuth Configuration" name="meta_oauth_settings">
                        <setting string="Meta App Credentials" help="Enter your App ID and Secret from Facebook Developer Console for OAuth Login.">
                            <div class="content-group">
                                <label for="social_meta_app_id" string="App ID"/>
                                <field name="social_meta_app_id"/>
                                <br/>
                                <label for="social_meta_app_secret" string="App Secret"/>
                                <field name="social_meta_app_secret" password="True"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_social_media_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module' : 'social_media_ai_manager', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_social_media_settings" name="Settings" parent="menu_social_media_config" action="action_social_media_config_settings" sequence="100"/>
</odoo>
