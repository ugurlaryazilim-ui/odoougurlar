<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Calendar View -->
    <record id="social_media_post_view_calendar" model="ir.ui.view">
        <field name="name">social.media.post.calendar</field>
        <field name="model">social.media.post</field>
        <field name="arch" type="xml">
            <calendar string="Post Calendar" date_start="scheduled_date" color="state">
                <field name="name"/>
                <field name="state" filters="1"/>
            </calendar>
        </field>
    </record>

    <!-- Tree View -->
    <record id="social_media_post_view_tree" model="ir.ui.view">
        <field name="name">social.media.post.tree</field>
        <field name="model">social.media.post</field>
        <field name="arch" type="xml">
            <list string="Social Media Posts" decoration-info="state == 'draft'" decoration-warning="state == 'scheduled'" decoration-success="state == 'posted'" decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="scheduled_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="social_media_post_view_form" model="ir.ui.view">
        <field name="name">social.media.post.form</field>
        <field name="model">social.media.post</field>
        <field name="arch" type="xml">
            <form string="Social Media Post">
                <header>
                    <button name="action_schedule" type="object" string="Schedule" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" type="object" string="Back to Draft" invisible="state not in ('scheduled', 'error')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,posted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Post Title..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="post_type" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                            <field name="scheduled_date" readonly="state != 'draft'"/>
                            <field name="account_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content">
                            <field name="message" placeholder="What do you want to share?" readonly="state != 'draft'"/>
                            <group string="Media">
                                <field name="image_ids" widget="many2many_binary" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Posttaki Ürünler (Yapay Zeka)">
                            <group>
                                <div class="text-muted mb-3" colspan="2">
                                    <i>Bu gönderiye yorum geldiğinde, Yapay Zeka müşteriye buradaki ürünlerin bilgilerini (fiyat, stok vb.) ve Shopify sipariş linkini sunar.</i>
                                </div>
                                <label for="product_tmpl_ids" string="Gönderideki Ürünler" style="font-weight: bold;"/>
                                <div class="o_row w-100 mb-2">
                                    <field name="barcode_scan" widget="barcode" placeholder="Barkod ile Ekle..." invisible="state != 'draft'" class="oe_inline"/>
                                    <button name="action_open_barcode_scanner" type="object" string="Kamera ile Oku" icon="fa-camera" class="btn btn-primary ms-2" invisible="state != 'draft'"/>
                                </div>
                                <field name="product_tmpl_ids" readonly="state != 'draft'" nolabel="1">
                                    <list>
                                        <field name="barcode" widget="CopyClipboardChar" string="Barkod"/>
                                        <field name="default_code" string="Ürün Kodu"/>
                                        <field name="name" string="Ürün Adı"/>
                                        <field name="list_price" string="Fiyat" optional="show"/>
                                        <field name="qty_available" string="Stok" optional="show"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="YouTube Ayarları">
                            <group>
                                <div class="text-muted mb-3" colspan="2">
                                    <i>Sadece YouTube paylaşımlarında geçerli olacak profesyonel ayarlar.</i>
                                </div>
                                <field name="youtube_privacy" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                <field name="youtube_tags" placeholder="Örn: moda,elbise,bursa,trend" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Publishing Status" invisible="state == 'draft'">
                            <field name="post_line_ids" readonly="1">
                                <list>
                                    <field name="account_id"/>
                                    <field name="platform"/>
                                    <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                                    <field name="error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_social_media_post" model="ir.actions.act_window">
        <field name="name">Social Posts</field>
        <field name="res_model">social.media.post</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('social_media_post_view_calendar')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('social_media_post_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('social_media_post_view_form')})]"/>
    </record>

    <menuitem id="menu_social_media_posts_all" name="All Posts" parent="menu_social_media_posts" action="action_social_media_post" sequence="10"/>
</odoo>
