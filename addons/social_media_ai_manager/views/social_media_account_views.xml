<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="social_media_account_view_tree" model="ir.ui.view">
        <field name="name">social.media.account.tree</field>
        <field name="model">social.media.account</field>
        <field name="arch" type="xml">
            <list string="Social Media Accounts">
                <field name="name"/>
                <field name="platform"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'" decoration-info="state == 'draft'" decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="social_media_account_view_form" model="ir.ui.view">
        <field name="name">social.media.account.form</field>
        <field name="model">social.media.account</field>
        <field name="arch" type="xml">
            <form string="Social Media Account">
                <header>
                    <button name="action_login_facebook" string="Login with Facebook" type="object" class="oe_highlight" invisible="platform not in ('facebook', 'instagram')"/>
                    <button name="action_test_connection" string="Test Connection" type="object" class="oe_highlight" invisible="state == 'connected'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. My Facebook Page"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="platform"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="api_token" password="True"/>
                            <field name="webhook_secret" password="True"/>
                            <field name="phone_number" invisible="platform != 'whatsapp'"/>
                            <field name="meta_page_id" invisible="platform not in ('facebook', 'instagram')"/>
                            <field name="meta_ig_id" invisible="platform != 'instagram'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_social_media_account" model="ir.actions.act_window">
        <field name="name">Social Media Accounts</field>
        <field name="res_model">social.media.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_social_media_accounts" name="Social Accounts" parent="menu_social_media_config" action="action_social_media_account" sequence="20"/>
</odoo>
