<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: aralık mağaza ayarından (sync_interval) yönetilir, modül yükseltmesi ezmesin -->
    <data noupdate="1">
        <record id="ir_cron_n11_sync_orders" model="ir.cron">
            <field name="name">N11: Siparişleri Senkronize Et</field>
            <field name="model_id" ref="model_n11_order"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_n11_orders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_n11_sync_returns" model="ir.cron">
            <field name="name">N11: İade Taleplerini Senkronize Et</field>
            <field name="model_id" ref="model_n11_refund"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_n11_returns()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
