<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="n11_store_form" model="ir.ui.view">
        <field name="name">n11.store.form</field>
        <field name="model">n11.store</field>
        <field name="arch" type="xml">
            <form string="N11 Mağaza">
                <header>
                    <button name="action_test_connection" type="object" string="Bağlantı Test Et" class="btn-primary"/>
                    <button name="action_sync_now" type="object" string="Şimdi Senkronize Et" class="btn-secondary"/>
                    <button name="action_sync_returns" type="object" string="İade Taleplerini Çek" class="btn-secondary"
                            invisible="not process_returns"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-shopping-cart" name="action_view_orders" type="object">
                            <field name="order_count" widget="statinfo" string="Siparişler"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-exclamation-triangle" name="action_view_orders" type="object"
                                context="{'only_errors': True}" invisible="not error_order_count">
                            <field name="error_order_count" widget="statinfo" string="Hatalı"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-undo" name="action_view_refunds" type="object"
                                invisible="not process_returns and not refund_count">
                            <field name="refund_count" widget="statinfo" string="İadeler"/>
                        </button>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not last_sync_error">
                        <strong>Son senkronizasyon hatası</strong> (<field name="last_sync_error_date" readonly="1" class="oe_inline"/>):
                        <field name="last_sync_error" readonly="1" nolabel="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Mağaza Adı"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="API ve Temel Ayarlar">
                            <group>
                                <group string="API Bilgileri (N11 REST)">
                                    <field name="n11_app_key"/>
                                    <field name="n11_app_secret" password="True"/>
                                </group>
                                <group string="Senkronizasyon">
                                    <field name="auto_sync"/>
                                    <field name="sync_interval" invisible="not auto_sync"/>
                                    <field name="order_day_range"/>
                                    <field name="last_sync" readonly="1"/>
                                    <field name="active"/>
                                    <separator string="Tek Sipariş Çek" colspan="2"/>
                                    <field name="fetch_order_number" string="Sipariş No"
                                           placeholder="Sipariş numarası girin..."/>
                                    <button name="action_fetch_single_order" type="object"
                                            string="📥 Sipariş Çek" class="btn-primary"
                                            colspan="2"/>
                                </group>
                            </group>
                        </page>
                        <page string="Sipariş ve Müşteri">
                            <group>
                                <group string="Müşteri / Fatura">
                                    <field name="customer_prefix"/>
                                    <field name="skip_customer_email"/>
                                </group>
                                <group string="Sipariş İşleme">
                                    <field name="auto_confirm"/>
                                    <field name="auto_cancel"/>
                                    <field name="auto_accept_orders"/>
                                </group>
                            </group>
                        </page>
                        <page string="İade ve Kargo">
                            <group>
                                <group string="İade Ayarları">
                                    <field name="process_returns"/>
                                    <field name="return_day_range" invisible="not process_returns"/>
                                </group>
                                <group string="Sipariş Onayı">
                                    <field name="auto_send_cargo" string="Transfer Doğrulanınca n11'de Onayla"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="n11_store_tree" model="ir.ui.view">
        <field name="name">n11.store.tree</field>
        <field name="model">n11.store</field>
        <field name="arch" type="xml">
            <list string="N11 Mağazaları">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="auto_sync"/>
                <field name="last_sync"/>
                <field name="last_sync_error" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_n11_store" model="ir.actions.act_window">
        <field name="name">N11 Mağazaları</field>
        <field name="res_model">n11.store</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
