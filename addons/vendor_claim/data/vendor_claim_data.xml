<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_vendor_claim" model="ir.sequence">
            <field name="name">Tedarikçi İnceleme</field>
            <field name="code">vendor.claim</field>
            <field name="prefix">INC-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="cron_vendor_claim_reminders" model="ir.cron">
            <field name="name">Tedarikçi İnceleme: Teslim alınmayanlara hatırlatma SMS'i</field>
            <field name="model_id" ref="model_vendor_claim"/>
            <field name="state">code</field>
            <field name="code">model._cron_return_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_vendor_claim_overdue" model="ir.cron">
            <field name="name">Tedarikçi İnceleme: Tedarikçide gecikenler için aktivite</field>
            <field name="model_id" ref="model_vendor_claim"/>
            <field name="state">code</field>
            <field name="code">model._cron_overdue_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
