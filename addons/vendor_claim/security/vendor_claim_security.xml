<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="module_category_vendor_claim" model="ir.module.category">
            <field name="name">Tedarikçi İnceleme</field>
            <field name="sequence">60</field>
        </record>

        <record id="privilege_vendor_claim" model="res.groups.privilege">
            <field name="name">Tedarikçi İnceleme</field>
            <field name="category_id" ref="module_category_vendor_claim"/>
        </record>

        <!-- Tüm çalışanlar (base.group_user) kayıt açıp ilerletir, silemez.
             Yönetici: silme, her durum geçişi (düzeltme), ayarlar -->
        <record id="group_vendor_claim_manager" model="res.groups">
            <field name="name">Yönetici</field>
            <field name="privilege_id" ref="privilege_vendor_claim"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_vendor_claim_manager'))]"/>
        </record>
    </data>
</odoo>
