<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ═══════════════ Tedarikçiye giden inceleme talep formu (A4) ═══════════════ -->
    <template id="report_vendor_claim_form">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3>Ürün İnceleme Talep Formu</h3>
                        <p>
                            <strong>Takip No:</strong> <span t-field="o.name"/>
                            <span class="ms-4"><strong>Kayıt Tarihi:</strong> <span t-field="o.create_date" t-options="{'widget': 'date'}"/></span>
                        </p>
                        <div class="row mt-3">
                            <div class="col-6">
                                <h6 class="text-uppercase text-muted">Tedarikçi</h6>
                                <div t-if="o.vendor_id" t-field="o.vendor_id"
                                     t-options="{'widget': 'contact', 'fields': ['name', 'address', 'phone', 'email'], 'no_marker': True}"/>
                                <div t-else="" t-out="o.vendor_name or ''"/>
                            </div>
                            <div class="col-6">
                                <h6 class="text-uppercase text-muted">Satış Bilgisi</h6>
                                <div t-if="o.invoice_no"><strong>Fatura No:</strong> <span t-field="o.invoice_no"/></div>
                                <div t-if="o.invoice_date"><strong>Fatura Tarihi:</strong> <span t-field="o.invoice_date"/></div>
                                <div><strong>Müşteri Talebi:</strong> <span t-field="o.customer_request"/></div>
                            </div>
                        </div>
                        <table class="table table-sm table-bordered mt-4">
                            <thead>
                                <tr><th>Barkod</th><th>Ürün Kodu</th><th>Ürün</th><th class="text-end">Adet</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td t-out="o.product_barcode or ''"/>
                                    <td t-out="o.product_code or ''"/>
                                    <td t-out="o.product_name or o.product_id.display_name or ''"/>
                                    <td class="text-end" t-out="'%g' % o.quantity"/>
                                </tr>
                            </tbody>
                        </table>
                        <h6 class="mt-3">Ayıp / Şikayet Açıklaması</h6>
                        <p style="white-space: pre-line;" t-out="o.defect_description"/>
                        <t t-set="photos" t-value="o.sudo().photo_ids.filtered(lambda a: (a.mimetype or '').startswith('image/'))"/>
                        <div t-if="photos" class="mt-3">
                            <h6>Fotoğraflar</h6>
                            <t t-foreach="photos" t-as="ph">
                                <img t-att-src="image_data_uri(ph.datas)" style="max-width: 48%; max-height: 300px; margin: 0 1% 8px 0;"/>
                            </t>
                        </div>
                        <div class="row mt-5">
                            <div class="col-7">
                                <h6>Tedarikçi İnceleme Sonucu</h6>
                                <p>☐ Tamir edildi &#160;&#160; ☐ Değiştirildi &#160;&#160; ☐ İade kabul &#160;&#160; ☐ Ret</p>
                                <p>Açıklama: ..........................................................</p>
                            </div>
                            <div class="col-5 text-end">
                                <p class="mt-4">Kaşe / İmza</p>
                            </div>
                        </div>
                        <p class="small text-muted mt-4">Ürünü geri gönderirken lütfen <strong t-field="o.name"/> takip numarasını belirtiniz.</p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- ═══════════════ Müşteriye verilen teslim fişi (80 mm) ═══════════════ -->
    <template id="report_vendor_claim_slip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <!-- article: Odoo gövdeyi charset=utf-8 içeren rapor düzeniyle sarar; yoksa wkhtmltopdf Latin-1 okur -->
                <div class="article">
                    <div class="page" style="font-family: 'DejaVu Sans', Arial, sans-serif; font-size: 12px; width: 72mm;">
                        <div style="text-align: center;">
                            <strong style="font-size: 15px;" t-out="o.company_id.name"/><br/>
                            <span>Ürün İnceleme Teslim Fişi</span>
                        </div>
                        <!-- Barkod: fatura varsa fatura no (listede okutunca kayıt bulunur), yoksa takip no -->
                        <t t-set="code" t-value="o.invoice_no or o.name"/>
                        <div style="text-align: center; margin: 6px 0;">
                            <img t-att-src="'/report/barcode/Code128/%s?width=600&amp;height=120' % code" style="width: 64mm; height: 14mm;"/>
                            <div style="font-size: 12px;" t-out="code"/>
                            <div style="font-size: 16px; font-weight: bold; margin-top: 2px;">Takip No: <t t-out="o.name"/></div>
                        </div>
                        <t t-set="lbl" t-value="'width: 19mm; font-weight: bold; vertical-align: top; padding: 1px 4px 1px 0; white-space: nowrap;'"/>
                        <t t-set="val" t-value="'vertical-align: top; padding: 1px 0;'"/>
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr><td t-att-style="lbl">Tarih:</td><td t-att-style="val"><span t-field="o.create_date" t-options="{'widget': 'datetime', 'format': 'dd.MM.yyyy HH:mm'}"/></td></tr>
                            <tr><td t-att-style="lbl">Müşteri:</td><td t-att-style="val" t-out="o.customer_name"/></tr>
                            <tr t-if="o.customer_mobile"><td t-att-style="lbl">Telefon:</td><td t-att-style="val" t-out="o.customer_mobile"/></tr>
                            <tr t-if="o.invoice_no"><td t-att-style="lbl">Fatura No:</td><td t-att-style="val" t-out="o.invoice_no"/></tr>
                            <tr><td t-att-style="lbl">Ürün:</td><td t-att-style="val" t-out="o.product_name or o.product_code or ''"/></tr>
                            <tr t-if="o.product_barcode"><td t-att-style="lbl">Barkod:</td><td t-att-style="val" t-out="o.product_barcode"/></tr>
                        </table>
                        <div style="margin-top: 6px; border-top: 1px dashed #000; padding-top: 4px;"><strong>Şikayet:</strong>
                            <div style="white-space: pre-line;" t-out="o.defect_description"/>
                        </div>
                        <div style="margin-top: 8px; font-size: 10px;">
                            Ürününüz incelenmek üzere üretici firmaya gönderilecektir. İnceleme sonucu tarafınıza bildirilecektir.
                            Teslim almak için bu fişi getiriniz.
                        </div>
                        <div style="margin-top: 14px;"><strong>Teslim Alan:</strong> <span t-out="o.user_id.name or ''"/></div>
                        <div style="margin-top: 14px;"><strong>Müşteri İmza:</strong> ..............................</div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
