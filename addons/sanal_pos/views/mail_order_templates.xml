<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    DIKKAT: Mail Order kart sayfası (bkz. KARARLAR K-13, K-16). Bu şablonlara
      * kart sayfası <head>'indeki TEK hash'li script (yalnız tools.mail_order_script() çıktısı,
        K-16) dışında <script>; satır içi olay işleyicisi (on...=), iframe/object/embed,
      * web.layout / t-call ile arka uç şablonu ya da /web/assets varlığı,
      * kart alanlarına value / t-att-value,
      * Odoo'ya POST eden form ya da csrf_token (YALNIZ mail_order_result_page'te, KK-3.9: kart alanı yok),
      * style="" (CSP style-src 'self' satır içi stili zaten engeller)
    EKLEMEYİN: kart verisi Odoo koduna/sunucusuna açılır, CSP (default-src 'none') sayfayı bozar.
    Formun action'ı yalnız provider.direct_post_url (Paratika sale3d); alan adları yalnız
    Paratika'nın Direct POST alan adlarıdır (cardOwner, pan, expiryMonth, expiryYear, cvv,
    installmentCount). Tek stil kaynağı /sanal_pos/static/src/css/mail_order.css (css_url: içerikten
    türeyen ?v= ile; sürümsüz adres dağıtımdan sonra 1 hafta eski CSS ile açılır); görseller
    yalnız /sanal_pos/static/... ve /web/image/res.users/... (CSP img-src 'self').
    t-call yalnız bu dosyadaki mail_order_* parçalarına yapılır.
    -->

    <!-- Üst bar: kullanıcı/şirket adı yalnız sunucuda kaçışlanarak basılır; bağlantılar sabit eylem adresleridir. -->
    <template id="mail_order_navbar" name="Sanal POS: Mail Order üst bar">
        <header class="mo-navbar">
            <span class="mo-nav-apps" aria-hidden="true">
                <svg class="mo-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                    <circle cx="5" cy="5" r="2"/><circle cx="12" cy="5" r="2"/><circle cx="19" cy="5" r="2"/>
                    <circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/>
                    <circle cx="5" cy="19" r="2"/><circle cx="12" cy="19" r="2"/><circle cx="19" cy="19" r="2"/>
                </svg>
            </span>
            <a class="mo-nav-brand" t-att-href="nav['brand_url']">
                <img src="/sanal_pos/static/description/icon.svg" width="24" height="24" alt=""/>
                <span>Sanal POS</span>
            </a>
            <nav t-if="nav['items']" class="mo-nav-menu" aria-label="Sanal POS menüsü">
                <a t-foreach="nav['items']" t-as="item"
                   t-att-class="'mo-nav-link mo-active' if item['active'] else 'mo-nav-link'"
                   t-att-href="item['url']" t-att-aria-current="'true' if item['active'] else None"
                   t-out="item['label']"/>
            </nav>
            <div class="mo-nav-user">
                <span t-if="nav['company_name']" class="mo-nav-company" t-out="nav['company_name']"/>
                <img class="mo-nav-avatar" t-att-src="nav['avatar_url']" width="28" height="28" alt=""/>
                <span t-out="nav['user_name']"/>
            </div>
        </header>
    </template>

    <!-- Herkese açık dönüş sayfası: kullanıcı/şirket bilgisi YOK, yalnız marka çubuğu (satır içi SVG, görsel isteği yok). -->
    <template id="mail_order_brandbar" name="Sanal POS: Mail Order marka çubuğu">
        <header class="mo-navbar">
            <span class="mo-nav-brand">
                <svg class="mo-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" focusable="false" aria-hidden="true">
                    <rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19"/>
                </svg>
                <span>Sanal POS</span>
            </span>
        </header>
    </template>

    <template id="mail_order_breadcrumb" name="Sanal POS: Mail Order breadcrumb">
        <div class="mo-controlpanel">
            <nav class="mo-breadcrumb" aria-label="Sayfa konumu">
                <ol>
                    <li><a t-att-href="crumb_list_url">Ödeme Talepleri</a></li>
                    <li t-if="crumb_record_url"><a t-att-href="crumb_record_url" t-out="crumb_record_label or 'Ödeme kaydı'"/></li>
                    <li aria-current="page" t-out="crumb_current"/>
                </ol>
            </nav>
        </div>
    </template>

    <template id="mail_order_footer" name="Sanal POS: Mail Order alt bilgi">
        <footer class="mo-footer">
            <span t-if="company_name" t-out="company_name"/>
            <span class="mo-trust">
                <svg class="mo-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                    <rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
                </svg>
                Kart bilgisi doğrudan Paratika'ya iletilir, Odoo'da saklanmaz.
            </span>
        </footer>
    </template>

    <template id="mail_order_card_page" name="Sanal POS: Mail Order kart sayfası">
        <html lang="tr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Mail Order: kart bilgisi</title>
                <link rel="stylesheet" t-att-href="css_url"/>
                <!-- Sayfadaki TEK script (K-16): içeriği ve CSP hash'i tools.mail_order_script()'ten gelir.
                     card_script boşsa (kapatma anahtarı / dosya sorunu) sayfa script'siz çalışır. -->
                <script t-if="card_script" t-out="card_script"/>
            </head>
            <body>
                <t t-call="sanal_pos.mail_order_navbar"/>
                <t t-set="crumb_list_url" t-value="nav['list_url']"/>
                <t t-set="crumb_record_url" t-value="record_url"/>
                <t t-set="crumb_record_label" t-value="payment_name"/>
                <t t-set="crumb_current" t-value="'Kart Bilgisi'"/>
                <t t-call="sanal_pos.mail_order_breadcrumb"/>
                <div t-if="is_test" class="mo-test-band">TEST ORTAMI: gerçek tahsilat yapılmaz</div>
                <main class="mo-main">
                    <ol class="mo-steps" aria-label="Ödeme adımları">
                        <li aria-current="step"><span class="mo-step-no">1</span> Kart bilgisi</li>
                        <li><span class="mo-step-no">2</span> Banka SMS doğrulaması</li>
                        <li><span class="mo-step-no">3</span> Sonuç</li>
                    </ol>
                    <div class="mo-title">
                        <h1>Mail Order ile ödeme</h1>
                        <p>Müşterinin telefonla bildirdiği kart bilgisini girin; ödeme banka 3D Secure doğrulamasıyla tamamlanır.</p>
                    </div>
                    <div class="mo-grid">
                        <section class="mo-card mo-card-summary" aria-labelledby="mo-summary-title">
                            <div class="mo-card-head"><h2 id="mo-summary-title">Ödeme özeti</h2></div>
                            <div class="mo-card-body">
                                <p class="mo-amount-label">Ödenecek tutar</p>
                                <p class="mo-amount" id="mo-sum-total" t-out="amount_text"/>
                                <!-- Seçilen taksidin ayrıntısı: script doldurur (yalnız sunucunun hazırladığı metin); tek çekimde gizli. -->
                                <p class="mo-sum-detail" id="mo-sum-detail" hidden="hidden"/>
                                <dl class="mo-summary">
                                    <dt>Fatura</dt><dd t-out="invoice_no"/>
                                    <dt>Müşteri</dt><dd t-out="customer_name"/>
                                    <t t-if="phone_masked"><dt>Telefon</dt><dd t-out="phone_masked"/></t>
                                    <t t-if="email_masked"><dt>E-posta</dt><dd t-out="email_masked"/></t>
                                    <dt>Açıklama</dt><dd t-out="description"/>
                                    <t t-if="creator_name"><dt>Talebi oluşturan</dt><dd t-out="creator_name"/></t>
                                    <!-- NEDEN: QWeb t-att-* 0/False/None değerini hiç basmaz; str() "0" basar (öznitelik yoksa betik kurulmaz). -->
                                    <dt>Son geçerlilik</dt>
                                    <dd>
                                        <span t-out="expires_hm"/> · <span id="mo-remaining" t-att-data-seconds="str(remaining_seconds)" t-out="remaining_text"/>
                                    </dd>
                                </dl>
                                <p class="mo-alert mo-alert-danger" id="mo-expired" role="alert" hidden="hidden">Oturum süresi doldu; kayda dönüp yeni deneme açın.</p>
                                <div class="mo-alert mo-alert-warning" role="note">
                                    <p class="mo-alert-title">
                                        <svg class="mo-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                                            <path d="M12 3.5 2.5 20h19z"/><path d="M12 10v4.5M12 17.5v.01"/>
                                        </svg>
                                        Güvenlik uyarısı
                                    </p>
                                    <ul class="mo-checklist">
                                        <li>Kartı yalnız bu sayfaya girin.</li>
                                        <li>Kart bilgisini not almayın, mesajla/e-postayla almayın.</li>
                                        <li>Tarayıcıya kart kaydettirmeyin.</li>
                                        <li>SMS kodunu yalnız banka sayfasına girin.</li>
                                    </ul>
                                </div>
                            </div>
                        </section>

                        <section class="mo-card mo-card-form" aria-labelledby="mo-card-title">
                            <div class="mo-card-head">
                                <h2 id="mo-card-title">Kart bilgileri</h2>
                                <!-- Marka vurgusu: script data-brand yazar, CSS diğer logoları soluklaştırır. -->
                                <span class="mo-cards" data-brand="" role="group" aria-label="Kabul edilen kartlar">
                                    <img src="/sanal_pos/static/src/img/card-visa.svg" data-brand="visa" width="38" height="24" alt="Visa"/>
                                    <img src="/sanal_pos/static/src/img/card-mastercard.svg" data-brand="mastercard" width="38" height="24" alt="Mastercard"/>
                                    <img src="/sanal_pos/static/src/img/card-troy.svg" data-brand="troy" width="38" height="24" alt="Troy"/>
                                </span>
                            </div>
                            <div class="mo-card-body">
                                <!-- Form doğrudan Paratika'ya gider; Odoo bu alanları hiçbir yolla almaz (K-13). -->
                                <!-- data-now-ym: SKT "bu ay" sınırı (İstanbul, sunucu saati); script istemci saatini kullanmaz. -->
                                <form id="mo-form" class="mo-form" method="post" t-att-action="form_action" autocomplete="off"
                                      t-att-data-now-ym="now_ym" t-att-data-payment-id="payment_id"
                                      t-att-data-bin="'1' if bin_enabled else None">
                                    <div class="mo-field">
                                        <label for="cardOwner">Kart sahibinin adı</label>
                                        <input id="cardOwner" name="cardOwner" class="mo-input" type="text" maxlength="32"
                                               autocomplete="off" autocapitalize="characters" spellcheck="false"
                                               required="required"/>
                                        <p id="cardOwner-error" class="mo-error" role="alert" hidden="hidden"/>
                                    </div>
                                    <div class="mo-field">
                                        <label for="pan">Kart numarası</label>
                                        <!-- Script'siz modda boşluksuz rakam zorunlu; script kurulumu bitince deseni gevşetir (K-16). -->
                                        <input id="pan" name="pan" class="mo-input mo-pan" type="text" inputmode="numeric"
                                               pattern="[0-9]{12,19}" maxlength="19" autocomplete="off"
                                               placeholder="1234567812345678" aria-describedby="pan-hint"
                                               required="required"/>
                                        <p id="pan-hint" class="mo-hint">
                                            <span class="mo-nojs-only">Yalnız rakam, boşluksuz (12-19 hane). Örnek: 1234567812345678</span>
                                            <span class="mo-js-only">Rakamlar otomatik gruplanır (örn. 0000 0000 0000 0000).</span>
                                        </p>
                                        <!-- BIN yuvaları (Aşama 2): boş açılır, betik doldurur; form alanı (name) değildir. -->
                                        <p id="mo-detected" class="mo-detected"/>
                                        <p id="mo-amex" class="mo-alert mo-alert-warning" role="status" hidden="hidden">American Express kabul edilmeyebilir; Visa, Mastercard veya Troy kart kullanın.</p>
                                        <p id="pan-error" class="mo-error" role="alert" hidden="hidden"/>
                                    </div>
                                    <div class="mo-row">
                                        <fieldset class="mo-field mo-field-expiry">
                                            <legend>Son kullanma tarihi</legend>
                                            <div class="mo-expiry">
                                                <div>
                                                    <label class="mo-sr-only" for="expiryMonth">Son kullanma ayı</label>
                                                    <select id="expiryMonth" name="expiryMonth" class="mo-input" autocomplete="off" required="required">
                                                        <option value="">Ay</option>
                                                        <t t-foreach="expiry_months" t-as="month">
                                                            <option t-att-value="month" t-out="month"/>
                                                        </t>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="mo-sr-only" for="expiryYear">Son kullanma yılı</label>
                                                    <select id="expiryYear" name="expiryYear" class="mo-input" autocomplete="off" required="required">
                                                        <option value="">Yıl</option>
                                                        <t t-foreach="expiry_years" t-as="year">
                                                            <option t-att-value="year" t-out="year"/>
                                                        </t>
                                                    </select>
                                                </div>
                                            </div>
                                            <p id="expiry-error" class="mo-error" role="alert" hidden="hidden"/>
                                        </fieldset>
                                        <div class="mo-field mo-field-cvv">
                                            <label for="cvv">Güvenlik kodu (CVV)</label>
                                            <div class="mo-cvv-wrap">
                                                <input id="cvv" name="cvv" class="mo-input" type="password" inputmode="numeric"
                                                       pattern="[0-9]{3,4}" maxlength="4" autocomplete="off"
                                                       aria-describedby="cvv-hint" required="required"/>
                                                <!-- Kartın arkası: imza şeridi ve CVV kutusu (satır içi SVG, görsel isteği yok). -->
                                                <svg class="mo-cvv-icon" width="40" height="26" viewBox="0 0 40 26" fill="none" stroke="currentColor" stroke-width="1.5" focusable="false" aria-hidden="true">
                                                    <rect x="1" y="1" width="38" height="24" rx="3"/>
                                                    <path d="M1 7h38" stroke-width="4"/>
                                                    <rect x="22" y="13" width="13" height="6" rx="1"/>
                                                </svg>
                                            </div>
                                            <p id="cvv-hint" class="mo-hint">Kartın arkasındaki 3 haneli kod.</p>
                                            <p id="cvv-error" class="mo-error" role="alert" hidden="hidden"/>
                                        </div>
                                    </div>
                                    <!-- G0-Q7: tek çekim değeri '1' varsayımı (spike sonrası tek değişim yeri). -->
                                    <fieldset class="mo-field mo-inst">
                                        <legend>Taksit</legend>
                                        <p id="mo-bin-status" class="mo-hint mo-bin-status" aria-live="polite"/>
                                        <div class="mo-inst-list">
                                            <label t-foreach="installment_table['rows']" t-as="row" class="mo-inst-card">
                                                <input type="radio" name="installmentCount" t-att-value="row['count']"
                                                       t-att-checked="'checked' if row['count'] == 1 else None"
                                                       t-att-data-label="row['label']" t-att-data-total="row['total_text']"
                                                       t-att-data-monthly="row['monthly_text']"
                                                       t-att-data-surcharge="row['surcharge_text'] or None"/>
                                                <span class="mo-inst-body">
                                                    <span class="mo-inst-title" t-out="row['label']"/>
                                                    <span t-if="row['count'] == 1" class="mo-inst-amount" t-out="row['total_text']"/>
                                                    <t t-else="">
                                                        <span class="mo-inst-amount"><t t-out="row['monthly_text']"/> / ay</span>
                                                        <span class="mo-inst-total">Toplam <t t-out="row['total_text']"/></span>
                                                    </t>
                                                    <span class="mo-inst-fee">
                                                        <t t-if="row['surcharge_text']"><t t-out="row['rate_text']"/> · <t t-out="row['surcharge_text']"/></t>
                                                        <t t-else="" t-out="row['rate_text']"/>
                                                    </span>
                                                    <span t-if="row['networks']" class="mo-inst-networks" t-out="', '.join(row['networks'])"/>
                                                </span>
                                            </label>
                                        </div>
                                        <p id="mo-inst-note" class="mo-hint mo-inst-note"/>
                                        <p t-if="not installments" class="mo-hint">Taksit seçenekleri alınamadı; tek çekim yapılabilir.</p>
                                        <p t-elif="installment_table['common_networks']" class="mo-hint"
                                           t-out="'Taksit yapılabilen kartlar: %s' % ', '.join(installment_table['common_networks'])"/>
                                        <p class="mo-hint">Kartın desteklemediği taksit banka tarafından reddedilir. Vade farkı çekim tutarına eklenir; kesin tutar banka sayfasında görünür.</p>
                                    </fieldset>
                                    <!-- Script gönderimde beklenmedik hata alırsa (fail-closed, gönderim yok) burada uyarır. -->
                                    <p id="mo-form-error" class="mo-error" role="alert" hidden="hidden"/>
                                    <div class="mo-actions">
                                        <button type="submit" id="mo-pay" class="mo-btn mo-btn-primary">
                                            <svg class="mo-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false" aria-hidden="true">
                                                <rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
                                            </svg>
                                            <span id="mo-pay-text">Öde · 3D Secure</span>
                                        </button>
                                        <a class="mo-btn mo-btn-secondary" t-att-href="record_url">Vazgeç</a>
                                    </div>
                                </form>
                            </div>
                        </section>
                    </div>
                </main>
                <t t-call="sanal_pos.mail_order_footer"><t t-set="company_name" t-value="nav['company_name']"/></t>
            </body>
        </html>
    </template>

    <template id="mail_order_error_page" name="Sanal POS: Mail Order hata sayfası">
        <html lang="tr">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Mail Order: kart sayfası açılamadı</title>
                <link rel="stylesheet" t-att-href="css_url"/>
            </head>
            <body>
                <t t-call="sanal_pos.mail_order_navbar"/>
                <t t-set="crumb_list_url" t-value="nav['list_url']"/>
                <t t-set="crumb_record_url" t-value="payment_url"/>
                <t t-set="crumb_record_label" t-value="None"/>
                <t t-set="crumb_current" t-value="'Kart Bilgisi'"/>
                <t t-call="sanal_pos.mail_order_breadcrumb"/>
                <main class="mo-main">
                    <section class="mo-card mo-narrow" aria-labelledby="mo-error-title">
                        <div class="mo-card-head"><h1 id="mo-error-title">Kart sayfası açılamadı</h1></div>
                        <div class="mo-card-body">
                            <div class="mo-alert mo-alert-danger" role="alert">
                                <p t-out="message"/>
                            </div>
                            <div class="mo-actions">
                                <a class="mo-btn mo-btn-primary" t-att-href="back_url">Geri dön</a>
                            </div>
                        </div>
                    </section>
                </main>
                <t t-call="sanal_pos.mail_order_footer"><t t-set="company_name" t-value="nav['company_name']"/></t>
            </body>
        </html>
    </template>

    <!-- Sonuç sayfası (Aşama 3, KK-3.1-3.6): script YOK (CSP script-src yok), kart verisi YOK (yalnız son 4).
         Tek form ailesi: CSRF'li Tekrar dene / Link gönder POST'ları (CSP form-action 'self'); kart alanı yok.
         Beklemede script'siz <meta refresh> (5 sn, en çok 24 kez ~ 2 dk). -->
    <template id="mail_order_result_page" name="Sanal POS: Mail Order sonuç sayfası">
        <html lang="tr">
            <head>
                <meta charset="utf-8"/>
                <meta t-if="refresh_url" http-equiv="refresh" t-attf-content="5;url={{ refresh_url }}"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Mail Order: ödeme sonucu</title>
                <link rel="stylesheet" t-att-href="css_url"/>
            </head>
            <body>
                <t t-call="sanal_pos.mail_order_navbar"/>
                <t t-set="crumb_list_url" t-value="nav['list_url']"/>
                <t t-set="crumb_record_url" t-value="record_url"/>
                <t t-set="crumb_record_label" t-value="payment_name"/>
                <t t-set="crumb_current" t-value="'Sonuç'"/>
                <t t-call="sanal_pos.mail_order_breadcrumb"/>
                <div t-if="is_test" class="mo-test-band">TEST ORTAMI: gerçek tahsilat yapılmaz</div>
                <main class="mo-main">
                    <ol class="mo-steps" aria-label="Ödeme adımları">
                        <li><span class="mo-step-no">1</span> Kart bilgisi</li>
                        <li><span class="mo-step-no">2</span> Banka SMS doğrulaması</li>
                        <li aria-current="step"><span class="mo-step-no">3</span> Sonuç</li>
                    </ol>
                    <div class="mo-title">
                        <h1>Ödeme sonucu</h1>
                        <p>Fatura <t t-out="invoice_no"/> · <t t-out="customer_name"/></p>
                    </div>
                    <div class="mo-stack mo-result">
                        <div t-if="notice" t-attf-class="mo-alert #{notice_class}" role="alert"><p t-out="notice"/></div>
                        <section class="mo-card" aria-labelledby="mo-result-title">
                            <div class="mo-card-head"><h2 id="mo-result-title">Sonuç</h2></div>
                            <div class="mo-card-body">
                                <t t-if="view == 'paid'">
                                    <div class="mo-alert mo-alert-success" role="status">
                                        <p class="mo-alert-title">Ödeme alındı</p>
                                        <p>Tahsilat banka tarafından onaylandı.</p>
                                    </div>
                                    <dl class="mo-summary">
                                        <dt>Tutar</dt><dd t-out="amount_text"/>
                                        <dt>Taksit</dt>
                                        <dd><t t-if="installments &gt; 1"><t t-out="installments"/> taksit</t><t t-else="">Tek çekim</t></dd>
                                        <dt t-if="card_masked">Kart</dt><dd t-if="card_masked" t-out="card_masked"/>
                                        <dt t-if="tran_ref">İşlem no</dt><dd t-if="tran_ref" t-out="tran_ref"/>
                                        <dt t-if="paid_local">Zaman</dt><dd t-if="paid_local" t-out="paid_local"/>
                                    </dl>
                                </t>
                                <t t-elif="view == 'review'">
                                    <div class="mo-alert mo-alert-warning" role="alert">
                                        <p class="mo-alert-title">Ödeme incelemeye alındı</p>
                                        <p>Banka işlemi bulundu ancak tutar ya da işlem sayısı beklenenle uyuşmuyor. Ayrıntıyı kayıt notunda görün; kayıt incelenene kadar yeni deneme yapmayın.</p>
                                    </div>
                                    <dl class="mo-summary"><dt>Talep tutarı</dt><dd t-out="amount_text"/></dl>
                                </t>
                                <t t-elif="view == 'declined'">
                                    <div class="mo-alert mo-alert-danger" role="alert">
                                        <p class="mo-alert-title">Ödeme reddedildi</p>
                                        <p><t t-out="reason"/><t t-if="code"> (<t t-out="code"/>)</t></p>
                                        <p t-if="advice" class="mo-advice"><t t-out="advice"/></p>
                                    </div>
                                    <p t-if="remaining and not block_message" class="mo-remaining">Kalan deneme: <t t-out="remaining"/></p>
                                </t>
                                <t t-elif="view == 'pending'">
                                    <div class="mo-alert mo-alert-warning" role="status">
                                        <t t-if="not refresh_stopped">
                                            <p class="mo-alert-title">Banka sonucu bekleniyor</p>
                                            <p>Müşteri banka doğrulamasını tamamlıyor olabilir. Sayfa kendiliğinden yenilenir; yeni deneme açmayın.</p>
                                        </t>
                                        <t t-else="">
                                            <p class="mo-alert-title">Sonuç henüz gelmedi</p>
                                            <p>Sonuç henüz gelmedi; kayıttan izleyin (otomatik senkron ≤10 dk). Bu sırada yeni deneme açmayın.</p>
                                        </t>
                                    </div>
                                </t>
                                <t t-elif="view == 'closed'">
                                    <div class="mo-alert mo-alert-warning" role="status">
                                        <p class="mo-alert-title">Mail order oturumu kapalı</p>
                                        <p>Bu kayıt için kart oturumu sona erdi ya da hata verdi; ödeme alınmadı.</p>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="mo-alert mo-alert-warning" role="status">
                                        <p class="mo-alert-title">Kayıt durumu: <t t-out="state_label"/></p>
                                        <p>Ayrıntı için kayda gidin.</p>
                                    </div>
                                </t>
                                <div t-if="block_message" class="mo-alert mo-alert-warning" role="alert"><p t-out="block_message"/></div>
                                <div class="mo-actions">
                                    <form t-if="retry_label" method="post" t-att-action="retry_action" class="mo-form-inline">
                                        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                        <button type="submit" class="mo-btn mo-btn-primary" t-out="retry_label"/>
                                    </form>
                                    <form t-if="show_link" method="post" t-att-action="link_action" class="mo-form-inline">
                                        <input type="hidden" name="csrf_token" t-att-value="csrf_token"/>
                                        <button type="submit" class="mo-btn mo-btn-secondary">Bunun yerine link gönder</button>
                                    </form>
                                    <p t-if="link_wait" class="mo-note" t-out="link_wait"/>
                                    <a t-if="view == 'pending' and refresh_stopped" class="mo-btn mo-btn-secondary" t-att-href="result_url">Yeniden denetle</a>
                                    <a class="mo-btn mo-btn-secondary" t-att-href="record_url">Kayda git</a>
                                </div>
                            </div>
                        </section>
                        <section t-if="history" class="mo-card" aria-labelledby="mo-history-title">
                            <div class="mo-card-head"><h2 id="mo-history-title">Deneme geçmişi</h2></div>
                            <div class="mo-card-body mo-table-wrap">
                                <table class="mo-table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Zaman</th><th scope="col">Sonuç</th><th scope="col">Neden</th>
                                            <th scope="col">Taksit</th><th scope="col">Kart</th><th scope="col">Başlatan</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="history" t-as="row" t-att-class="'mo-row-' + row['status']">
                                            <td t-out="row['time']"/>
                                            <td><span class="mo-badge" t-out="row['label']"/></td>
                                            <td t-out="row['detail'] or '-'"/>
                                            <td><t t-if="row['installments'] &gt; 1"><t t-out="row['installments']"/> taksit</t><t t-else="">Tek çekim</t></td>
                                            <td><t t-if="row['last4']">**** <t t-out="row['last4']"/></t><t t-else="">-</t></td>
                                            <td t-out="row['user'] or '-'"/>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </section>
                    </div>
                </main>
                <t t-call="sanal_pos.mail_order_footer"><t t-set="company_name" t-value="nav['company_name']"/></t>
            </body>
        </html>
    </template>

    <!-- mo_return (public): sabit metin + Odoo kökenli geçiş; target yalnız MPID_RE'ye uyan değer.
         Kullanıcı/şirket bilgisi ve görsel isteği YOK (CSP bu sayfada img-src içermez). -->
    <template id="mail_order_return_page" name="Sanal POS: Mail Order dönüş sayfası">
        <html lang="tr">
            <head>
                <meta charset="utf-8"/>
                <meta http-equiv="refresh" t-attf-content="0;url={{ target }}"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title>Ödeme sonucu alınıyor</title>
                <link rel="stylesheet" t-att-href="css_url"/>
            </head>
            <body>
                <t t-call="sanal_pos.mail_order_brandbar"/>
                <main class="mo-main">
                    <section class="mo-card mo-narrow mo-center" aria-live="polite">
                        <div class="mo-card-body">
                            <div class="mo-spinner" aria-hidden="true"/>
                            <h1>Ödeme sonucu alınıyor…</h1>
                            <p class="mo-note">Banka doğrulaması tamamlandı; sonuç Odoo'da sorgulanıyor.</p>
                            <p><a t-att-href="target">Sayfa açılmazsa buraya tıklayın</a></p>
                        </div>
                    </section>
                </main>
                <t t-call="sanal_pos.mail_order_footer"/>
            </body>
        </html>
    </template>
</odoo>
