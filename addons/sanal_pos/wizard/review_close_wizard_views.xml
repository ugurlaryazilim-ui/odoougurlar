<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- İncelemeyi kapat (yönetici): not zorunlu, chatter'a yazılır (G8 Risk 3). -->
    <record id="view_sanal_pos_payment_review_close_wizard_form" model="ir.ui.view">
        <field name="name">sanal.pos.payment.review.close.wizard.form</field>
        <field name="model">sanal.pos.payment.review.close.wizard</field>
        <field name="arch" type="xml">
            <form string="İncelemeyi Kapat">
                <div class="alert alert-warning" role="alert">
                    Kayıt "Hata" durumuna alınır ve fatura için yeni link açılabilir. Paratika'da
                    tahsil edilmiş bir tutar varsa önce panelden kontrol edin.
                </div>
                <group>
                    <field name="payment_id"/>
                    <field name="reason" placeholder="Kapatma nedeni (zorunlu)"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Kapat" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
