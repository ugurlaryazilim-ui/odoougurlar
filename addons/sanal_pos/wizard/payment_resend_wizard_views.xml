<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Linki yeniden gönder (KK-31): kanal seçimi; gönderim sunucuda action_resend ile yapılır. -->
    <record id="view_sanal_pos_payment_resend_wizard_form" model="ir.ui.view">
        <field name="name">sanal.pos.payment.resend.wizard.form</field>
        <field name="model">sanal.pos.payment.resend.wizard</field>
        <field name="arch" type="xml">
            <form string="Linki Yeniden Gönder">
                <field name="is_test" invisible="1"/>
                <div class="alert alert-danger text-center fw-bold" role="alert"
                     invisible="not is_test">
                    TEST ORTAMI – gerçek tahsilat yapılmaz
                </div>
                <group>
                    <field name="payment_id"/>
                    <field name="channel_sms"/>
                    <field name="channel_email"/>
                    <field name="customer_phone"/>
                    <field name="customer_email"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Gönder" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
