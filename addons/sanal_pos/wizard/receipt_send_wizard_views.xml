<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Dekontu gönder (KK-4.4): adres sorulur; gönderim sunucuda _send_receipt_manual ile yapılır.
         Adres kayıttakinden farklıysa kayda not düşer; ödeme kaydındaki e-posta DEĞİŞMEZ. -->
    <record id="view_sanal_pos_receipt_send_wizard_form" model="ir.ui.view">
        <field name="name">sanal.pos.receipt.send.wizard.form</field>
        <field name="model">sanal.pos.receipt.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Dekontu Gönder">
                <group>
                    <field name="payment_id"/>
                    <field name="record_email"/>
                    <field name="email" required="1"/>
                </group>
                <p class="text-muted">
                    Dekont PDF'i bu adrese e-posta kuyruğundan gider. Farklı bir adres yazarsanız kayda not
                    düşer; kayıttaki müşteri e-postası değişmez.
                </p>
                <footer>
                    <button name="action_send" type="object" string="Gönder" class="btn-primary"/>
                    <button string="Vazgeç" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
