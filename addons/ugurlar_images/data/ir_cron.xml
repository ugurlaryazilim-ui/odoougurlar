<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_fix_existing_images" model="ir.cron">
            <field name="name">Görsel Boyutlandırma Onarımı (Arka Plan)</field>
            <field name="model_id" ref="model_image_fix_job"/>
            <field name="state">code</field>
            <field name="code">model._cron_fix_images()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">False</field>
        </record>

        <!-- K6: eski görsel senkron loglarını sil (ayar: ugurlar_images.log_retention_days, varsayılan 180; 0 = kapalı) -->
        <record id="ir_cron_image_sync_log_gc" model="ir.cron">
            <field name="name">Görsel Senkron: Eski Logları Temizle</field>
            <field name="model_id" ref="model_ugurlar_image_sync_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc_old_logs()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
