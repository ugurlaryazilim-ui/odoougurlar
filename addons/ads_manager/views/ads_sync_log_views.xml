<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ads_sync_log_list" model="ir.ui.view">
        <field name="name">ads.sync.log.list</field>
        <field name="model">ads.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs">
                <field name="sync_date"/>
                <field name="account_id"/>
                <field name="sync_type"/>
                <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'" decoration-warning="status == 'partial'"/>
                <field name="message" string="Message"/> <!-- assuming text is truncated in list view generally, or custom widget needed -->
                <field name="records_created"/>
                <field name="records_updated"/>
                <field name="duration_seconds"/>
            </list>
        </field>
    </record>

    <record id="view_ads_sync_log_search" model="ir.ui.view">
        <field name="name">ads.sync.log.search</field>
        <field name="model">ads.sync.log</field>
        <field name="arch" type="xml">
            <search string="Sync Logs">
                <field name="account_id"/>
                <field name="status"/>
                <field name="sync_date"/>
                <filter string="Success" name="filter_success" domain="[('status', '=', 'success')]"/>
                <filter string="Error" name="filter_error" domain="[('status', '=', 'error')]"/>
                <filter string="Partial" name="filter_partial" domain="[('status', '=', 'partial')]"/>
                <group expand="0" string="Group By">
                    <filter string="Account" name="group_by_account" context="{'group_by': 'account_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'sync_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ads_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">ads.sync.log</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_ads_sync_log_search"/>
    </record>
</odoo>
