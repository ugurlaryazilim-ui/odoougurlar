<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ads_rule_form" model="ir.ui.view">
        <field name="name">ads.rule.form</field>
        <field name="model">ads.rule</field>
        <field name="arch" type="xml">
            <form string="Ads Rule">
                <header>
                    <button name="action_evaluate_now" string="Şimdi Değerlendir" type="object" class="oe_highlight" icon="fa-play"/>
                    <button name="action_reset_cooldown" string="Cooldown Sıfırla" type="object" invisible="not is_in_cooldown" icon="fa-refresh"/>
                    <field name="is_in_cooldown" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Rule Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="severity" widget="badge"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="platform_filter"/>
                            <field name="campaign_ids" widget="many2many_tags"/>
                            <field name="condition_logic"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Conditions" name="conditions">
                            <field name="condition_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <!-- Add other fields as needed based on the model -->
                                </list>
                            </field>
                        </page>
                        <page string="Actions" name="actions">
                            <field name="action_ids">
                                <list editable="bottom">
                                    <field name="action_type"/>
                                    <field name="adjustment_value" invisible="action_type != 'adjust_budget_pct'"/>
                                    <field name="max_single_adjustment" invisible="action_type != 'adjust_budget_pct'"/>
                                    <field name="require_approval"/>
                                </list>
                            </field>
                        </page>
                        <page string="Safeguards" name="safeguards">
                            <group>
                                <field name="min_impressions"/>
                                <field name="cooldown_hours"/>
                                <field name="last_triggered" readonly="1"/>
                                <field name="trigger_count" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ads_rule_list" model="ir.ui.view">
        <field name="name">ads.rule.list</field>
        <field name="model">ads.rule</field>
        <field name="arch" type="xml">
            <list string="Ads Rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="severity" widget="badge" decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'" decoration-info="severity == 'info'"/>
                <field name="category"/>
                <field name="platform_filter"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="trigger_count"/>
                <field name="last_triggered"/>
            </list>
        </field>
    </record>

    <record id="action_ads_rule" model="ir.actions.act_window">
        <field name="name">Ads Rules</field>
        <field name="res_model">ads.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
