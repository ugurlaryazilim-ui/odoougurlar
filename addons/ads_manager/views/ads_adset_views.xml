<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ad Sets List View -->
    <record id="view_ads_adset_list" model="ir.ui.view">
        <field name="name">ads.adset.list</field>
        <field name="model">ads.adset</field>
        <field name="arch" type="xml">
            <list string="Ad Sets">
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="account_id"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-muted="status == 'paused'"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="daily_budget" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="lifetime_budget" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </list>
        </field>
    </record>

    <!-- Ad Sets Form View -->
    <record id="view_ads_adset_form" model="ir.ui.view">
        <field name="name">ads.adset.form</field>
        <field name="model">ads.adset</field>
        <field name="arch" type="xml">
            <form string="Ad Set">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ad Set Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Campaign &amp; Platform">
                            <field name="campaign_id"/>
                            <field name="account_id"/>
                            <field name="platform_adset_id"/>
                            <field name="status"/>
                        </group>
                        <group string="Budget &amp; Targeting">
                            <field name="currency_id" invisible="1"/>
                            <field name="daily_budget" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="lifetime_budget" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="targeting_summary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ads" name="ads">
                            <field name="ad_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="status" widget="badge" decoration-success="status == 'active'" decoration-muted="status == 'paused'"/>
                                    <field name="ad_type"/>
                                    <field name="preview_url" widget="url"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Ad Sets Search View -->
    <record id="view_ads_adset_search" model="ir.ui.view">
        <field name="name">ads.adset.search</field>
        <field name="model">ads.adset</field>
        <field name="arch" type="xml">
            <search string="Ad Sets">
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="account_id"/>
                <filter string="Active" name="filter_active" domain="[('status', '=', 'active')]"/>
                <filter string="Paused" name="filter_paused" domain="[('status', '=', 'paused')]"/>
                <separator/>
                <filter string="Campaign" name="group_by_campaign" context="{'group_by': 'campaign_id'}"/>
                <filter string="Account" name="group_by_account" context="{'group_by': 'account_id'}"/>
                <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>
</odoo>
