<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ads" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ads.manager</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Ads Manager" string="Ads Manager" name="ads_manager" data-key="ads_manager" groups="ads_manager.group_ads_manager">
                    <h2>AI Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Default AI Provider</span>
                                <div class="text-muted">Select the default AI provider for recommendations</div>
                                <field name="ads_default_ai_provider"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Gemini API Key</span>
                                <field name="ads_gemini_api_key" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">OpenAI API Key</span>
                                <field name="ads_openai_api_key" password="True"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Claude API Key</span>
                                <field name="ads_claude_api_key" password="True"/>
                            </div>
                        </div>
                    </div>

                    <h2>Sync Settings</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Default Platform</span>
                                <field name="ads_default_platform"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="ads_auto_sync"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="ads_auto_sync"/>
                                <div class="text-muted">Automatically sync metrics</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Sync Hour (0-23)</span>
                                <field name="ads_sync_hour"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Rule Evaluation Interval</span>
                                <field name="ads_rule_evaluation_interval"/>
                            </div>
                        </div>
                    </div>

                    <h2>Data Management</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Archive After (Months)</span>
                                <field name="ads_archive_after_months"/>
                            </div>
                        </div>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ads_manager_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">main</field>
        <field name="context">{'module' : 'ads_manager'}</field>
    </record>
</odoo>
