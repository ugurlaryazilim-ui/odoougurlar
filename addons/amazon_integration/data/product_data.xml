<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Varsayılan fallback ürün: Ürün eşleşmesi başarısız olduğunda kullanılır.
             Storable product olması zorunlu — picking (teslimat) oluşması için gerekli. -->
        <record id="product_amazon_unknown" model="product.product">
            <field name="name">Amazon Ürünü (Eşleştirilmemiş)</field>
            <field name="default_code">AMAZON-UNKNOWN</field>
            <field name="type">consu</field>
            <field name="is_storable" eval="True"/>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="list_price">0</field>
            <field name="standard_price">0</field>
            <field name="tracking">none</field>
        </record>
    </data>
</odoo>
