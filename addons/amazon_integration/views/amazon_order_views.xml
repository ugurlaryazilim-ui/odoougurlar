<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Amazon Order List View -->
        <record id="view_amazon_order_list" model="ir.ui.view">
            <field name="name">amazon.order.list</field>
            <field name="model">amazon.order</field>
            <field name="arch" type="xml">
                <list string="Amazon Siparişleri" create="false" edit="false">
                    <field name="amazon_order_number"/>
                    <field name="store_name"/>
                    <field name="order_date"/>
                    <field name="status_display" widget="badge"
                           decoration-info="order_status in ('Pending', 'Unshipped')"
                           decoration-success="order_status == 'Shipped'"
                           decoration-danger="order_status == 'Canceled'"/>
                    <field name="fulfillment_channel"/>
                    <field name="customer_name"/>
                    <field name="total_price" sum="Toplam Tutar"/>
                    <field name="currency"/>
                    <field name="sale_order_id"/>
                </list>
            </field>
        </record>

        <!-- Amazon Order Form View -->
        <record id="view_amazon_order_form" model="ir.ui.view">
            <field name="name">amazon.order.form</field>
            <field name="model">amazon.order</field>
            <field name="arch" type="xml">
                <form string="Amazon Siparişi" create="false">
                    <header>
                        <button name="action_refetch_from_amazon"
                                string="Amazon'dan Bilgileri Yenile"
                                type="object"
                                class="btn-primary"
                                icon="fa-refresh"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="amazon_order_number" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Sipariş Bilgileri">
                                <field name="store_id" readonly="1"/>
                                <field name="order_date" readonly="1"/>
                                <field name="order_status" readonly="1"/>
                                <field name="status_display" readonly="1"/>
                                <field name="fulfillment_channel" readonly="1"/>
                                <field name="sale_order_id" readonly="1"/>
                            </group>
                            <group string="Müşteri ve Adres Bilgileri">
                                <field name="customer_name" readonly="1"/>
                                <field name="customer_email" readonly="1"/>
                                <field name="customer_phone" readonly="1"/>
                                <field name="shipping_address" readonly="1"/>
                                <field name="shipping_city" readonly="1"/>
                                <field name="shipping_district" readonly="1"/>
                                <field name="postal_code" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Finansal &amp; Kargo">
                                <field name="total_price" readonly="1"/>
                                <field name="currency" readonly="1"/>
                                <field name="cargo_provider" readonly="1"/>
                                <field name="cargo_tracking_number" readonly="1"/>
                                <field name="easyship_tracking_id" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Sipariş Satırları" name="order_lines">
                                <field name="line_ids" readonly="1">
                                    <list string="Kalemler">
                                        <field name="sku"/>
                                        <field name="asin"/>
                                        <field name="product_name"/>
                                        <field name="quantity"/>
                                        <field name="price"/>
                                        <field name="item_tax"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Raw JSON Payload" name="raw_json">
                                <field name="raw_payload" widget="text" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Amazon Order Search View -->
        <record id="view_amazon_order_search" model="ir.ui.view">
            <field name="name">amazon.order.search</field>
            <field name="model">amazon.order</field>
            <field name="arch" type="xml">
                <search>
                    <field name="amazon_order_number"/>
                    <field name="customer_name"/>
                    <field name="store_id"/>
                    <field name="sale_order_id"/>
                    <filter string="Kargolanacak (Unshipped)" name="unshipped" domain="[('order_status', '=', 'Unshipped')]"/>
                    <filter string="Kargolandı (Shipped)" name="shipped" domain="[('order_status', '=', 'Shipped')]"/>
                    <filter string="İptal Edilenler" name="canceled" domain="[('order_status', '=', 'Canceled')]"/>
                    <separator/>
                    <group>
                        <filter string="Mağaza" name="group_store" context="{'group_by': 'store_id'}"/>
                        <filter string="Durum" name="group_status" context="{'group_by': 'order_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_amazon_order" model="ir.actions.act_window">
            <field name="name">Amazon Siparişleri</field>
            <field name="res_model">amazon.order</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_amazon_order_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Henüz Amazon siparişi bulunamadı.
                </p>
                <p>
                    Mağazalar bölümünden senkronizasyonu çalıştırarak siparişleri çekebilirsiniz.
                </p>
            </field>
        </record>

    </data>
</odoo>
