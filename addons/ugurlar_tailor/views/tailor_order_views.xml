<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ═══════════════ Order List View ═══════════════ -->
    <record id="view_tailor_order_list" model="ir.ui.view">
        <field name="name">ugurlar.tailor.order.list</field>
        <field name="model">ugurlar.tailor.order</field>
        <field name="arch" type="xml">
            <list decoration-bf="is_overdue" decoration-info="state == 'pending'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'" decoration-muted="state == 'delivered'" decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="invoice_no"/>
                <field name="is_reyon" optional="show" string="Reyon"/>
                <field name="product_name"/>
                <field name="customer_name"/>
                <field name="tailor_id"/>
                <field name="total_price" sum="Toplam"/>
                <field name="promised_date" optional="show"/>
                <field name="is_overdue" column_invisible="True"/>
                <field name="state" widget="badge" decoration-danger="state == 'waiting_approval'" decoration-info="state == 'pending'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'" decoration-muted="state == 'delivered'"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════ Order Form View ═══════════════ -->
    <record id="view_tailor_order_form" model="ir.ui.view">
        <field name="name">ugurlar.tailor.order.form</field>
        <field name="model">ugurlar.tailor.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve_reyon" string="Onayla" type="object" class="btn-success" invisible="state != 'waiting_approval'"/>
                    <button name="action_reject_reyon" string="Reddet" type="object" class="btn-danger" invisible="state != 'waiting_approval'" confirm="Reyon siparişi reddedilip iptal edilecek. Emin misiniz?"/>
                    <button name="action_send_to_tailor" string="Terziye Gönder" type="object" class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_mark_completed" string="Hazır" type="object" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_mark_delivered" string="Teslim Edildi" type="object" class="btn-primary" invisible="state != 'completed'"/>
                    <button name="action_cancel" string="İptal Et" type="object" class="btn-danger" invisible="state in ('delivered', 'cancelled')" confirm="Bu siparişi iptal etmek istediğinize emin misiniz?"/>
                    <button name="action_reset_to_pending" string="Sıfırla" type="object" class="btn-secondary" invisible="state in ('pending', 'waiting_approval', 'delivered')"/>
                    <button name="action_send_sms" string="SMS Gönder" type="object" icon="fa-comment"
                            invisible="state in ('waiting_approval', 'cancelled')"/>
                    <button name="action_print_label" string="Etiket Yazdır" type="object" class="btn-warning" icon="fa-print" invisible="state in ('waiting_approval', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="waiting_approval,pending,in_progress,completed,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_reyon"/>
                            <field name="invoice_no" invisible="is_reyon"/>
                            <field name="product_barcode"/>
                            <field name="product_code"/>
                            <field name="product_name"/>
                        </group>
                        <group>
                            <field name="customer_name"/>
                            <field name="customer_phone"/>
                            <field name="customer_mobile" widget="phone"/>
                            <field name="sales_person"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="tailor_id"/>
                            <field name="promised_date"/>
                            <field name="is_overdue" invisible="not is_overdue" widget="boolean_toggle" readonly="1"/>
                            <field name="ready_sms_sent" invisible="not ready_sms_sent"/>
                            <field name="reminder_count" invisible="not reminder_count"/>
                        </group>
                        <group>
                            <field name="completed_at"/>
                            <field name="delivered_at"/>
                            <field name="cancelled_at" invisible="state != 'cancelled'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Hizmetler" name="services">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="service_id"/>
                                    <field name="price"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_price" class="oe_subtotal_footer_separator"/>
                            </group>
                        </page>
                        <page string="Notlar" name="notes">
                            <field name="notes" placeholder="Sipariş hakkında notlar..."/>
                        </page>
                        <page string="Fotoğraf" name="photo">
                            <field name="photo" widget="image" options="{'size': [400, 400]}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════ Order Search View ═══════════════ -->
    <record id="view_tailor_order_search" model="ir.ui.view">
        <field name="name">ugurlar.tailor.order.search</field>
        <field name="model">ugurlar.tailor.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="invoice_no"/>
                <field name="customer_name"/>
                <field name="tailor_id"/>
                <field name="product_barcode"/>
                <filter string="Geciken" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Onay Bekleyen" name="waiting_approval" domain="[('state', '=', 'waiting_approval')]"/>
                <filter string="Bekliyor" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Terzide" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Hazır" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Teslim" name="delivered" domain="[('state', '=', 'delivered')]"/>
                <filter string="İptal" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Reyon" name="reyon" domain="[('is_reyon', '=', True)]"/>
                <filter string="Faturalı" name="invoiced" domain="[('is_reyon', '=', False)]"/>
                <separator/>
                <filter string="Tarih" name="filter_create_date" date="create_date"/>
                <group>
                    <filter string="Terzi" name="group_tailor" context="{'group_by': 'tailor_id'}"/>
                    <filter string="Durum" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Gün" name="group_day" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════ Order Action ═══════════════ -->
    <record id="action_tailor_order" model="ir.actions.act_window">
        <field name="name">Siparişler</field>
        <field name="res_model">ugurlar.tailor.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
    </record>

    <!-- ═══════════════ Kanban (duruma göre sütunlar) ═══════════════ -->
    <record id="view_tailor_order_kanban" model="ir.ui.view">
        <field name="name">ugurlar.tailor.order.kanban</field>
        <field name="model">ugurlar.tailor.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="0">
                <field name="state"/>
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <span t-if="record.is_overdue.raw_value" class="badge text-bg-danger">Gecikti</span>
                        </div>
                        <field name="customer_name"/>
                        <field name="product_name" class="text-muted small"/>
                        <div class="d-flex justify-content-between mt-1">
                            <field name="tailor_id"/>
                            <field name="total_price" widget="monetary" options="{'currency_field': False}"/>
                        </div>
                        <field name="promised_date" class="small"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ═══════════════ Terzi Hakediş (pivot / grafik) ═══════════════ -->
    <record id="view_tailor_order_pivot" model="ir.ui.view">
        <field name="name">ugurlar.tailor.order.pivot</field>
        <field name="model">ugurlar.tailor.order</field>
        <field name="arch" type="xml">
            <pivot string="Terzi Hakediş" sample="1">
                <field name="tailor_id" type="row"/>
                <field name="delivered_at" interval="month" type="col"/>
                <field name="total_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_tailor_order_graph" model="ir.ui.view">
        <field name="name">ugurlar.tailor.order.graph</field>
        <field name="model">ugurlar.tailor.order</field>
        <field name="arch" type="xml">
            <graph string="Terzi Hakediş" type="bar" sample="1">
                <field name="tailor_id"/>
                <field name="total_price" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_tailor_settlement" model="ir.actions.act_window">
        <field name="name">Terzi Hakediş</field>
        <field name="res_model">ugurlar.tailor.order</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_delivered': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Teslim edilmiş terzi siparişi yok</p>
            <p>Teslim edilen siparişlerin terzi bazında toplamı. Tarih filtresiyle dönem seçip Excel'e aktarabilirsiniz.</p>
        </field>
    </record>

    <!-- ═══════════════ Toplu İptal Server Action ═══════════════ -->
    <record id="action_tailor_order_cancel" model="ir.actions.server">
        <field name="name">İptal Et</field>
        <field name="model_id" ref="model_ugurlar_tailor_order"/>
        <field name="binding_model_id" ref="model_ugurlar_tailor_order"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    records.filtered(lambda r: r.state not in ('delivered', 'cancelled')).action_cancel()
        </field>
    </record>
</odoo>
