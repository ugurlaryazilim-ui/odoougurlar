<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_tailor_settings" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.ugurlar.tailor</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Terzi Takip" string="Terzi Takip" name="ugurlar_tailor" groups="base.group_system">
                        <block title="Nebim MSSQL Bağlantı Ayarları" name="tailor_mssql_settings">
                            <setting string="SQL Server Adresi" help="Nebim SQL Server IP veya hostname">
                                <div class="content-group">
                                    <field name="tailor_mssql_server" placeholder="192.168.0.10"/>
                                </div>
                            </setting>
                            <setting string="SQL Port" help="SQL Server port numarasi">
                                <div class="content-group">
                                    <field name="tailor_mssql_port"/>
                                </div>
                            </setting>
                            <setting string="SQL Veritabanı" help="Nebim veritabanı adı">
                                <div class="content-group">
                                    <field name="tailor_mssql_database" placeholder="UGURLAR"/>
                                </div>
                            </setting>
                            <setting string="View / Tablo Adı" help="Fatura verilerinin cekilecegi view adı">
                                <div class="content-group">
                                    <field name="tailor_mssql_view_name" placeholder="dbo.vw_TerziFaturalar"/>
                                </div>
                            </setting>
                            <setting string="SQL Kullanıcı Adı" help="SQL Server kullanıcı adı">
                                <div class="content-group">
                                    <field name="tailor_mssql_user" placeholder="nebim_okuma"/>
                                </div>
                            </setting>
                            <setting string="SQL Şifre" help="SQL Server şifresi">
                                <div class="content-group">
                                    <field name="tailor_mssql_password" password="True"/>
                                </div>
                            </setting>
                        </block>

                        <block title="Sipariş ve Bildirim" name="tailor_order_settings">
                            <setting string="Varsayılan Teslim Süresi" help="Yeni siparişte söz verilen teslim tarihi bugünden bu kadar gün sonrası olur">
                                <div class="content-group">
                                    <field name="tailor_default_days"/> gün
                                </div>
                            </setting>
                            <setting help="Sipariş 'Hazır' olunca müşterinin cep telefonuna SMS gider (Odoo SMS / IAP kredisi gerekir)">
                                <field name="tailor_sms_ready_enabled"/>
                                <div class="text-muted" invisible="not tailor_sms_ready_enabled">
                                    Metin: SMS &gt; Şablonlar &gt; "Terzi - Sipariş Hazır"
                                </div>
                            </setting>
                            <setting help="Hazır olup teslim alınmayan siparişlere hatırlatma SMS'i (metin: SMS &gt; Şablonlar &gt; Terzi - Hatırlatma)">
                                <field name="tailor_sms_reminder_enabled"/>
                                <div class="content-group" invisible="not tailor_sms_reminder_enabled">
                                    <div><field name="tailor_sms_reminder_days" class="oe_inline"/> gün sonra, en fazla
                                        <field name="tailor_sms_reminder_max" class="oe_inline"/> kez</div>
                                </div>
                            </setting>
                        </block>

                        <block title="Reyon Ayarları" name="tailor_reyon_settings">
                            <setting string="Reyon Yöneticileri" help="Reyon işlemi onayı bildirimlerinin gideceği yöneticiler">
                                <div class="content-group">
                                    <field name="reyon_manager_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </div>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
