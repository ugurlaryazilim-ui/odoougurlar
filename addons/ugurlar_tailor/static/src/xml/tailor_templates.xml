<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Root Action -->
    <t t-name="ugurlar_tailor.TailorAction">
        <div class="tailor-app">
            <TailorMainMenu t-if="state.screen === 'main_menu'" onNavigate.bind="switchScreen"/>
            <TailorNewOrder t-if="state.screen === 'new_order'" onNavigate.bind="switchScreen" scanner="scanner"/>
            <TailorOrderList t-if="state.screen === 'order_list'" onNavigate.bind="switchScreen" scanner="scanner"
                             initialStatus="state.listStatus"/>
            <TailorGiftLabel t-if="state.screen === 'gift_label'" onNavigate.bind="switchScreen" scanner="scanner"/>
            <TailorStoreItem t-if="state.screen === 'store_item'" onNavigate.bind="switchScreen" scanner="scanner"/>
            <TailorBulk t-if="state.screen === 'bulk'" onNavigate.bind="switchScreen" scanner="scanner"/>
        </div>
    </t>

    <!-- Main Menu -->
    <t t-name="ugurlar_tailor.TailorMainMenu">
        <div class="tailor-screen tailor-main-menu">
            <div class="tailor-header">
                <h1>Terzi Takip</h1>
                <p class="tailor-subtitle">Mağaza Terzi Yönetim Sistemi</p>
            </div>
            <div class="tailor-stats">
                <div class="tailor-stat" t-on-click="() =&gt; this.openList('waiting_approval')"><b t-esc="stats.waiting_approval"/><span>Onay</span></div>
                <div class="tailor-stat" t-on-click="() =&gt; this.openList('pending')"><b t-esc="stats.pending"/><span>Bekliyor</span></div>
                <div class="tailor-stat" t-on-click="() =&gt; this.openList('in_progress')"><b t-esc="stats.in_progress"/><span>Terzide</span></div>
                <div class="tailor-stat" t-on-click="() =&gt; this.openList('completed')"><b t-esc="stats.completed"/><span>Hazır</span></div>
                <div t-att-class="'tailor-stat' + (stats.overdue ? ' tailor-stat-danger' : '')" t-on-click="() =&gt; this.openList('overdue')"><b t-esc="stats.overdue"/><span>Geciken</span></div>
            </div>
            <div class="tailor-menu-grid">
                <div class="tailor-menu-card tailor-card-primary" t-on-click="onNewOrder">
                    <div class="tailor-card-icon">+</div>
                    <div class="tailor-card-title">Yeni Sipariş</div>
                    <div class="tailor-card-desc">Fatura arayın ve terzi siparişi oluşturun</div>
                </div>
                <div class="tailor-menu-card tailor-card-secondary" t-on-click="onOrderList">
                    <div class="tailor-card-icon">&#128230;</div>
                    <div class="tailor-card-title">Sipariş Listesi</div>
                    <div class="tailor-card-desc">Tüm siparişleri görüntüleyin ve yönetin</div>
                </div>
                <div class="tailor-menu-card tailor-card-gift" t-on-click="onGiftLabel">
                    <div class="tailor-card-icon">&#127873;</div>
                    <div class="tailor-card-title">Hediye Etiketi</div>
                    <div class="tailor-card-desc">Hediye fişi yazdırın</div>
                </div>
                <div class="tailor-menu-card tailor-card-bulk" t-on-click="onBulk">
                    <div class="tailor-card-icon">&#128230;&#8644;</div>
                    <div class="tailor-card-title">Toplu İşlem</div>
                    <div class="tailor-card-desc">Barkod okutarak terziye gönder / hazır / teslim</div>
                </div>
                <div class="tailor-menu-card tailor-card-reyon" t-on-click="onStoreItem">
                    <div class="tailor-card-icon">&#128717;</div>
                    <div class="tailor-card-title">Reyon</div>
                    <div class="tailor-card-desc">Mağaza içi ürünleri faturasız işleyin</div>
                </div>
            </div>
        </div>
    </t>

    <!-- New Order -->
    <t t-name="ugurlar_tailor.TailorNewOrder">
        <div class="tailor-screen tailor-new-order">
            <div class="tailor-toolbar">
                <button class="tailor-btn tailor-btn-back" t-on-click="goBack">&#8592; Geri</button>
                <h2 t-if="state.step === 1">Fatura Ara</h2>
                <h2 t-if="state.step === 2">Ürün ve Hizmet Seç</h2>
                <h2 t-if="state.step === 3">Sipariş Oluşturuldu</h2>

                <!-- Step Indicator -->
                <div class="tailor-step-indicator" t-if="state.step &lt;= 2">
                    <div t-att-class="'tailor-step-dot ' + (state.step === 1 ? 'active' : 'completed')"/>
                    <div t-att-class="'tailor-step-line ' + (state.step >= 2 ? 'completed' : '')"/>
                    <div t-att-class="'tailor-step-dot ' + (state.step === 2 ? 'active' : '')"/>
                </div>
            </div>

            <!-- Step 1: Fatura Arama -->
            <div t-if="state.step === 1" class="tailor-step">
                <div class="tailor-search-box">
                    <input type="text" class="tailor-input tailor-barcode-input"
                           placeholder="Fatura no veya barkod..."
                           t-model="state.searchQuery"
                           t-on-keydown="onSearchKeydown"
                           t-ref="searchInput"/>
                    <button class="tailor-btn tailor-btn-camera"
                            t-on-click="scanCamera" title="Kamera ile Barkod Okut">
                        <i class="fa fa-barcode"/>
                    </button>
                    <button class="tailor-btn tailor-btn-primary" t-on-click="searchInvoice"
                            t-att-disabled="state.searching">
                        <t t-if="state.searching"><span class="tailor-spinner"/> </t>
                        <t t-if="!state.searching">Ara</t>
                    </button>
                </div>
                <div t-if="state.invoices.length &gt; 1" class="tailor-invoice-list">
                    <t t-foreach="state.invoices" t-as="inv" t-key="inv.invoice_no">
                        <div class="tailor-invoice-card" t-on-click="() =&gt; this.selectInvoice(inv.invoice_no)">
                            <strong t-esc="inv.invoice_no"/>
                            <span class="tailor-invoice-meta">
                                <t t-esc="inv.customer_name"/> - <t t-esc="inv.sales_person || '-'"/>
                            </span>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Step 2: Urun + Hizmet Secimi -->
            <div t-if="state.step === 2" class="tailor-step">
                <div class="tailor-invoice-info">
                    <div class="tailor-info-row">
                        <span class="tailor-info-label">Fatura:</span>
                        <span class="tailor-info-value" t-esc="state.selectedInvoice.invoice_no"/>
                    </div>
                    <div class="tailor-info-row">
                        <span class="tailor-info-label">Müşteri:</span>
                        <span class="tailor-info-value" t-esc="state.selectedInvoice.customer_name"/>
                    </div>
                    <div class="tailor-info-row">
                        <span class="tailor-info-label">Satış Pers.:</span>
                        <span class="tailor-info-value" t-esc="state.selectedInvoice.sales_person || '-'"/>
                    </div>
                    <div class="tailor-info-row" t-if="state.history.length">
                        <span class="tailor-info-label">Geçmiş:</span>
                        <a href="#" class="tailor-history-link" t-on-click.prevent="() =&gt; this.state.showHistory = !this.state.showHistory">
                            Önceki <t t-esc="state.history.length"/> terzi siparişi
                        </a>
                    </div>
                    <div t-if="state.showHistory" class="tailor-history">
                        <t t-foreach="state.history" t-as="h" t-key="h.name">
                            <div class="tailor-history-row">
                                <b t-esc="h.name"/> · <t t-esc="h.date"/> · <t t-esc="h.product"/>
                                <div class="text-muted"><t t-esc="h.services"/> — <t t-esc="h.state"/></div>
                            </div>
                        </t>
                    </div>
                    <div class="tailor-info-row">
                        <span class="tailor-info-label">Cep Tel.:</span>
                        <input type="tel" class="tailor-input tailor-input-sm" placeholder="05xx xxx xx xx (hazır SMS bildirimi)"
                               t-model="state.customerMobile"/>
                    </div>
                    <div class="tailor-info-row text-muted small" t-if="state.mobileSource">
                        <span class="tailor-info-label"/>
                        <span t-if="state.mobileSource === 'nebim'">Nebim müşteri kartından geldi — müşteriye teyit edin.</span>
                        <span t-else="">Müşterinin önceki terzi siparişinden geldi — müşteriye teyit edin.</span>
                    </div>
                    <div class="tailor-info-row">
                        <span class="tailor-info-label">Teslim:</span>
                        <input type="date" class="tailor-input tailor-input-sm" t-model="state.promisedDate"
                               title="Boş bırakılırsa varsayılan süre uygulanır"/>
                    </div>
                </div>

                <div class="tailor-items">
                    <t t-foreach="state.selectedInvoice.items || []" t-as="item" t-key="item.barcode">
                        <div t-att-class="'tailor-item-card' + (state.itemSelections[item.barcode]?.tailor_id ? ' has-tailor' : '')">
                            <div class="tailor-item-header">
                                <strong><t t-esc="item.product_code || item.barcode"/></strong>
                                <span class="tailor-item-barcode">Barkod: <t t-esc="item.barcode"/></span>
                            </div>

                            <!-- Terzi Secimi -->
                            <div class="tailor-item-row">
                                <label>Terzi:</label>
                                <select class="tailor-select" t-on-change="(ev) =&gt; this.onTailorChange(item.barcode, ev)">
                                    <option value="">-- Terzi Seçin --</option>
                                    <t t-foreach="state.tailors" t-as="tailor" t-key="tailor.id">
                                        <option t-att-value="tailor.id" t-esc="tailor.name"/>
                                    </t>
                                </select>
                            </div>

                            <!-- Terzi secilmediyse bilgi mesaji -->
                            <div t-if="!state.itemSelections[item.barcode]?.tailor_id" class="tailor-hint">
                                Hizmetleri görmek için terzi seçiniz
                            </div>

                            <!-- Hizmet Secimi — sadece terzi secilince gorunur -->
                            <div t-if="state.itemSelections[item.barcode]?.tailor_id" class="tailor-item-services tailor-fade-in">
                                <label>Hizmetler:</label>
                                <div class="tailor-service-grid">
                                    <t t-foreach="this.getTailorServices(state.itemSelections[item.barcode]?.tailor_id)" t-as="svc" t-key="svc.id">
                                        <div class="tailor-service-cell">
                                            <label class="tailor-service-check">
                                                <input type="checkbox"
                                                       t-on-change="() =&gt; this.onServiceToggle(item.barcode, svc.id)"
                                                       t-att-checked="(state.itemSelections[item.barcode]?.service_ids || []).includes(svc.id)"/>
                                                <span>
                                                    <t t-esc="svc.name"/>
                                                    (<t t-esc="this.getServicePrice(svc.id, state.itemSelections[item.barcode]?.tailor_id).toFixed(2)"/> TL)
                                                </span>
                                            </label>
                                            <input t-if="(state.itemSelections[item.barcode]?.service_ids || []).includes(svc.id)"
                                                   type="text" class="tailor-input tailor-input-sm tailor-measure-input"
                                                   placeholder="Ölçü / not (ör. 3 cm)"
                                                   t-on-change="(ev) =&gt; this.onMeasureChange(item.barcode, svc.id, ev)"/>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Not — sadece terzi secilince gorunur -->
                            <div t-if="state.itemSelections[item.barcode]?.tailor_id" class="tailor-item-row tailor-fade-in">
                                <input type="text" class="tailor-input tailor-input-sm"
                                       placeholder="Not ekleyin..."
                                       t-on-change="(ev) =&gt; this.onNotesChange(item.barcode, ev)"/>
                            </div>

                            <!-- Müşteri ücreti / kapora -->
                            <div t-if="state.itemSelections[item.barcode]?.tailor_id" class="tailor-item-row tailor-money-row tailor-fade-in">
                                <label>Müşteri ücreti:</label>
                                <input type="number" min="0" step="0.01" class="tailor-input tailor-input-sm"
                                       t-att-placeholder="this.getDefaultCharge(item.barcode).toFixed(2) + ' (0 = ücretsiz)'"
                                       t-on-change="(ev) =&gt; this.onMoneyChange(item.barcode, 'customer_charge', ev)"/>
                                <label>Kapora:</label>
                                <input type="number" min="0" step="0.01" class="tailor-input tailor-input-sm" placeholder="0"
                                       t-on-change="(ev) =&gt; this.onMoneyChange(item.barcode, 'deposit', ev)"/>
                            </div>

                            <!-- Fotoğraf — terzi öncesi durum -->
                            <div t-if="state.itemSelections[item.barcode]?.tailor_id" class="tailor-item-row tailor-photo-row tailor-fade-in">
                                <label class="tailor-btn tailor-btn-sm tailor-photo-btn">
                                    &#128247; Fotoğraf
                                    <input type="file" accept="image/*" capture="environment" class="d-none"
                                           t-on-change="(ev) =&gt; this.onPhotoChange(item.barcode, ev)"/>
                                </label>
                                <img t-if="state.itemSelections[item.barcode]?.photo" class="tailor-photo-thumb"
                                     t-att-src="state.itemSelections[item.barcode].photo" alt=""/>
                            </div>

                            <!-- Toplam — sadece terzi secilince gorunur -->
                            <div t-if="state.itemSelections[item.barcode]?.tailor_id" class="tailor-item-total tailor-fade-in">
                                Toplam: <strong><t t-esc="this.getItemTotal(item.barcode).toFixed(2)"/> TL</strong>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="tailor-submit-bar">
                    <button class="tailor-btn tailor-btn-success tailor-btn-lg"
                            t-on-click="submitOrders"
                            t-att-disabled="state.submitting">
                        <t t-if="state.submitting"><span class="tailor-spinner"/> Oluşturuluyor...</t>
                        <t t-else="">Siparişleri Oluştur</t>
                    </button>
                </div>
            </div>

            <!-- Step 3: Basari Ekrani -->
            <div t-if="state.step === 3" class="tailor-step">
                <div class="tailor-success-screen">
                    <div class="tailor-success-icon">&#10004;&#65039;</div>
                    <h3>Siparişler Oluşturuldu!</h3>
                    <p><t t-esc="state.createdCount"/> adet sipariş başarıyla oluşturuldu ve etiketler yazdırıldı.</p>
                    <div class="tailor-success-actions">
                        <button class="tailor-btn tailor-btn-primary tailor-btn-lg" t-on-click="() =&gt; { this.state.step = 1; this.state.searchQuery = ''; this.state.invoices = []; this.state.selectedInvoice = null; }">
                            Yeni Sipariş Oluştur
                        </button>
                        <button class="tailor-btn tailor-btn-back tailor-btn-lg" t-on-click="() =&gt; this.props.onNavigate('main_menu')">
                            &#8592; Ana Menu
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Order List -->
    <t t-name="ugurlar_tailor.TailorOrderList">
        <div class="tailor-screen tailor-order-list">
            <div class="tailor-toolbar">
                <button class="tailor-btn tailor-btn-back" t-on-click="goBack">&#8592; Geri</button>
                <h2>Sipariş Listesi</h2>
            </div>

            <!-- Filtreler -->
            <div class="tailor-filters">
                <input type="text" class="tailor-input" placeholder="Ara (fatura, müşteri, sipariş no)..."
                       t-model="state.search" t-on-keydown="onSearchKeydown"/>
                <button class="tailor-btn tailor-btn-camera"
                        t-on-click="scanCamera" title="Kamera ile Barkod Okut">
                    <i class="fa fa-barcode"/>
                </button>
                <select class="tailor-select" t-on-change="onFilterChange">
                    <t t-foreach="statusOptions" t-as="opt" t-key="opt[0]">
                        <option t-att-value="opt[0]" t-att-selected="state.statusFilter === opt[0]" t-esc="opt[1]"/>
                    </t>
                </select>
            </div>

            <!-- Loading -->
            <div t-if="state.loading" class="tailor-loading">
                <div class="tailor-spinner tailor-spinner-lg"/>
                <span>Yükleniyor...</span>
            </div>

            <!-- Liste -->
            <div t-if="!state.loading" class="tailor-orders">
                <div t-if="state.orders.length === 0" class="tailor-empty">
                    Sipariş bulunamadı.
                </div>
                <t t-foreach="state.orders" t-as="order" t-key="order.id">
                    <div t-att-class="'tailor-order-card' + (order.is_overdue ? ' tailor-overdue' : '')">
                        <div class="tailor-order-header">
                            <strong t-esc="order.name"/>
                            <span t-if="order.is_overdue" class="tailor-badge badge-overdue">Gecikti</span>
                            <span t-att-class="'tailor-badge ' + getStatusClass(order.state)"
                                  t-esc="getStatusLabel(order.state)"/>
                        </div>
                        <div class="tailor-order-body">
                            <div><t t-esc="order.invoice_no"/> - <t t-esc="order.product_name"/></div>
                            <div><t t-esc="order.customer_name"/></div>
                            <div t-if="order.tailor_id"><t t-esc="order.tailor_id[1]"/></div>
                            <div><t t-esc="order.total_price?.toFixed(2)"/> TL</div>
                            <div t-if="order.promised_date">Teslim: <strong t-esc="formatDate(order.promised_date)"/></div>
                            <div t-if="order.location">&#128205; Raf/Askı: <strong t-esc="order.location"/></div>
                            <div t-if="order.customer_charge">
                                Müşteri ücreti: <t t-esc="order.customer_charge.toFixed(2)"/> TL
                                <span t-if="order.is_paid" class="tailor-badge badge-completed">Ödendi</span>
                                <span t-elif="order.balance" class="tailor-badge badge-waiting">Kalan <t t-esc="order.balance.toFixed(2)"/> TL</span>
                            </div>
                            <div t-if="order.create_date_local" class="tailor-order-date">
                                <t t-esc="order.create_date_local"/>
                            </div>
                            <div t-if="order.services and order.services.length" class="tailor-order-services">
                                <t t-foreach="order.services" t-as="s" t-key="s.id">
                                    <span class="tailor-service-tag"><t t-esc="s.service_name"/><t t-if="s.measure"> — <t t-esc="s.measure"/></t></span>
                                </t>
                            </div>
                        </div>
                        <div class="tailor-order-actions">
                            <button t-if="order.state != 'waiting_approval' and order.state != 'cancelled'" class="tailor-btn tailor-btn-sm" style="background:#f39c12;color:#fff;"
                                    t-on-click="() =&gt; this.printLabel(order.id)">
                                Etiket Yazdır
                            </button>
                            <button t-if="order.state == 'completed'" class="tailor-btn tailor-btn-sm" style="background:#0ea5e9;color:#fff;"
                                    t-on-click="() =&gt; this.sendSms(order)">
                                &#128172; SMS
                            </button>
                            <button t-if="getNextStatus(order.state)"
                                    class="tailor-btn tailor-btn-sm tailor-btn-primary"
                                    t-on-click="() =&gt; this.updateStatus(order.id, this.getNextStatus(order.state))">
                                <t t-esc="getStatusLabel(getNextStatus(order.state))"/>
                            </button>
                            <button t-if="order.state != 'delivered' and order.state != 'cancelled'"
                                    class="tailor-btn tailor-btn-sm"
                                    style="background:#e74c3c;color:#fff;"
                                    t-on-click="() =&gt; this.cancelOrder(order.id)">
                                İptal
                            </button>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Pagination (Professional) -->
            <div class="tailor-pagination" t-if="state.total &gt; state.limit">
                <button class="tailor-btn tailor-btn-sm" t-on-click="prevPage"
                        t-att-disabled="state.page &lt;= 1">&#8592; Onceki</button>
                <span class="tailor-page-info"><t t-esc="state.page"/> / <t t-esc="totalPages"/></span>
                <button class="tailor-btn tailor-btn-sm" t-on-click="nextPage"
                        t-att-disabled="state.page &gt;= totalPages">Sonraki &#8594;</button>
            </div>
        </div>
    </t>

    <!-- Gift Label Screen -->
    <t t-name="ugurlar_tailor.TailorGiftLabel">
        <div class="tailor-screen tailor-new-order">
            <div class="tailor-toolbar">
                <button class="tailor-btn tailor-btn-back" t-on-click="goBack">&#8592; Geri</button>
                <h2 t-if="state.step === 1">&#127873; Hediye Etiketi — Fatura Ara</h2>
                <h2 t-if="state.step === 2">&#127873; Hediye Etiketi — Ürün Seç</h2>
                <h2 t-if="state.step === 3">&#127873; Hediye Etiketi Yazdırıldı</h2>
            </div>

            <!-- Step 1: Fatura Arama -->
            <div t-if="state.step === 1" class="tailor-step">
                <div class="tailor-search-box">
                    <input type="text" class="tailor-input tailor-barcode-input"
                           placeholder="Fatura no veya barkod..."
                           t-model="state.searchQuery"
                           t-on-keydown="onSearchKeydown"
                           t-ref="giftSearchInput"/>
                    <button class="tailor-btn tailor-btn-camera"
                            t-on-click="scanCamera" title="Kamera ile Barkod Okut">
                        <i class="fa fa-barcode"/>
                    </button>
                    <button class="tailor-btn tailor-btn-primary" t-on-click="searchInvoice"
                            t-att-disabled="state.searching">
                        <t t-if="state.searching"><span class="tailor-spinner"/> </t>
                        <t t-if="!state.searching">Ara</t>
                    </button>
                </div>
                <div t-if="state.invoices.length > 1" class="tailor-invoice-list">
                    <t t-foreach="state.invoices" t-as="inv" t-key="inv.invoice_no">
                        <div class="tailor-invoice-card" t-on-click="() =&gt; this.selectInvoice(inv.invoice_no)">
                            <strong t-esc="inv.invoice_no"/>
                            <span class="tailor-invoice-meta">
                                <t t-esc="inv.customer_name"/> - <t t-esc="inv.sales_person || '-'"/>
                            </span>
                        </div>
                    </t>
                </div>
            </div>

            <!-- Step 2: Ürün Seçimi + Hediye Notu -->
            <div t-if="state.step === 2" class="tailor-step">
                <div class="tailor-invoice-info">
                    <div class="tailor-info-row">
                        <span class="tailor-info-label">Fatura:</span>
                        <span class="tailor-info-value" t-esc="state.selectedInvoice.invoice_no"/>
                    </div>
                    <div class="tailor-info-row">
                        <span class="tailor-info-label">Müşteri:</span>
                        <span class="tailor-info-value" t-esc="state.selectedInvoice.customer_name"/>
                    </div>
                </div>

                <div style="text-align:center;padding:12px;background:#f3e8ff;border-radius:8px;margin:8px 0;">
                    <span style="font-size:15px;font-weight:700;color:#7c3aed;">🎁 Hediye edilecek ürünleri seçin ve not ekleyin</span>
                </div>

                <div class="tailor-items">
                    <t t-foreach="state.selectedInvoice.items || []" t-as="item" t-key="item.barcode">
                        <div t-att-class="'tailor-item-card' + (state.selectedItems[item.barcode]?.selected ? ' has-tailor' : '')" 
                             style="cursor:pointer;" t-on-click="() =&gt; this.toggleItem(item.barcode)">
                            <div class="tailor-item-header" style="display:flex;align-items:center;gap:10px;">
                                <input type="checkbox" t-att-checked="state.selectedItems[item.barcode]?.selected"
                                       style="width:20px;height:20px;" t-on-click.stop="() =&gt; this.toggleItem(item.barcode)"/>
                                <div>
                                    <strong><t t-esc="item.product_code || item.barcode"/></strong>
                                    <span class="tailor-item-barcode"> — Barkod: <t t-esc="item.barcode"/></span>
                                </div>
                            </div>

                            <!-- Hediye Notu — sadece seçiliyse -->
                            <div t-if="state.selectedItems[item.barcode]?.selected" 
                                 class="tailor-fade-in" style="margin-top:8px;">
                                <input type="text" class="tailor-input tailor-input-sm"
                                       placeholder="🎁 Hediye notu yazın (opsiyonel)..."
                                       t-att-value="state.selectedItems[item.barcode]?.gift_note || ''"
                                       t-on-change="(ev) =&gt; this.onGiftNoteChange(item.barcode, ev)"
                                       t-on-click.stop="() =&gt; {}"/>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="tailor-submit-bar">
                    <button class="tailor-btn tailor-btn-lg" 
                            style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff;font-size:16px;"
                            t-on-click="printGiftLabels"
                            t-att-disabled="state.printing || selectedCount === 0">
                        <t t-if="state.printing"><span class="tailor-spinner"/> Yazdırılıyor...</t>
                        <t t-else="">🎁 Hediye Etiketi Yazdır (<t t-esc="selectedCount"/> ürün)</t>
                    </button>
                </div>
            </div>

            <!-- Step 3: Başarı -->
            <div t-if="state.step === 3" class="tailor-step">
                <div class="tailor-success-screen">
                    <div class="tailor-success-icon">🎁</div>
                    <h3>Hediye Etiketleri Yazdırıldı!</h3>
                    <p>Etiketler başarıyla yazdırıldı.</p>
                    <div class="tailor-success-actions">
                        <button class="tailor-btn tailor-btn-lg" 
                                style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:#fff;"
                                t-on-click="() =&gt; { this.state.step = 1; this.state.searchQuery = ''; this.state.invoices = []; this.state.selectedInvoice = null; }">
                            Yeni Hediye Etiketi
                        </button>
                        <button class="tailor-btn tailor-btn-back tailor-btn-lg" t-on-click="() =&gt; this.props.onNavigate('main_menu')">
                            &#8592; Ana Menü
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Store Item (Reyon) Screen -->
    <t t-name="ugurlar_tailor.TailorStoreItem">
        <div class="tailor-screen tailor-new-order">
            <div class="tailor-toolbar">
                <button class="tailor-btn tailor-btn-back" t-on-click="goBack">&#8592; Geri</button>
                <h2 t-if="state.step === 1">&#128717; Reyon - Ürün Okut</h2>
                <h2 t-if="state.step === 2">&#128717; Sipariş Oluşturuldu</h2>
            </div>

            <!-- Step 1: Barkod Okutma ve Terzi Secimi -->
            <div t-if="state.step === 1" class="tailor-step">
                <div class="tailor-search-box tailor-search-box-elevated">
                    <input type="text" class="tailor-input tailor-barcode-input tailor-input-lg"
                           placeholder="Barkod okutunuz..."
                           t-model="state.searchQuery"
                           t-on-keydown="onSearchKeydown"
                           t-ref="storeSearchInput"/>
                    <button class="tailor-btn tailor-btn-camera"
                            t-on-click="scanCamera" title="Kamera ile Barkod Okut">
                        <i class="fa fa-barcode"/>
                    </button>
                    <button class="tailor-btn tailor-btn-primary tailor-btn-add"
                            t-on-click="searchProduct"
                            t-att-disabled="state.searching">
                        <t t-if="state.searching"><span class="tailor-spinner"/> </t>
                        <t t-if="!state.searching">Ekle</t>
                    </button>
                </div>

                <div class="tailor-items" style="margin-top: 16px;">
                    <t t-foreach="state.items || []" t-as="item" t-key="item.barcode">
                        <div t-att-class="'tailor-item-card' + (item.tailor_id ? ' has-tailor' : '')">
                            <div class="tailor-item-header">
                                <strong><t t-esc="item.product_name || item.barcode"/></strong>
                                <span class="tailor-item-barcode">Barkod: <t t-esc="item.barcode"/></span>
                                <button class="tailor-btn tailor-btn-sm" style="float: right; background: #e74c3c; color: white;" t-on-click="() =&gt; this.removeItem(item.barcode)">Sil</button>
                            </div>

                            <!-- Terzi Secimi -->
                            <div class="tailor-item-row">
                                <label>Terzi:</label>
                                <select class="tailor-select" t-on-change="(ev) =&gt; this.onTailorChange(item.barcode, ev)">
                                    <option value="">-- Terzi Seçin --</option>
                                    <t t-foreach="state.tailors" t-as="tailor" t-key="tailor.id">
                                        <option t-att-value="tailor.id" t-esc="tailor.name" t-att-selected="item.tailor_id === tailor.id"/>
                                    </t>
                                </select>
                            </div>

                            <!-- Terzi secilmediyse bilgi mesaji -->
                            <div t-if="!item.tailor_id" class="tailor-hint">
                                Hizmetleri görmek için terzi seçiniz
                            </div>

                            <!-- Hizmet Secimi -->
                            <div t-if="item.tailor_id" class="tailor-item-services tailor-fade-in">
                                <label>Hizmetler:</label>
                                <div class="tailor-service-grid">
                                    <t t-foreach="this.getTailorServices(item.tailor_id)" t-as="svc" t-key="svc.id">
                                        <div class="tailor-service-cell">
                                            <label class="tailor-service-check">
                                                <input type="checkbox"
                                                       t-on-change="() =&gt; this.onServiceToggle(item.barcode, svc.id)"
                                                       t-att-checked="(item.service_ids || []).includes(svc.id)"/>
                                                <span>
                                                    <t t-esc="svc.name"/>
                                                    (<t t-esc="this.getServicePrice(svc.id, item.tailor_id).toFixed(2)"/> TL)
                                                </span>
                                            </label>
                                            <input t-if="(item.service_ids || []).includes(svc.id)"
                                                   type="text" class="tailor-input tailor-input-sm tailor-measure-input"
                                                   placeholder="Ölçü / not (ör. 3 cm)"
                                                   t-on-change="(ev) =&gt; this.onMeasureChange(item.barcode, svc.id, ev)"/>
                                        </div>
                                    </t>
                                </div>
                            </div>

                            <!-- Not -->
                            <div t-if="item.tailor_id" class="tailor-item-row tailor-fade-in">
                                <input type="text" class="tailor-input tailor-input-sm"
                                       placeholder="Not ekleyin..."
                                       t-on-change="(ev) =&gt; this.onNotesChange(item.barcode, ev)" t-att-value="item.notes"/>
                            </div>

                            <!-- Fotoğraf -->
                            <div t-if="item.tailor_id" class="tailor-item-row tailor-photo-row tailor-fade-in">
                                <label class="tailor-btn tailor-btn-sm tailor-photo-btn">
                                    &#128247; Fotoğraf
                                    <input type="file" accept="image/*" capture="environment" class="d-none"
                                           t-on-change="(ev) =&gt; this.onPhotoChange(item.barcode, ev)"/>
                                </label>
                                <img t-if="item.photo" class="tailor-photo-thumb" t-att-src="item.photo" alt=""/>
                            </div>

                            <!-- Toplam -->
                            <div t-if="item.tailor_id" class="tailor-item-total tailor-fade-in">
                                Toplam: <strong><t t-esc="this.getItemTotal(item.barcode).toFixed(2)"/> TL</strong>
                            </div>
                        </div>
                    </t>
                </div>

                <div class="tailor-item-row" t-if="state.items.length &gt; 0" style="margin-top:12px;">
                    <label>Teslim:</label>
                    <input type="date" class="tailor-input tailor-input-sm" t-model="state.promisedDate"
                           title="Boş bırakılırsa varsayılan süre uygulanır"/>
                </div>
                <div class="tailor-submit-bar" t-if="state.items.length &gt; 0">
                    <button class="tailor-btn tailor-btn-success tailor-btn-lg"
                            t-on-click="submitOrders"
                            t-att-disabled="state.submitting">
                        <t t-if="state.submitting"><span class="tailor-spinner"/> Oluşturuluyor...</t>
                        <t t-else="">Siparişleri Oluştur</t>
                    </button>
                </div>
            </div>

            <!-- Step 2: Basari Ekrani -->
            <div t-if="state.step === 2" class="tailor-step">
                <div class="tailor-success-screen">
                    <div class="tailor-success-icon" style="color: #f59e0b; font-size: 60px;">&#8987;</div>
                    <h3 style="color: #d97706;">Yetkili Onayına Gönderildi!</h3>
                    <p><t t-esc="state.createdCount"/> adet reyon siparişi oluşturuldu. Yetkili onay verdiğinde size bildirim gelecek ve yazdırma butonu Sipariş Listesi ekranında görünür olacaktır.</p>
                    <div class="tailor-success-actions">
                        <button class="tailor-btn tailor-btn-primary tailor-btn-lg" t-on-click="() =&gt; { this.state.step = 1; this.state.searchQuery = ''; this.state.items = []; }">
                            Yeni Ürün Okut
                        </button>
                        <button class="tailor-btn tailor-btn-back tailor-btn-lg" t-on-click="() =&gt; this.props.onNavigate('main_menu')">
                            &#8592; Ana Menu
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- Toplu Barkod İşlemi -->
    <t t-name="ugurlar_tailor.TailorBulk">
        <div class="tailor-screen tailor-bulk">
            <div class="tailor-toolbar">
                <button class="tailor-btn tailor-btn-back" t-on-click="goBack">&#8592; Geri</button>
                <h2>Toplu İşlem</h2>
            </div>
            <div class="tailor-bulk-targets">
                <t t-foreach="targets" t-as="tg" t-key="tg[0]">
                    <button t-att-class="'tailor-btn ' + (state.target === tg[0] ? 'tailor-btn-primary' : 'tailor-btn-back')"
                            t-on-click="() =&gt; { this.state.target = tg[0]; this.state.results = null; }" t-esc="tg[1]"/>
                </t>
            </div>
            <div class="tailor-item-row" t-if="state.target === 'completed'">
                <label>Raf / Askı:</label>
                <input type="text" class="tailor-input tailor-input-sm" placeholder="Tümü için (isteğe bağlı)"
                       t-model="state.location"/>
            </div>
            <div class="tailor-search-box tailor-search-box-elevated">
                <input type="text" class="tailor-input tailor-barcode-input tailor-input-lg" t-ref="bulkInput"
                       placeholder="Sipariş barkodu okutun (TRZ-...)" t-model="state.code" t-on-keydown="onKeydown"/>
                <button class="tailor-btn tailor-btn-camera" t-on-click="scanCamera" title="Kamera ile okut">
                    <i class="fa fa-barcode"/>
                </button>
            </div>
            <div class="tailor-orders">
                <div t-if="!state.items.length" class="tailor-empty">Okutulan sipariş yok.</div>
                <t t-foreach="state.items" t-as="it" t-key="it.id">
                    <div class="tailor-order-card">
                        <div class="tailor-order-header">
                            <strong t-esc="it.name"/>
                            <button class="tailor-btn tailor-btn-sm" style="background:#e74c3c;color:#fff;"
                                    t-on-click="() =&gt; this.remove(it.id)">Çıkar</button>
                        </div>
                        <div class="tailor-order-body">
                            <div><t t-esc="it.product_name"/> — <t t-esc="it.customer_name"/></div>
                            <div>Terzi: <t t-esc="it.tailor_name"/></div>
                            <div t-if="resultFor(it.id) and !resultFor(it.id).ok" class="text-danger">
                                <t t-esc="resultFor(it.id).error"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            <div class="tailor-submit-bar" t-if="state.items.length">
                <button class="tailor-btn tailor-btn-success tailor-btn-lg" t-on-click="apply" t-att-disabled="state.busy">
                    <t t-if="state.busy"><span class="tailor-spinner"/> İşleniyor...</t>
                    <t t-else=""><t t-esc="state.items.length"/> siparişi uygula</t>
                </button>
            </div>
        </div>
    </t>

</templates>
