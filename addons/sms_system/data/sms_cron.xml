<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_sms_retry_failed" model="ir.cron">
            <field name="name">SMS: Başarısız gönderimleri yeniden dene</field>
            <field name="model_id" ref="model_sms_system_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_retry_failed()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_sms_campaign_queue" model="ir.cron">
            <field name="name">SMS: Toplu SMS kuyruğu</field>
            <field name="model_id" ref="model_sms_system_campaign"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_queue()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="cron_sms_iys" model="ir.cron">
            <field name="name">SMS: İYS izin senkronu</field>
            <field name="model_id" ref="model_sms_system_iys"/>
            <field name="state">code</field>
            <field name="code">model._cron_iys()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
